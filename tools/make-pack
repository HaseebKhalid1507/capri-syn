PIN_COMMIT = "bc93892c751a73fdce14355b477dcdc775e46fd9"
SLEEP_COMMIT = "bb0c2d71e751db6e7cab4926b4f251b1b2c05f5a"
SLEEP_PATH = "assets/capri/sprites/poses-v2/PNG/capri-sleep.png"
SLEEP_SHA = "f76c310daa7ebd0cc683b01d03ff84bb02d9c51985f38a7e1adaabc2b2a734d5"
SLEEP_URL = f"https://raw.githubusercontent.com/CapriChooms/CapriCore/{SLEEP_COMMIT}/{SLEEP_PATH}"
SIDES = {
    "lachy": {"repo": "lachydotmcg/capri-desktop", "commit": "156ed188a2ac00854eb1c9e932087eb5e824ccb9",
              "pins": "tools/lachy-desktop-156ed18.sha256", "license": "LICENSE.md", "root": "assets/"},
    "mochi": {"repo": "mochiiwuff/capri-desktop", "commit": "c011764ca1fdbd191925321e3aaa8af5b84babe8",
              "pins": "tools/mochi-desktop-c011764.sha256", "license": "LICENSE", "root": "assets/capri/",
              "readme": "README.md"},
}
POLYFORM_NC = "https://polyformproject.org/licenses/noncommercial/1.0.0"
UPSCALE_PINS = "tools/lachy-x2.sha256"
GEOMETRY = "tools/desktop-art.json"
LACHY_CREDITS = ("Window perch and music perch animations: her artist, who prefers to stay private. Click effect: "
                 "mixmix312352. Transformation animation she forms from when she teleports, and her two secret emotes: "
                 "Qewiw (mix_qewiw1412_86144).")
V122_COMMIT = "828f27243df3d1b9669cbe1a5d16633b68c1108a"
V122_PINS = "tools/capricore-v1.2.2.sha256"
V122_URL = "https://raw.githubusercontent.com/CapriChooms/CapriCore/{commit}/{rel}"
OUTFIT = "tools/capricore-outfit.json"
NOTICE_LINE = ("Assembled by capri-syn's tools/make-pack from CapriCore v1.0.4 (bc93892), "
               "plus one frame (pose-sleep) from CapriCore v1.1.2 (bb0c2d7), "
               "plus the wave, the hanging and ledge cels and the no-jacket redraws from CapriCore v1.2.2 (828f272).")


def sha(b):
    return hashlib.sha256(b).hexdigest()


def pins(repo):
    out = {}
    for line in (repo / "tools/capricore-v1.0.4.sha256").read_text().splitlines():
        if line.strip() and not line.startswith("#"):
            h, p = line.split(None, 1)
            out[p.strip()] = h
    return out


def check_source(src, pinned):
    """Refuse anything but v1.0.4: the git HEAD if it's a checkout, and every pinned file."""
    if (src / ".git").exists():
        r = subprocess.run(["git", "-C", str(src), "rev-parse", "HEAD"], capture_output=True, text=True)
        head = r.stdout.strip()
        if r.returncode == 0 and head != PIN_COMMIT:
            sys.exit(f"make-pack: {src} is at {head[:7]}, not CapriCore v1.0.4 ({PIN_COMMIT[:7]}). "
                     f"Run `git -C {src} checkout v1.0.4` (1.1.x drops frames she uses).")
    bad = []
    for rel, want in pinned.items():
        p = src / rel
        if not p.is_file():
            bad.append(f"missing {rel}")
        elif sha(p.read_bytes()) != want:
            bad.append(f"changed {rel}")
    if bad:
        sys.exit(f"make-pack: {src} is not CapriCore v1.0.4 ({len(bad)} file(s) differ from tools/capricore-v1.0.4.sha256):\n  "
                 + "\n  ".join(bad[:10]) + ("\n  ..." if len(bad) > 10 else ""))


def side_pins(repo, side):
    out = {}
    for line in (repo / SIDES[side]["pins"]).read_text().splitlines():
        if line.strip() and not line.startswith("#"):
            h, p = line.split(None, 1)
            out[p.strip()] = h
    return out


def v122_pins(repo):
    out = {}
    for line in (repo / V122_PINS).read_text().splitlines():
        if line.strip() and not line.startswith("#"):
            h, p = line.split(None, 1)
            out[p.strip()] = h
    return out


def v122_files(src, given, pinned):
    """CapriCore v1.2.2's pinned files (rel -> bytes): --v122 DIR, the checkout's git objects, the
    download cache, else GitHub at that commit (then cached). Any that matches its sha256 nowhere: refused."""
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / f"synaps-avatar/capri-desktop/capricore-{V122_COMMIT[:7]}"
    git = (src / ".git").exists()
    out, bad = {}, []
    for rel, want in sorted(pinned.items()):
        tried = []
        for how in ("dir", "git", "cache", "url"):
            b = None
            if how == "dir" and given and (Path(given) / rel).is_file():
                b = (Path(given) / rel).read_bytes()
            elif how == "git" and git:
                r = subprocess.run(["git", "-C", str(src), "show", f"{V122_COMMIT}:{rel}"], capture_output=True)
                b = r.stdout if r.returncode == 0 else None
            elif how == "cache" and (cache / rel).is_file():
                b = (cache / rel).read_bytes()
            elif how == "url":
                url = V122_URL.format(commit=V122_COMMIT, rel=rel)
                try:
                    b = fetch_url(url)
                except OSError as e:
                    tried.append(f"{url} ({e})")
                    continue
                if sha(b) == want:
                    (cache / rel).parent.mkdir(parents=True, exist_ok=True)
                    (cache / rel).write_bytes(b)
            if b is not None and sha(b) == want:
                out[rel] = b
                break
            if b is not None:
                tried.append(f"{how}: sha256 {sha(b)[:12]}…")
        else:
            bad.append(f"{rel} ({'; '.join(tried) or 'nowhere'})")
    if bad:
        sys.exit(f"make-pack: {len(bad)} CapriCore v1.2.2 file(s) match {V122_PINS} nowhere (pass --v122 DIR, a v1.2.2 "
                 "checkout, or `git -C CAPRICORE_DIR fetch --tags`):\n  " + "\n  ".join(bad[:10]) + ("\n  ..." if len(bad) > 10 else ""))
    return out


def add_capricore(out, files, pinned, geometry, outfit):
    """anim/capricore/ (the wave, the cels) and outfits/<id>/ (the redraws and their sprites.json);
    returns anim.json's capricore side."""
    g = geometry["capricore"]
    dst = out / "anim/capricore"
    strip_files = {}
    for st in g["strips"].values():
        rel = g["root"] + st["file"]
        (dst / st["file"]).parent.mkdir(parents=True, exist_ok=True)
        (dst / st["file"]).write_bytes(files[rel])
        strip_files[st["file"]] = {"sha256": pinned[rel]}
    od = out / "outfits" / outfit["id"]
    od.mkdir(parents=True, exist_ok=True)
    sprites = []
    for e in outfit["sprites"]:
        name = Path(e["from"]).name
        (od / name).write_bytes(files[e["from"]])
        sp = {"id": e["id"], "file": name, "anchor": e["anchor"], "visibleBounds": e["visibleBounds"], "sha256": pinned[e["from"]]}
        if "patch" in e:
            sp["patch"] = e["patch"]
        sprites.append(sp)
    (od / "sprites.json").write_text(json.dumps({"outfit": outfit["id"], "sprites": sprites}, indent=1) + "\n")
    return {**g, "files": strip_files}


def fetch_url(url):
    with urllib.request.urlopen(url, timeout=60) as f:
        return f.read()


def side_dir(side, arg, pinned):
    """--lachy/--mochi DIR, or `auto`: the pinned files downloaded at the pinned commit into a cache."""
    if arg != "auto":
        return Path(arg)
    s = SIDES[side]
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / f"synaps-avatar/capri-desktop/{side}-{s['commit'][:7]}"
    for rel, want in pinned.items():
        p = cache / rel
        if p.is_file() and sha(p.read_bytes()) == want:
            continue
        url = f"https://raw.githubusercontent.com/{s['repo']}/{s['commit']}/{rel}"
        try:
            b = fetch_url(url)
        except OSError as e:
            sys.exit(f"make-pack: --{side} auto: cannot download {url} ({e})")
        if sha(b) != want:
            sys.exit(f"make-pack: --{side} auto: {url} does not match {s['pins']} (sha256 {sha(b)[:12]}…)")
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_bytes(b)
    return cache


def check_side(side, d, pinned):
    """Refuse anything but the pinned commit: the git HEAD if it's a checkout, and every pinned file."""
    s = SIDES[side]
    if (d / ".git").exists():
        r = subprocess.run(["git", "-C", str(d), "rev-parse", "HEAD"], capture_output=True, text=True)
        head = r.stdout.strip()
        if r.returncode == 0 and head != s["commit"]:
            sys.exit(f"make-pack: --{side} {d} is at {head[:7]}, not {s['repo']} {s['commit'][:7]}. "
                     f"Run `git -C {d} checkout {s['commit'][:7]}`, or pass --{side} auto.")
    bad = []
    for rel, want in pinned.items():
        p = d / rel
        if not p.is_file():
            bad.append(f"missing {rel}")
        elif sha(p.read_bytes()) != want:
            bad.append(f"changed {rel}")
    if bad:
        sys.exit(f"make-pack: --{side} {d} is not {s['repo']} {s['commit'][:7]} ({len(bad)} file(s) differ from {s['pins']}):\n  "
                 + "\n  ".join(bad[:10]) + ("\n  ..." if len(bad) > 10 else ""))


def required_notices(text):
    return [l.strip() for l in text.splitlines() if l.startswith("Required Notice:")]


def readme_section(text, heading):
    """The first paragraph under `## heading`, joined to one line."""
    lines = text.splitlines()
    i = next((n for n, l in enumerate(lines) if l.strip() == f"## {heading}"), None)
    if i is None:
        sys.exit(f"make-pack: README has no '## {heading}' section")
    para = []
    for l in lines[i + 1:]:
        if l.strip():
            para.append(l.strip())
        elif para:
            break
    return " ".join(para)


MOCHI_KINDS = {"capri-cutout": "cutout", "capri-full": "cutout", "capri-face": "face", "face-": "face",
               "cutin-": "cutin", "intro-": "intro"}


def mochi_kind(name):
    return next((k for pre, k in MOCHI_KINDS.items() if name.startswith(pre)), "other")


def unzip_emote(zpath, dest):
    with zipfile.ZipFile(zpath) as z:
        for name in z.namelist():
            if "/" in name or "\\" in name or name.startswith(".") or not name:
                sys.exit(f"make-pack: {zpath.name}: unexpected member {name!r}")
        dest.mkdir(parents=True, exist_ok=True)
        for name in z.namelist():
            (dest / name).write_bytes(z.read(name))
        return len(z.namelist())


def mochi_hair(repo, mode):
    """tools/mochi_hair.py, or None for `original`."""
    if mode == "original":
        return None
    sys.path.insert(0, str(repo / "tools"))
    try:
        import mochi_hair as mh
    except ImportError as e:
        sys.exit(f"make-pack: --mochi-hair {mode} needs numpy and Pillow ({e}); or pass --mochi-hair original")
    return mh


def add_sides(out, srcs, pinned, geometry, hair=None, hair_mode="original"):
    """Copy the pinned desktop art into anim/<side>/, write anim/anim.json and the NOTICE sections.
    hair: tools/mochi_hair (or None): repaints her hair in the intro close-ups as they are copied."""
    anim = out / "anim"
    doc = {k: v for k, v in geometry.items() if k not in SIDES}
    notice = []
    for side, d in srcs.items():
        s, root = SIDES[side], SIDES[side]["root"]
        dst = anim / side
        dst.mkdir(parents=True, exist_ok=True)
        files = {}
        for rel, h in sorted(pinned[side].items()):
            if rel in (s["license"], s.get("readme")):
                if rel == s["license"]:
                    shutil.copy2(d / rel, dst / rel)
                continue
            assert rel.startswith(root), rel
            short = rel[len(root):]
            if short.startswith("emotes/") and short.endswith(".zip"):
                n = unzip_emote(d / rel, dst / short[:-4])
                files[short] = {"sha256": h, "unzippedTo": short[:-4], "files": n}
                continue
            (dst / short).parent.mkdir(parents=True, exist_ok=True)
            if hair and side == "mochi" and mochi_kind(short) == "intro":
                hair.recolor_file(d / rel, dst / short, hair_mode)
                files[short] = {"sha256": sha((dst / short).read_bytes()), "kind": "intro", "hair": hair_mode,
                                "sourceSha256": h}
                continue
            shutil.copy2(d / rel, dst / short)
            files[short] = {"sha256": h} if side == "lachy" else {"sha256": h, "kind": mochi_kind(short)}
        doc[side] = {**geometry[side], "files": files}
        lic = (d / s["license"]).read_text()
        rn = "\n".join(required_notices(lic))
        if side == "lachy":
            notice.append(f"## Desktop art: Capri (https://github.com/lachydotmcg/capri-desktop)\n\n"
                          f"`anim/lachy/` holds art and animations from Capri, https://github.com/lachydotmcg/capri-desktop "
                          f"(commit {s['commit'][:7]}), under the PolyForm Noncommercial License 1.0.0: {POLYFORM_NC} "
                          f"(full terms: `anim/lachy/{s['license']}`), downloaded onto this machine from that repository by "
                          f"capri-syn's tools/make-pack; the art files are not in capri-syn's repository.\n\n{rn}\n\n"
                          f"Credits (its README): {LACHY_CREDITS}\n")
        else:
            rights = readme_section((d / s["readme"]).read_text(), "Credits and rights")
            notice.append(f"## Images from mochiiwuff/capri-desktop\n\n"
                          f"`anim/mochi/` holds images from https://github.com/mochiiwuff/capri-desktop (commit {s['commit'][:7]}), "
                          f"downloaded onto this machine from that repository by capri-syn's tools/make-pack; the art "
                          f"files are not in capri-syn's repository. Its code is under the PolyForm Noncommercial License "
                          f"1.0.0, {POLYFORM_NC} (full terms: `anim/mochi/{s['license']}`). On these images, its README, "
                          f"\"Credits and rights\":\n\n> {rights}\n\n{rn}\n")
    (anim / "anim.json").write_text(json.dumps(doc, indent=1) + "\n")
    return notice


def upscale(out, repo, record, cache):
    """anim/lachy/x2/: every lachy strip x2, pixels pinned in tools/lachy-x2.sha256."""
    pin_path = repo / UPSCALE_PINS
    pins = {}
    if pin_path.is_file():
        for line in pin_path.read_text().splitlines():
            if line.strip() and not line.startswith("#"):
                h, p = line.split(None, 1)
                pins[p.strip()] = h
    sys.path.insert(0, str(repo / "tools"))
    import upscale_art as up
    net = up.load_net(cache)
    geo = json.loads((out / "anim/anim.json").read_text())["lachy"]["strips"]
    got, bad = {}, []
    for name, g in sorted(geo.items()):
        im = up.upscale_strip(net, out / "anim/lachy" / g["file"], g["cell"][0], g["frames"])
        rel = f"x2/{g['file']}"
        h = up.pixel_sha(im)
        got[rel] = h
        if not record and pins.get(rel) != h:
            bad.append(rel)
            continue
        (out / "anim/lachy" / rel).parent.mkdir(parents=True, exist_ok=True)
        im.save(out / "anim/lachy" / rel)
    if bad:
        sys.exit(f"make-pack: --upscale: {len(bad)} strip(s) differ from {UPSCALE_PINS} (another torch or CPU?): "
                 + ", ".join(bad[:6]) + ". Pass --record-upscale to accept these pixels as the new pins.")
    if record:
        pin_path.write_text(f"# x{up.FACTOR} of lachy's strips (tools/upscale_art.py, model sha256 {up.MODEL_SHA[:12]}…): "
                            "sha256 of the decoded pixels (WxH + RGBA).\n"
                            + "".join(f"{h}  {rel}\n" for rel, h in sorted(got.items())))
    return len(got)


def sleep_frame(src, given):
    """pose-sleep (v1.1.2), checksum-pinned: --sleep FILE, the checkout's git objects, or GitHub."""
    tried = []
    if given:
        b = Path(given).read_bytes()
        if sha(b) == SLEEP_SHA:
            return b
        sys.exit(f"make-pack: {given} is not v1.1.2's capri-sleep.png (sha256 {sha(b)[:12]}…, want {SLEEP_SHA[:12]}…)")
    if (src / ".git").exists():
        r = subprocess.run(["git", "-C", str(src), "show", f"{SLEEP_COMMIT}:{SLEEP_PATH}"], capture_output=True)
        if r.returncode == 0 and sha(r.stdout) == SLEEP_SHA:
            return r.stdout
        tried.append("the checkout's git objects (no v1.1.2: `git fetch --tags`)")
    try:
        with urllib.request.urlopen(SLEEP_URL, timeout=30) as f:
            b = f.read()
        if sha(b) == SLEEP_SHA:
            return b
        tried.append(f"{SLEEP_URL} (sha256 {sha(b)[:12]}…)")
    except OSError as e:
        tried.append(f"{SLEEP_URL} ({e})")
    sys.exit("make-pack: no checksum-matching pose-sleep from v1.1.2. Tried: " + "; ".join(tried)
             + ". Pass --sleep FILE (v1.1.2 " + SLEEP_PATH + ").")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 2
    repo = Path(__file__).resolve().parent.parent
    flags = {"--upscale": False, "--record-upscale": False}
    for k in flags:
        if k in argv:
            flags[k] = True
            argv.remove(k)
    opts = {"--moods": repo / "packs/capri/moods.json", "--persona": repo / "packs/capri/persona.md", "--sleep": None,
            "--v122": None, "--lachy": None, "--mochi": None, "--mochi-hair": "red"}
    for k in list(opts):
        if k in argv:
            i = argv.index(k)
            if i + 1 >= len(argv):
                sys.exit(f"make-pack: {k} needs a value")
            opts[k] = argv[i + 1] if k in ("--lachy", "--mochi", "--mochi-hair") else Path(argv[i + 1])
            del argv[i:i + 2]
    if flags["--record-upscale"]:
        flags["--upscale"] = True
    if opts["--mochi-hair"] not in ("red", "flat", "original"):
        sys.exit(f"make-pack: --mochi-hair is red, flat or original, not {opts['--mochi-hair']!r}")
    if flags["--upscale"] and not opts["--lachy"]:
        sys.exit("make-pack: --upscale needs --lachy")
    moods = opts["--moods"]
    src = Path(argv[0])
    data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    out = Path(argv[1]) if len(argv) > 1 else data / "synaps-avatar/packs/capri"
    if not moods.exists():
        sys.exit(f"make-pack: missing {moods}")
    persona = opts["--persona"]
    if not persona.is_file():
        sys.exit(f"make-pack: missing {persona}")
    pinned = pins(repo)
    check_source(src, pinned)
    sleep = sleep_frame(src, opts["--sleep"])
    pinned122 = v122_pins(repo)
    files122 = v122_files(src, opts["--v122"], pinned122)
    side_srcs, side_pinned = {}, {}
    for side in SIDES:
        arg = opts[f"--{side}"]
        if arg:
            side_pinned[side] = side_pins(repo, side)
            d = side_dir(side, arg, side_pinned[side])
            check_side(side, d, side_pinned[side])
            side_srcs[side] = d
    geometry = json.loads((repo / GEOMETRY).read_text())
    if flags["--upscale"]:
        if not (repo / UPSCALE_PINS).is_file() and not flags["--record-upscale"]:
            sys.exit(f"make-pack: --upscale: no {UPSCALE_PINS} yet. Run once with --record-upscale on the machine "
                     "that sets the pins, and commit the file.")
        try:
            import numpy, scipy, torch, PIL  # noqa: F401
        except ImportError as e:
            sys.exit(f"make-pack: --upscale needs torch, numpy, scipy and Pillow ({e})")

    out.mkdir(parents=True, exist_ok=True)
    for sub in ("poses", "music", "fonts", "intro"):
        (out / sub).mkdir(exist_ok=True)

    def copy(rel, dst):
        # Only pinned files leave the checkout.
        assert rel in pinned, rel
        shutil.copy2(src / rel, out / dst)

    v1 = "assets/capri/sprites/v1"
    poses = "assets/capri/sprites/poses-v2"
    copy(f"{v1}/runtime-sprite-set.json", "sprites.json")
    n = 0
    for rel in sorted(p for p in pinned if p.startswith(f"{v1}/") and p.endswith(".png")):
        copy(rel, Path(rel).name)
        n += 1
    copy("assets/default/capri-headpat.png", "capri-headpat.png")
    copy(f"{poses}/runtime-poses.json", "poses/poses.json")
    for rel in sorted(p for p in pinned if p.startswith(f"{poses}/PNG/")):
        copy(rel, f"poses/{Path(rel).name}")
    (out / "poses/capri-sleep.png").write_bytes(sleep)
    copy("assets/capri/intro-v1/runtime-intro.json", "intro/runtime-intro.json")
    for rel in sorted(p for p in pinned if p.startswith("assets/capri/intro-v1/PNG/")):
        copy(rel, f"intro/{Path(rel).name}")
    for rel in sorted(p for p in pinned if p.startswith("assets/default/capri-music-v1/")):
        copy(rel, f"music/{Path(rel).name}")
    copy("assets/default/icon-source.png", "icon.png")
    notice = (src / "docs/character-assets.md").read_text().rstrip("\n")
    hair = mochi_hair(repo, opts["--mochi-hair"]) if "mochi" in side_srcs else None
    extra = add_sides(out, side_srcs, side_pinned, geometry, hair, opts["--mochi-hair"]) if side_srcs else []
    doc = json.loads((out / "anim/anim.json").read_text()) if side_srcs else {k: v for k, v in geometry.items() if k not in SIDES}
    doc["capricore"] = add_capricore(out, files122, pinned122, geometry, json.loads((repo / OUTFIT).read_text()))
    (out / "anim/anim.json").write_text(json.dumps(doc, indent=1) + "\n")
    notice122 = "\n".join(l for l in files122["docs/character-assets.md"].decode().strip().splitlines() if not l.startswith("# "))
    notice += (f"\n\n## CapriCore v1.2.2 ({V122_COMMIT[:7]}): her wave, the hanging and ledge cels, the no-jacket redraws\n\n"
               f"`anim/capricore/` and `outfits/no-jacket/` hold files from CapriCore v1.2.2. Its notice:\n\n{notice122.strip()}")
    (out / "NOTICE.md").write_text(f"{notice}\n\n{NOTICE_LINE}\n" + "".join(f"\n{x}" for x in extra))
    shutil.copy2(moods, out / "moods.json")
    shutil.copy2(persona, out / "persona.md")

    exo = "assets/fonts/exo2"
    copy(f"{exo}/OFL.txt", "fonts/OFL.txt")
    for name, w in WEIGHTS.items():
        dst = out / f"fonts/Exo2-{name}.ttf"
        r = subprocess.run([sys.executable, "-m", "fontTools.varLib.instancer", str(src / exo / "Exo2-Variable.ttf"),
                            f"wght={w}", "--static", "--update-name-table", "-q", "-o", str(dst)], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"make-pack: fontTools could not cut Exo2 {name} (pip install fonttools): {r.stderr.strip()[:200]}")

    cat = json.loads((out / "sprites.json").read_text())
    print(f"make-pack: {cat.get('character')} (CapriCore v1.0.4 + pose-sleep v1.1.2 + v1.2.2's wave, cels and no-jacket look) -> {out}: {n + 1} frames, "
          f"{len(list((out / 'poses').glob('*.png')))} poses, {len(list((out / 'intro').glob('*.png')))} intro frames, "
          f"{len(list((out / 'music').glob('*.png')))} music sprites, {len(WEIGHTS)} font weights, icon")
    for side in side_srcs:
        n = sum(1 for _ in (out / "anim" / side).rglob("*") if _.is_file())
        print(f"make-pack: + {SIDES[side]['repo']} @ {SIDES[side]['commit'][:7]} -> {out}/anim/{side}: {n} files"
              + (f" (intro hair: {opts['--mochi-hair']})" if side == "mochi" else ""))
    if flags["--upscale"]:
        cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "synaps-avatar/models"
        n = upscale(out, repo, flags["--record-upscale"], cache)
        print(f"make-pack: + x2 strips: {n}" + (f" (pins recorded in {UPSCALE_PINS})" if flags["--record-upscale"] else ""))
    print(f"make-pack: verify with  synaps-avatar --pack {out} --check")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
