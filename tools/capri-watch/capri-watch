SECRETISH = re.compile(r"(gh[pousr]_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{16,}|sk-[A-Za-z0-9_-]{16,}"
                       r"|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{16,}\.[A-Za-z0-9._-]+)")


def clean(s, n=300):
    s = re.sub(r"[\x00-\x1f\x7f]+", " ", str(s))
    s = SECRETISH.sub("[redacted]", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s if len(s) <= n else s[: n - 1].rstrip() + "…"


def title(s, n=50):
    return '"' + clean(s or "", n) + '"'


def ago(secs):
    secs = int(max(0, secs))
    if secs < 90:
        return f"{secs} s"
    if secs < 5400:
        return f"{round(secs / 60)} min"
    return f"{secs / 3600:.1f} h"


def iso(s):
    """Synaps/GitHub timestamps → unix seconds (None when missing)."""
    if not s:
        return None
    s = re.sub(r"(\.\d{6})\d+", r"\1", s.replace("Z", "+00:00"))
    return dt.datetime.fromisoformat(s).timestamp()


def log(msg):
    print(f"capri-watch: {msg}", file=sys.stderr, flush=True)


class Ev:
    """One event. `level`: a condition (fires when it starts holding, again only after it
    cleared); otherwise a one-shot (fires once, ever)."""
    __slots__ = ("kind", "key", "text", "level", "t")

    def __init__(self, kind, key, text, level=True, t=None):
        self.kind, self.key, self.text, self.level, self.t = kind, key, text, level, t

    def to_json(self):
        return {"kind": self.kind, "key": self.key, "text": self.text, "level": self.level, "t": self.t}

    @classmethod
    def from_json(cls, d):
        return cls(d["kind"], d["key"], d["text"], d.get("level", True), d.get("t"))

    def __repr__(self):
        return f"Ev({self.key!r}, {self.text!r})"


class Sys:
    """Everything that touches the machine. The tests swap it for a fake."""

    def run(self, argv, timeout=30, stdin=None):
        try:
            p = subprocess.run(argv, input=stdin, capture_output=True, text=True, timeout=timeout)
            return p.returncode, p.stdout, p.stderr
        except FileNotFoundError:
            return 127, "", f"{argv[0]}: not found"
        except subprocess.TimeoutExpired:
            return 124, "", f"{argv[0]}: timed out after {timeout} s"

    def statvfs(self, path):
        """(filesystem id, free bytes, total bytes). The id is the mount's source device, so two btrfs
        subvolumes of one disk (bella's / and /home: different st_dev) count as one filesystem."""
        st = os.statvfs(path)
        return self.fs_id(path), st.f_bavail * st.f_frsize, st.f_blocks * st.f_frsize

    def fs_id(self, path):
        real, best, src = os.path.realpath(path), "", None
        try:
            with open("/proc/self/mountinfo") as f:
                for line in f:
                    left, _, right = line.partition(" - ")
                    mnt = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), left.split()[4])
                    if (real == mnt or real.startswith(mnt.rstrip("/") + "/")) and len(mnt) >= len(best):
                        best, src = mnt, (right.split() + ["", ""])[1]
        except OSError:
            pass
        return src if src and src.startswith("/dev/") else os.stat(path).st_dev

    def read(self, path, tail=None):
        with open(path, "rb") as f:
            if tail:
                f.seek(0, 2)
                f.seek(max(0, f.tell() - tail))
            return f.read().decode("utf-8", "replace")

    def glob(self, pattern):
        return sorted(glob.glob(pattern))

    def exists(self, path):
        return os.path.exists(path)

    def now(self):
        return time.time()

    def local_minutes(self, t):
        lt = time.localtime(t)
        return lt.tm_hour * 60 + lt.tm_min

    def sqlite_rows(self, path, sql, args):
        con = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=5)
        try:
            return con.execute(sql, args).fetchall()
        finally:
            con.close()

# ─── the avatar's state (DND, music, presence) ─────────────────────────────────────────────


def probe_avatar(sock=""):
    """Her DND, music and his presence from the avatar's control socket (read-only `brain state`
    and `state`). Self-contained: the ssh transport runs this very function on bella."""
    import json, os, socket, subprocess
    sock = sock or os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "capri", "synaps-avatar.sock")

    def ask(cmd, tries=2):
        # The avatar answers "ok" when its UI thread doesn't reply within 3 s (asleep between
        # frames): ask again once.
        for i in range(tries):
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(5)
            try:
                s.connect(sock)
                s.sendall(cmd.encode() + b"\n")
                buf = b""
                while not buf.endswith(b"\n"):
                    chunk = s.recv(1 << 16)
                    if not chunk:
                        break
                    buf += chunk
            finally:
                s.close()
            try:
                return json.loads(buf.decode() or "null")
            except ValueError:
                if i == tries - 1:
                    raise

    out = {"reachable": False, "dnd": False, "music": None, "present": None, "idle_s": None}
    try:
        b = ask("brain state") or {}
        st = ask("state") or {}
        out.update(reachable=True, dnd=(b.get("gate") or {}).get("dnd_left_s") is not None,
                   present=b.get("present"), idle_s=b.get("idle_s"), music=bool(st.get("music")))
    except Exception:
        pass
    if out["music"] is None:  # no avatar: ask MPRIS directly
        try:
            r = subprocess.run(["playerctl", "--all-players", "status"], capture_output=True, text=True, timeout=3)
            out["music"] = "Playing" in r.stdout.split()
        except Exception:
            out["music"] = False
    return out

# ─── transports ────────────────────────────────────────────────────────────────────────────

REMOTE_RUN = "import base64,json,subprocess,sys\nargv=json.loads(base64.b64decode('{b64}'))\n" \
             "sys.exit(subprocess.run(argv,timeout=30).returncode)\n"


class Transport:
    """Delivers a line into her session and reads her avatar's state on that same machine."""

    def __init__(self, cfg, sysx):
        self.d, self.sys = cfg["deliver"], sysx
        self.sock = cfg["safeguards"]["avatar_socket"]

    def send_argv(self, source, text):
        a = [self.d["synaps"]]
        if self.d["profile"]:
            a += ["--profile", self.d["profile"]]
        return a + ["send", "--session", self.d["session"], "--source", source, "--", text]

    def send(self, source, text):
        raise NotImplementedError

    def avatar(self):
        return probe_avatar(self.sock)


class LocalTransport(Transport):
    def send(self, source, text):
        rc, _, err = self.sys.run(self.send_argv(source, text), timeout=30)
        return rc == 0, clean(err, 200)


class SshTransport(Transport):
    def ssh(self):
        return ["ssh", "-o", "BatchMode=yes", "-o", f"ConnectTimeout={int(self.d['connect_timeout_s'])}",
                "-o", "ServerAliveInterval=5", self.d["ssh_host"], "python3", "-"]

    def remote_script(self, argv):
        # The argv travels base64-encoded inside a Python script on stdin: no remote shell
        # quoting at all (bella's login shell is fish).
        return REMOTE_RUN.format(b64=base64.b64encode(json.dumps(argv).encode()).decode())

    def send(self, source, text):
        rc, _, err = self.sys.run(self.ssh(), timeout=45, stdin=self.remote_script(self.send_argv(source, text)))
        return rc == 0, clean(err, 200)

    def avatar(self):
        src = inspect.getsource(probe_avatar) + f"\nimport json\nprint(json.dumps(probe_avatar({self.sock!r})))\n"
        rc, out, _ = self.sys.run(self.ssh(), timeout=20, stdin=src)
        try:
            return json.loads(out) if rc == 0 else None
        except ValueError:
            return None


class CommandTransport(Transport):
    def send(self, source, text):
        if not self.d["command"]:
            return False, "deliver.command is empty"
        argv = [a.replace("{source}", source).replace("{text}", text).replace("{session}", self.d["session"])
                for a in self.d["command"]]
        rc, _, err = self.sys.run(argv, timeout=30)
        return rc == 0, clean(err, 200)


def make_transport(cfg, sysx):
    return {"local": LocalTransport, "ssh": SshTransport, "command": CommandTransport}[cfg["deliver"]["transport"]](cfg, sysx)

