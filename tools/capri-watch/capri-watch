def merge(base, over, path=""):
    out = copy.deepcopy(base)
    for k, v in (over or {}).items():
        if k not in out:
            raise ValueError(f"unknown setting {path}{k}")
        if isinstance(out[k], dict) and out[k] and not isinstance(v, dict):
            raise ValueError(f"{path}{k} must be a table")
        out[k] = merge(out[k], v, f"{path}{k}.") if isinstance(out[k], dict) and out[k] else v
    return out


def load_config(path=None, text=None, hostname=None):
    over = {}
    if text is None and path and os.path.exists(path):
        with open(path, "rb") as f:
            text = f.read().decode()
    if text:
        if tomllib is None:
            raise RuntimeError("Python 3.11+ (tomllib) is needed to read watch.toml")
        over = tomllib.loads(text)
    cfg = merge(DEFAULTS, over)
    hn = (hostname or socket.gethostname()).split(".")[0].lower()
    if not cfg["role"]:
        cfg["role"] = "bella" if hn in ("bella", "parabellum") else "avante"
    if cfg["role"] not in ("bella", "avante"):
        raise ValueError('role must be "bella" or "avante"')
    bella = cfg["role"] == "bella"
    cfg["host"] = cfg["host"] or cfg["role"]
    cfg["synaps"] = cfg["synaps"] or ("synaps" if bella else "synaps-dev")
    if cfg["github"]["enabled"] is None:
        cfg["github"]["enabled"] = bella
    d = cfg["deliver"]
    d["transport"] = d["transport"] or ("local" if bella else "ssh")
    if d["transport"] not in ("local", "ssh", "command"):
        raise ValueError('deliver.transport must be "local", "ssh" or "command"')
    if cfg["safeguards"]["music"] not in ("defer", "drop", "ignore"):
        raise ValueError('safeguards.music must be "defer", "drop" or "ignore"')
    parse_quiet(cfg["safeguards"]["quiet_hours"])
    return cfg


def parse_quiet(spec):
    if not spec:
        return None
    m = re.fullmatch(r"\s*(\d{1,2}):(\d{2})\s*-\s*(\d{1,2}):(\d{2})\s*", spec)
    if not m:
        raise ValueError('safeguards.quiet_hours must look like "23:00-08:00"')
    a, b = int(m[1]) * 60 + int(m[2]), int(m[3]) * 60 + int(m[4])
    return a, b


def in_quiet(spec, local_minutes):
    q = parse_quiet(spec)
    if not q:
        return False
    a, b = q
    return a <= local_minutes < b if a <= b else (local_minutes >= a or local_minutes < b)

