#!/usr/bin/env python3
"""avatarctl: send one dev-control command to a running synaps-avatar.

  avatarctl mood thinking | clip wave | say "hello\\nworld" | pos 4900 1440 | state | quit
"""
import os, socket, sys

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 2
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "synaps-avatar.sock")
    line = " ".join(sys.argv[1:]).replace("\n", "\\n") + "\n"
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    try:
        s.connect(path)
    except OSError as e:
        print(f"avatarctl: no avatar at {path}: {e}", file=sys.stderr)
        return 1
    s.sendall(line.encode())
    reply = b""
    while not reply.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        reply += chunk
    text = reply.decode().strip()
    print(text)
    return 1 if text.startswith("error") else 0

if __name__ == "__main__":
    sys.exit(main())
