def log(*a):
    print(time.strftime('%H:%M:%S'), *a, file=sys.stderr, flush=True)


def now_ms():
    return time.monotonic() * 1000.0


# ---- models ---------------------------------------------------------------------------------

class Stt:
    def __init__(self, name):
        from pywhispercpp.model import Model
        path = STT_FILES.get(name, STT_FILES['small.en'])
        path = path if os.path.isabs(path) else f'{MODELS}/{path}'
        t = now_ms()
        self.name = name
        self.m = Model(path, n_threads=THREADS, print_progress=False, print_realtime=False, redirect_whispercpp_logs_to=None)
        log(f'stt {name} loaded in {now_ms() - t:.0f} ms ({os.path.basename(path)}, {THREADS} threads, CPU)')

    def __call__(self, pcm, speech_ms=None, prompt=VOCAB, floor=512, tokens=None):
        # The encoder window cut to the utterance (+1 s), not Whisper's fixed 30 s, but never under
        # 512 (10 s): a trimmed clip in a smaller window decodes into loops ("b, b, b, b", "yes,
        # yes, yes") and slow temperature retries. Measured on 30 sentences of 1-3 s of speech:
        # the bare formula 56 % word errors and 15 loops, the 512 floor 3 % and none.
        dur = len(pcm) / MIC_RATE
        ctx = max(floor, min(1500, int(np.ceil((dur + 1.0) * 50 / 64) * 64)))
        segs = self.m.transcribe(pcm, initial_prompt=prompt or '', no_context=True, single_segment=True, audio_ctx=ctx, temperature=0.0,
                                 temperature_inc=0.0, max_tokens=tokens or int(16 + 12 * dur))
        text = ' '.join(s.text for s in segs).strip()
        text = re.sub(r'\[[^\]]*\]|\([^)]*\)', '', text).strip()
        out = unloop(text)
        if len(out.split()) < len(text.split()):
            log(f'stt: a decode loop: {len(text.split()) - len(out.split())} repeated words dropped')
        return out


