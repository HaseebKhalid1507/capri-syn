def write_json(path, v):
    """Atomic: a crash leaves the old file or the new one, never half of one."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f'{path}.tmp'
    with open(tmp, 'w') as f:
        json.dump(v, f)
    os.replace(tmp, path)


def raw_volume(si):
    return [int(ch.get('value', 65536)) for ch in (si.get('volume') or {}).values()]


def close_to(a, b):
    return len(a) == len(b) and all(abs(x - y) <= 1 for x, y in zip(a, b))


class Media:
    """Other audio while she listens or speaks: MPRIS pause (then play, only the ones she paused
    and that are still paused), or a duck: every eligible stream's channels at x0.5 raw (-18 dB),
    put back exactly. Saved to STATE (atomically, on every change) so a crash mid-hold is repaired
    at the next start.

    Duck rules: never her own streams, module/virtual streams (combine-sink loopbacks), calls
    (media.role phone/communication, the [music] ignore list), event/notification sounds; nothing
    at all while another app captures a real source (a call with no role). Corked streams are
    skipped, and ducked if they start mid-hold; a stream that starts mid-hold is ducked too.
    Restore only a stream with the same object.serial whose volume is still what we set (a change
    he made wins). WirePlumber saves a stream's volume per app: a stream that dies while ducked
    would come back ducked, so its originals are kept (VANISHED_S) and a stream of the same app
    that shows up at exactly our ducked level gets them back."""

    def __init__(self):
        self.held = None
        self.vanished = []       # {'app', 'bin', 'orig', 'set', 't'}
        self.ignore = []
        self.lk = threading.RLock()
        self.watch = None        # pactl subscribe, while held (duck) or something vanished
        self.restore_saved()

    def _save(self):
        if self.held or self.vanished:
            write_json(STATE, {**(self.held or {}), 'vanished': self.vanished})
        elif os.path.exists(STATE):
            os.remove(STATE)

    def restore_saved(self):
        try:
            st = json.load(open(STATE))
        except FileNotFoundError:
            return
        except Exception as e:
            log('media: bad state file', e)
            return
        self.vanished = [v for v in st.pop('vanished', []) if time.time() - v.get('t', 0) < VANISHED_S]
        self.held = st if st.get('mode') else None
        log('media: repairing a hold left by a crash:', json.dumps(self.held), f'({len(self.vanished)} vanished)')
        self.release()
        self._watch()

    def eligible(self, si):
        pr = si.get('properties', {})
        app, binary = pr.get('application.name') or '', pr.get('application.process.binary') or ''
        name = f'{app} {pr.get("media.name") or ""}'
        if not app or 'capri-voice' in name:
            return False
        if pr.get('pulse.module.id') or pr.get('node.virtual') == 'true' or pr.get('node.passive') == 'true':
            return False
        if (pr.get('media.role') or '').lower() in NEVER_DUCK_ROLES:
            return False
        low = f'{app} {binary}'.lower()
        if any(i and i in low for i in self.ignore):
            return False
        return not DUCK_MATCH or DUCK_MATCH in name

    def _duck(self, si, orig=None):
        idx, pr = str(si['index']), si.get('properties', {})
        cur = raw_volume(si)
        orig = orig or cur
        want = [max(0, round(v * DUCK_RAW)) for v in orig]
        if not close_to(cur, want):
            run(['pactl', 'set-sink-input-volume', idx, *map(str, want)])
        self.held['streams'][idx] = {'serial': pr.get('object.serial'), 'app': pr.get('application.name') or '',
                                     'bin': pr.get('application.process.binary') or '', 'orig': orig, 'set': want}
        self._save()

    def hold(self, mode):
        with self.lk:
            if self.held or mode == 'off':
                return              # nested: the first hold's originals stand
            if mode == 'pause':
                players = [p for p in run(['playerctl', '-l']).split() if not PLAYERS or p in PLAYERS]
                paused = []
                for p in players:
                    if run(['playerctl', '-p', p, 'status']).strip() == 'Playing':
                        run(['playerctl', '-p', p, 'pause'])
                        paused.append(p)
                self.held = {'mode': 'pause', 'players': paused}
            elif mode == 'duck':
                app = in_call()
                app = 'unknown' if app is None else app     # can't tell: touch nothing
                self.held = {'mode': 'duck', 'streams': {}, 'call': app or None}
                if not app:
                    for si in sink_inputs():
                        if self.eligible(si) and not si.get('corked'):
                            self._duck(si)
            self._save()
            log('media: hold', json.dumps(self.held))
        self._watch()

    def release(self):
        with self.lk:
            h, self.held = self.held, None
            if not h:
                return
            if h.get('mode') == 'pause':
                for p in h.get('players', []):
                    if run(['playerctl', '-p', p, 'status']).strip() == 'Paused':
                        run(['playerctl', '-p', p, 'play'])
            elif h.get('mode') == 'duck':
                now = {str(si['index']): si for si in sink_inputs()}
                for idx, e in h.get('streams', {}).items():
                    si = now.get(idx)
                    if si is None or si.get('properties', {}).get('object.serial') != e.get('serial'):
                        self.vanished.append({**{k: e[k] for k in ('app', 'bin', 'orig', 'set')}, 't': time.time()})
                    elif close_to(raw_volume(si), e['set']):
                        run(['pactl', 'set-sink-input-volume', idx, *map(str, e['orig'])])
                    else:
                        log(f'media: stream {idx} was changed while ducked: left as he set it')
            self._save()
            log('media: released', json.dumps(h))

    # -- the watcher: streams that start, uncork or die while ducked; ones that come back after
    def _watch(self):
        with self.lk:
            want = (self.held or {}).get('mode') == 'duck' or bool(self.vanished)
            if want and self.watch is None:
                p = subprocess.Popen(['pactl', 'subscribe'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
                self.watch = p
                threading.Thread(target=self._watch_loop, args=(p,), daemon=True).start()

    def _watch_loop(self, p):
        rx = re.compile(r"Event '(new|change|remove)' on sink-input #(\d+)")
        for line in p.stdout:
            m = rx.search(line)
            if m:
                try:
                    self._event(m.group(1), m.group(2))
                except Exception as e:
                    log('media: watch:', e)
            with self.lk:
                self.vanished = [v for v in self.vanished if time.time() - v['t'] < VANISHED_S]
                if (self.held or {}).get('mode') != 'duck' and not self.vanished:
                    self.watch = None
                    p.terminate()
                    return

    def _event(self, kind, idx):
        if os.environ.get('CAPRI_VOICE_DEBUG'):
            log('media: event', kind, idx, json.dumps(self.vanished))
        with self.lk:
            held = self.held if (self.held or {}).get('mode') == 'duck' and not self.held.get('call') else None
            if kind == 'remove':
                e = held and held['streams'].pop(idx, None)
                if e:
                    self.vanished.append({**{k: e[k] for k in ('app', 'bin', 'orig', 'set')}, 't': time.time()})
                    self._save()
                return
            if held and idx in held['streams']:
                return              # ours (our own set fires 'change' too)
            si = next((x for x in sink_inputs() if str(x['index']) == idx), None)
            if si is None or not self.eligible(si):
                return
            pr, cur = si.get('properties', {}), raw_volume(si)
            same = lambda v: (v['app'] == (pr.get('application.name') or '') and v['bin'] == (pr.get('application.process.binary') or '')
                              and close_to(cur, v['set']))
            back = next((v for v in self.vanished if same(v)), None)
            # A sibling: another stream of an app we hold ducked starts at the ducked level
            # (WirePlumber's per-app restore); its original is the held one, not -18 dB.
            sib = next((v for v in (held or {}).get('streams', {}).values() if same(v)), None) if not back else None
            if held and si.get('corked'):
                return              # ducked when it starts playing (a stream often starts corked)
            if back:
                self.vanished.remove(back)
            back = back or sib
            if held:
                self._duck(si, back['orig'] if back else None)
            elif back:
                # It came back after the hold at our ducked level (WirePlumber's saved volume).
                run(['pactl', 'set-sink-input-volume', idx, *map(str, back['orig'])])
                log(f'media: stream {idx} ({back["app"]}) came back ducked: put back')
            self._save()


def mic_chunk(p, fd, wait=0.02):
    """The capture's next chunk: None (nothing within `wait`), b'' (it ended) or the bytes."""
    if WIN:
        return p.read(wait)
    r, _, _ = select.select([fd], [], [], wait)
    return os.read(fd, 3200) if r else None


def feed(p, data):
    try:
        p.stdin.write(data)
        p.stdin.close()
    except (BrokenPipeError, ValueError, OSError):
        pass


def run(cmd, timeout=3):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ''


def sink_inputs():
    try:
        return json.loads(run(['pactl', '-f', 'json', 'list', 'sink-inputs']) or '[]')
    except ValueError:
        return []


# ---- unprompted replies: when she stays silent -----------------------------------------------

FEATURES = ['unprompted', 'wake-handsfree']
# Screen lockers (their /proc comm, cut to 15 chars). bella locks with a bare `i3lock`, which sets no
# logind LockedHint, so the process is the signal; LockedHint is the second one.
LOCKERS = [n[:15] for n in (os.environ.get('CAPRI_VOICE_LOCKERS') or
                            'i3lock,i3lock-color,betterlockscreen,xsecurelock,slock,swaylock,gtklock,hyprlock,'
                            'xlock,xtrlock,physlock,waylock').split(',') if n]
CAP_S = 10.0                    # one unprompted reply: at most this much audio
BUDGET_S, WINDOW_S = 20.0, 60.0 # unprompted speech in any rolling window
STALE_S = 15.0                  # a reply that waited longer than this for its turn stays text


def screen_locked():
    """A screen locker runs (bella's bare i3lock sets no LockedHint). ~1 ms: raw reads of /proc/*/comm."""
    lockers = {n.encode() for n in LOCKERS}
    for d in os.listdir('/proc'):
        if d.isdigit():
            try:
                fd = os.open(f'/proc/{d}/comm', os.O_RDONLY)
                try:
                    if os.read(fd, 32).strip() in lockers:
                        return True
                finally:
                    os.close(fd)
            except OSError:
                pass
    return False


def sink_kind(with_id=False):
    """'headphones' when the default sink's active port, name or form factor says so; else 'speakers'.
    with_id: (kind, (sink, port)) to tell a change."""
    name = run(['pactl', 'get-default-sink'], 1.0).strip()
    kind, port = 'speakers', None
    for si in pactl_json('sinks') or []:
        if si.get('name') != name:
            continue
        port = si.get('active_port') or ''
        types = [x.get('type', '') for x in si.get('ports', []) if x.get('name') == port]
        blob = ' '.join([name, port, *types, si.get('properties', {}).get('device.form-factor', '')]).lower()
        kind = 'headphones' if re.search(r'headphone|headset|earbud|hands-?free', blob) else 'speakers'
        break
    return (kind, (name, port)) if with_id else kind


def env_db(x, n):
    """Level per n-sample frame, dB."""
    k = len(x) // n
    if k == 0:
        return np.zeros(0, np.float32)
    return (20 * np.log10(np.sqrt(np.mean(x[:k * n].reshape(k, n) ** 2, axis=1)) + 1e-6)).astype(np.float32)


def echo_corr(mic, play, max_lag=ECHO_LAGS, with_lag=False):
    """Best correlation of the mic's level envelope with her playback's, 20 ms frames, over lags
    0..max_lag frames: pw-play's own start (~0.1-0.2 s, measured from its launch) plus up to 0.4 s of
    output latency (Bluetooth and HDMI sit at 0.15-0.3 s)."""
    best, at = 0.0, 0
    for lag in range(max_lag):
        a, b = mic[lag:lag + len(play)], play[:len(mic) - lag]
        n = min(len(a), len(b))
        if n < 8:
            break
        a, b = a[:n] - a[:n].mean(), b[:n] - b[:n].mean()
        d = float(np.sqrt((a * a).sum() * (b * b).sum()))
        if d > 0 and float((a * b).sum()) / d > best:
            best, at = float((a * b).sum()) / d, lag
    return (best, at) if with_lag else best


def words_of(t):
    return re.sub(r"[^a-z0-9' ]", ' ', t.lower()).split()


def her_own(text, said):
    """The transcript is mostly words she said lately (her voice back through the mic)."""
    w = words_of(text)
    if not w or not said:
        return False
    pool = set(said)
    return sum(x in pool for x in w) / len(w) >= ECHO_WORDS


def node_missing(kind, name):
    """A named source/sink that isn't there. pw-record and pw-play fall back to the DEFAULT node
    when their target is missing (measured): a missing test mic would be his real mic."""
    if not name:
        return False
    out = run(['pactl', 'list', 'short', kind], 1.0)
    return name not in [l.split('\t')[1] for l in out.splitlines() if '\t' in l]


def locked_hint():
    for sid in run(['loginctl', 'show-user', str(os.getuid()), '-p', 'Sessions', '--value'], 0.5).split():
        if run(['loginctl', 'show-session', sid, '-p', 'LockedHint', '--value'], 0.5).strip() == 'yes':
            return True
    return False


def other_capture(items, sources):
    """Another app capturing a real source (not a monitor): a call, a recorder. Ours, and level
    meters, don't count."""
    for o in items:
        pr = o.get('properties', {})
        if pr.get('application.name') == 'capri-voice' or pr.get('media.name') == 'Peak detect' or pr.get('stream.monitor') == 'true':
            continue
        src = sources.get(o.get('source'))
        if src is None or src.get('name', '').endswith('.monitor') or src.get('properties', {}).get('device.class') == 'monitor':
            continue
        return pr.get('application.name') or 'an app'
    return None


def pactl_json(what, tries=2):
    """`pactl list WHAT` as JSON, or None when pactl fails twice (unknown is not empty)."""
    for _ in range(tries):
        try:
            r = subprocess.run(['pactl', '-f', 'json', 'list', what], capture_output=True, text=True, timeout=0.5)
            if r.returncode == 0:
                return json.loads(r.stdout or '[]')
        except Exception:
            pass
    return None


def in_call():
    """The app capturing a real source (a call), '' if none, None if it can't be told."""
    items = pactl_json('source-outputs')
    if not items:
        return None if items is None else ''
    sources = pactl_json('sources')
    if sources is None:
        return None
    return other_capture(items, {x.get('index'): x for x in sources}) or ''


def dnd_on():
    """His do-not-disturb: dunst paused ($mod+Ctrl+n). Asked over D-Bus (dunstctl takes seconds)."""
    return run(['busctl', '--user', 'get-property', 'org.freedesktop.Notifications', '/org/freedesktop/Notifications',
                'org.dunstproject.cmd0', 'paused'], 0.5).strip() == 'b true'


class Gate:
    """Nothing she says is heard with the screen locked or in a call (any other app capturing a
    real source; unknown counts as a call): checked before every sentence and every 0.35 s while
    one plays. An unprompted reply (she speaks without him asking) also stays silent with his
    do-not-disturb on (dunst paused), past the speech budget, past CAP_S for the reply, or after
    waiting STALE_S for its turn."""

    def __init__(self):
        self.queued = {}         # id -> when its first sentence arrived
        self.skipped, self.dropped = set(), set()
        self.spent = {}          # id -> seconds of it heard
        self.heard = []          # (t_end, seconds) of unprompted audio
        self.cache = {}
        self.check_ms = 0.0

    def _cached(self, key, ttl, fn):
        t, v = self.cache.get(key, (-1e9, None))
        if time.monotonic() - t > ttl:
            v = fn()
            self.cache[key] = (time.monotonic(), v)
        return v

    def reset_ids(self):
        """A new avatar: its turn ids start again (the budget stays)."""
        self.queued, self.skipped, self.dropped, self.spent = {}, set(), set(), {}

    def now_why(self, unprompted=True):
        """Why nothing she says may be heard now (any speech, his turns too): the lock, a call. When
        pactl can't tell, an unprompted reply stays silent; his own spoken turn goes on."""
        if screen_locked() or self._cached('hint', 2.0, locked_hint):
            return 'screen locked'
        app = in_call()
        if app is None:
            return 'audio state unknown' if unprompted else None
        if app:
            return f'call ({app})'
        return None

    def budget_used(self, now):
        self.heard = [(t, d) for t, d in self.heard if t > now - WINDOW_S]
        return sum(min(d, t - (now - WINDOW_S)) for t, d in self.heard)

    def check(self, sid, dur, pcm):
        """(why, pcm): why this sentence of turn `sid` stays silent, or None (pcm, maybe cut to the
        reply's cap)."""
        now = time.monotonic()
        first = sid not in self.spent
        if first and now - self.queued.get(sid, now) > STALE_S:
            return 'too late', pcm
        if first and self._cached('dnd', 5.0, dnd_on):
            return 'do not disturb', pcm
        spent = self.spent.get(sid, 0.0)
        if not first and spent + dur > CAP_S:
            return 'reply cap', pcm
        if first and dur > CAP_S:
            n, fade = int(CAP_S * TTS_RATE), int(0.15 * TTS_RATE)
            pcm = pcm[:n].copy()
            pcm[-fade:] *= np.linspace(1, 0, fade, dtype=np.float32)
            dur = CAP_S
        if self.budget_used(now) + dur > BUDGET_S:
            return 'speech budget', pcm
        self.spent[sid] = spent + dur
        return None, pcm

    def played(self, secs):
        self.heard.append((time.monotonic(), secs))


class Voice:
    def __init__(self):
        self.lock = threading.Lock()
        self.conn = None
        self.gate = Gate()
        self.cfg = {'stt_model': os.environ.get('CAPRI_VOICE_STT', 'small.en'), 'voice': VOICE, 'speed': SPEED, 'flow': FLOW, 'pace': PACE}
        self.last_said = (None, '', 0.0)  # (id, text, tail silence s) of the last sentence: the gap before the next
        self.stt = Stt(self.cfg['stt_model'])
        self.vad = Vad.load()
        self.stt_lock = threading.Lock()   # one Whisper decode at a time (a draft and the final)
        self.played = None       # her sentence now playing: start, level envelope (hands-free)
        self.said = collections.deque(maxlen=40)   # (t_end, words) of her sentences: the echo guard
        self.hf_drop = False
        self.wake = None         # the wake word's stage 1: loaded when first turned on
        self.wake_forced, self.wake_forced_for = None, None    # its sound-alike filter (False: off), for that Stt
        self.wake_personal = None
        self.wake_paused_until = 0.0
        self.wake_checks = collections.deque(maxlen=WAKE_VERIFY_N)   # times of the last Whisper checks
        self.wake_n = {'candidates': 0, 'rejected': 0, 'woke': 0, 'second': 0, 'paused': 0, 'no_speech': 0, 'handsfree': 0, 'verify_ms': []}
        self.tts = Tts()
        self.media = Media()
        self.release_timer = None
        self.rec = None          # the pw-record process: the open capture stream
        self.rec_buf = []
        self.rec_stop_at = None
        self.cancelled = False
        self.say_q = []          # (id, text, t_recv)
        self.play_q = []         # (id, text, pcm, shapes, t_recv, synth_ms)
        self.player = None       # the pw-play process now playing
        self.playing = None      # ... and whose sentence it is
        self.hush_gen = 0
        self.cv = threading.Condition(self.lock)
        self.turns = []          # timings, last 20
        self.cur = {}
        threading.Thread(target=self._synth_loop, daemon=True).start()
        threading.Thread(target=self._play_loop, daemon=True).start()

    # -- out
    def emit(self, **ev):
        line = (json.dumps(ev) + '\n').encode()
        c = self.conn
        if c is None:
            return
        try:
            c.sendall(line)
        except OSError:
            pass

    # -- mic
    def listen_start(self, mode='hold', silence_s=1.0, max_s=0.0, echo='auto', sensitivity=0.5, handsfree=False):
        if self.rec is not None and self.cur.get('mode') == 'wake' and mode != 'wake' and self.rec_stop_at is None:
            self.listen_cancel()          # his act wins over the standing wake stream; the avatar re-arms it after
        # A capture that is closing (the toggle giving way to hands-free) is waited for, briefly.
        for _ in range(150):
            if self.rec is None or self.rec_stop_at is None:
                break
            time.sleep(0.01)
        if self.rec is not None:
            return
        mode = mode if mode in CAP_S_MODE else 'hold'
        self.cur = {'t_start': now_ms(), 'mode': mode}
        refuse = None
        if TEST and (not SOURCE or SOURCE.startswith('alsa_')):
            refuse = 'TEST SIDECAR · NO REAL MIC'
        elif node_missing('sources', SOURCE):
            refuse = 'NO MIC · ITS SOURCE IS GONE'        # never the default instead
        elif screen_locked() or self.gate._cached('hint', 2.0, locked_hint):
            refuse = 'NO MIC · SCREEN LOCKED'
        elif mode != 'hold' and not self.vad:
            refuse = 'NO MIC · NO SPEECH DETECTOR (capri-voice-setup)'
        elif mode == 'handsfree' and (app := in_call()) != '':
            refuse = 'NO MIC · IN A CALL' if app else 'NO MIC · AUDIO STATE UNKNOWN'
        elif mode == 'wake':
            if time.time() < self.wake_paused_until:
                refuse = 'WAKE PAUSED · TOO MANY FALSE STARTS'
            elif (app := in_call()) != '':
                refuse = 'WAKE PAUSED · IN A CALL' if app else 'WAKE PAUSED · AUDIO STATE UNKNOWN'
            else:
                if self.wake is None:
                    self.wake, why = WakeEar.load()      # loaded the first time it is asked for, never before
                    if why:
                        log(f'wake: {why}')
                    self.wake_personal = wake_personal()
                    if self.wake_personal:
                        p = self.wake_personal
                        log(f"wake: his personal layer is on ({WAKE_PERSONAL}: {len(p.get('templates', []))} templates"
                            + (f", tau {p['tau']:.2f}" if 'templates' in p else '') + ')')
                if self.wake is None:
                    refuse = 'WAKE OFF · NO MODEL (capri-voice-setup)'
        if refuse:
            self.cur['t_heard'] = now_ms()
            self.emit(ev='mic-closed', mode=mode)
            self.emit(ev='heard', text='', why=refuse, ms=self._ms())
            log(f'mic: refused ({refuse})')
            return
        # 20 ms chunks (pw-record's default is ~100 ms): the endpoint sees a pause that much sooner.
        cmd = ['pw-record', '--rate', str(MIC_RATE), '--channels', '1', '--format', 's16', '--raw', '--latency', '20ms',
               '-P', f'{{ application.name = "capri-voice" media.name = "capri-voice {"push-to-talk" if mode == "hold" else mode}" '
                     f'{"" if MOVABLE else "node.dont-reconnect = true "}node.dont-fallback = true capri.capture = "{self._capture_tag()}" }}']
        if SOURCE:
            cmd += ['--target', SOURCE]
        self.rec_buf, self.rec_stop_at, self.cancelled = [], None, False
        vs = VadStream(self.vad) if self.vad else None
        silence_s = float(np.clip(silence_s, 0.5, 5.0))
        ep = Endpointer(silence_s) if mode == 'toggle' and vs else None
        if WIN:
            try:
                self.rec = _win.Mic(MIC_RATE, SOURCE)
            except Exception as e:
                log(f'mic: no capture ({e})')
                self.cur['t_heard'] = now_ms()
                self.emit(ev='mic-closed', mode=mode)
                self.emit(ev='heard', text='', why='NO MIC · CAPTURE FAILED', ms=self._ms())
                return
        else:
            self.rec = subprocess.Popen(cmd + ['-'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
        if mode == 'wake':
            echo = echo if echo in ('headphones', 'speakers') else sink_kind()
            thr = self.wake.threshold(sensitivity)
            if TEST and os.environ.get('CAPRI_VOICE_TEST_WAKE_THR'):
                thr = float(os.environ['CAPRI_VOICE_TEST_WAKE_THR'])   # tests only: every hop a candidate (the limiter's test)
            # "hey capri" goes on as hands-free in this same stream (no gap, so nothing he says right after is lost)
            hf = {'max_s': float(max_s) if max_s and max_s > 0 else CAP_S_MODE['handsfree']} if handsfree else None
            self.cur.update(echo=echo, thr=thr, hf=hf)
            threading.Thread(target=self._wake_loop, args=(self.rec, silence_s, self.cur), daemon=True).start()
        elif mode == 'handsfree':
            cap = float(max_s) if max_s and max_s > 0 else CAP_S_MODE['handsfree']
            echo = echo if echo in ('headphones', 'speakers') else sink_kind()
            self.cur.update(cap_s=cap, echo=echo)
            threading.Thread(target=self._hf_loop, args=(self.rec, vs, silence_s, self.cur), daemon=True).start()
        else:
            threading.Thread(target=self._rec_loop, args=(self.rec, vs, ep, self.cur), daemon=True).start()
        log('mic: capture starting', SOURCE or '(default source)', f'({mode}' + (f", {self.cur['echo']}" if mode in ('handsfree', 'wake') else '') + ')')

    def _draft(self, vs, speech, data=None, mode='toggle'):
        """Decode what he said so far, in a worker (the capture goes on)."""
        dr = {'speech': speech, 'text': None, 'done': threading.Event()}
        pcm = np.frombuffer(b''.join(self.rec_buf) if data is None else bytes(data), np.int16).astype(np.float32) / 32768.0
        probs = list(vs.p)

        def run():
            t = now_ms()
            try:
                span = speech_span(probs, mode)
                speech_ms = sum(x >= SPEECH_P for x in probs) * FRAME_S * 1000
                text = ''
                if span:
                    a = max(0, span[0] * VAD_FRAME - int(LEAD_S * MIC_RATE))
                    b = min(len(pcm), (span[1] + 1) * VAD_FRAME + int(TAIL_S * MIC_RATE))
                    with self.stt_lock:
                        text = self.stt(pcm[a:b], speech_ms)
                dr.update(text=text, speech_ms=speech_ms, stt_ms=now_ms() - t, clip_s=len(pcm) / MIC_RATE)
            finally:
                dr['done'].set()
        threading.Thread(target=run, daemon=True).start()
        return dr

    def _capture_tag(self):
        """A name for this capture's stream, unique to it, so the watchdog finds it (and only it)."""
        self.capture_n = getattr(self, 'capture_n', 0) + 1
        self.capture_tag = f'{os.getpid()}-{self.capture_n}'
        return self.capture_tag

    def _watchdog(self, p, cur, hf=False):
        """The capture stays on the source it opened. If PipeWire moves it (a device removed, a
        default changed), the capture is killed at once and what it heard is dropped: it is never
        whatever the new source is. Windows: the stream itself stays on its device (capri_voice_win.Mic)."""
        if WIN:
            return
        so, tag = None, self.capture_tag
        for _ in range(40):
            if p.poll() is not None:
                return
            so = next((o for o in pactl_json('source-outputs') or []
                       if o.get('properties', {}).get('capri.capture') == tag), None)
            if so:
                break
            time.sleep(0.05)
        if not so:
            log('mic: watchdog: our stream was not found')
            return
        idx, src = str(so.get('index')), so.get('source')
        cur['source'] = src
        sub = subprocess.Popen(['pactl', 'subscribe'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        cur['watch'] = sub
        for line in sub.stdout:
            if p.poll() is not None:
                break
            if f"on source-output #{idx}" in line or "'remove' on source #" in line:
                o = next((x for x in pactl_json('source-outputs') or [] if str(x.get('index')) == idx), None)
                if o is None:
                    break
                if o.get('source') != src:
                    log(f'mic: watchdog: our stream moved (source {src} -> {o.get("source")}): killed, nothing kept')
                    cur['moved'] = True
                    if not hf:
                        self.cancelled = True
                        cur.setdefault('refused', 'MIC LOST · ITS SOURCE CHANGED')
                    p.kill()
                    break
        sub.terminate()

    def _watch_calls(self, call):
        """While a hands-off stream is open, a capture that appears re-checks for a call (no polling).
        A new capture isn't linked to its source when announced: look again on its 'change' events
        and 0.3 s later. Unknown counts as a call (an open mic fails closed). Windows: a poll."""
        def check():
            app = in_call()
            if app is None:
                app = 'unknown'
            if app:
                call['app'] = app
            return bool(app)

        if WIN:
            return _win.CallWatch(check)
        sub = subprocess.Popen(['pactl', 'subscribe'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)

        def watch():
            for line in sub.stdout:
                if "'new' on source-output" in line or "'change' on source-output" in line:
                    if check():
                        return
                    if "'new'" in line:
                        threading.Timer(0.3, check).start()
        threading.Thread(target=watch, daemon=True).start()
        return sub

    def _wake_speech(self, ring):
        """Silero hears speech in the last second of the ring (>= WAKE_SPEECH_MIN frames), or there is no Silero."""
        if not self.vad:
            return True
        x = np.frombuffer(bytes(ring[-2 * MIC_RATE:]), np.int16).astype(np.float32) / 32768.0
        return sum(p >= SPEECH_P for p in self.vad.probs(x)) >= WAKE_SPEECH_MIN

    def _wake_filter(self):
        """(T, margin) of the decode just made, or None: the filter off (CAPRI_VOICE_WAKE_FILTER=0) or not loadable.
        Call it under stt_lock, right after the decode."""
        if self.wake_forced is False or os.environ.get('CAPRI_VOICE_WAKE_FILTER', '1') == '0':
            return None
        if self.wake_forced is None or self.wake_forced_for is not self.stt:
            self.wake_forced, why = WakeForced.load(self.stt.m, min(4, THREADS))
            self.wake_forced_for = self.stt
            if why:
                log(f'wake: {why}')
                self.wake_forced = False
                return None
        try:
            return self.wake_forced()
        except Exception as e:
            log(f'wake: the sound-alike filter failed ({e}); the text alone from now on')
            self.wake_forced = False
            return None

    def _wake_loop(self, p, silence_s, cur):
        """The wake word: one standing stream. Idle, the last 2.5 s stay in RAM and are scored every
        80 ms; no level events. A candidate goes to Whisper (at most 12 in 10 min, else 10 min off);
        a pass is a turn, endpointed as a toggle's. On speakers her voice is dropped at the reader, so
        she can't wake herself; on headphones a wake while she speaks stops her. It ends on
        listen-cancel, the lock, a call, too many false starts, or the stream dying."""
        fd = p.stdout.fileno()
        ear, thr, echo = self.wake, cur['thr'], cur['echo']
        ring, ring_max = bytearray(), int(WAKE_RING_S * MIC_RATE) * 2
        pers = self.wake_personal or {}
        tpl, tau = pers.get('templates'), pers.get('tau', 2.0)
        ws = WakeEar.Stream(ear, tpl)
        opened, last_lock, last_lvl, prev, last_fire, quiet_until = False, now_ms(), 0.0, False, 0.0, 0.0
        cand, turn, end_why, call = None, None, None, {'app': None}
        follow = []                      # a bare "Hey Capri." found at the second look: his turn starts now
        hf_on, go = bool(cur.get('hf')), {}   # hands-free after the phrase: go = {'seed': audio after it (None: the ring), 'cut'}
        sub = self._watch_calls(call)

        def check(c, pcm):
            t0 = now_ms()
            try:
                with self.stt_lock:
                    c['text'] = wake_text(self.stt, pcm)      # kept in RAM for the turn below, never logged
                    c['tm'] = self._wake_filter()             # the sound-alike filter on the same encoder pass
                    c['ok'] = wake_accept(wake_says(c['text']), c['tm'], self.wake_personal)
            except Exception as e:
                log(f'wake: the check failed ({e})')
            c['ms'] = now_ms() - t0
            self.wake_n['verify_ms'] = (self.wake_n['verify_ms'] + [c['ms']])[-50:]
            c['done'].set()

        def feed_turn(tn, data):
            tn['buf'] += data
            tn['vs'].feed(bytes(data))
            for q in tn['vs'].p[tn['seen']:]:
                why = tn['ep'].feed(q)
                if tn['ep'].speech == tn['ep'].min_frames and not tn.get('quiet'):
                    self.emit(ev='speech')
                if why:
                    tn['seen'] = len(tn['vs'].p)
                    return why
            tn['seen'] = len(tn['vs'].p)
            return None

        def second(tn, why):
            """A rejected candidate's second look: his whole turn (the phrase and what follows, up to 10 s),
            decoded once as any turn is. It says "hey capri": a wake, sent at once. Else dropped, words never logged.
            Nothing shows while it is taken: no tag, no meter, no media hold."""
            c, e = tn['c'], tn['ep']
            if why == 'nothing':
                return
            speech_ms = e.speech * FRAME_S * 1000
            pcm = np.frombuffer(bytes(tn['buf']), np.int16).astype(np.float32) / 32768.0
            dur = len(pcm) / MIC_RATE

            def out():
                t0 = now_ms()
                with self.stt_lock:
                    text = self.stt(pcm, speech_ms)
                    tm = self._wake_filter()                # the turn starts where the check's window did
                c['stt_ms'] = now_ms() - t0
                says = wake_says(text)
                ft = f", filter {tm[0]:.1f} / {tm[1]:+.1f}" if tm else ''
                if not wake_accept(says, tm, self.wake_personal, look=True):
                    log(f"wake: the second look rejected it too ({dur:.1f} s, {c['stt_ms']:.0f} ms{ft}{'' if says else ', no phrase in the words'})")
                    return
                self.wake_n['woke'] += 1
                self.wake_n['second'] += 1
                log(f"wake: heard at the second look ({dur:.1f} s, {c['stt_ms']:.0f} ms{ft})")
                if self.player is not None or self.play_q or self.say_q:
                    self.hush(why='wake')
                rest, hf = wake_rest(text)
                if hf_on:
                    # Hands-free from here: his request (if any) is its first turn; what he says next, the next ones.
                    self.emit(ev='wake', second=True, handsfree=True, ms={'fire_to_wake': now_ms() - c['t_start'], 'verify': round(c['stt_ms'])})
                    if rest and not hf:
                        c['t_endpoint'] = c['t_keyup'] = now_ms()
                        self.emit(ev='endpoint', why=why, speech_ms=round(speech_ms), silence_ms=round(e.trail * FRAME_S * 1000))
                        self._sent(rest, speech_ms, dur, c)
                    go.update(seed=None, cut=not (rest and not hf))
                    return
                self.emit(ev='wake', second=True, ms={'fire_to_wake': now_ms() - c['t_start'], 'verify': round(c['stt_ms'])})
                c['t_endpoint'] = c['t_keyup'] = now_ms()
                self.emit(ev='endpoint', why=why, speech_ms=round(speech_ms), silence_ms=round(e.trail * FRAME_S * 1000))
                if hf:
                    c['t_heard'] = now_ms()
                    self.emit(ev='wake-handsfree', ms=self._ms(c))
                    return
                if not rest:
                    follow.append(c)
                    return
                self._sent(rest, speech_ms, dur, c)
            threading.Thread(target=out, daemon=True).start()

        def finish(tn, why):
            if tn.get('quiet'):
                return second(tn, why)
            c, e = tn['c'], tn['ep']
            c['t_endpoint'] = c['t_keyup'] = now_ms()
            speech_ms = e.speech * FRAME_S * 1000
            self.emit(ev='endpoint', why=why, speech_ms=round(speech_ms), silence_ms=round(e.trail * FRAME_S * 1000))
            if why == 'nothing':
                c['t_heard'] = now_ms()
                self.emit(ev='heard', text='', why='NOTHING HEARD · MIC CLOSED', ms=self._ms(c))
                log('wake: nothing said after the phrase')
                return
            pcm = np.frombuffer(bytes(tn['buf']), np.int16).astype(np.float32) / 32768.0
            dur = len(pcm) / MIC_RATE

            def out():
                t0 = now_ms()
                with self.stt_lock:
                    text = self.stt(pcm, speech_ms)
                c['stt_ms'] = now_ms() - t0
                rest, hf = wake_rest(text)
                if hf:
                    c['t_heard'] = now_ms()
                    self.emit(ev='wake-handsfree', ms=self._ms(c))
                    log('wake: "let\'s talk": hands-free')
                    return
                self._sent(rest, speech_ms, dur, c)
            threading.Thread(target=out, daemon=True).start()

        while True:
            if go:
                break
            if self.rec_stop_at is not None and now_ms() >= self.rec_stop_at:
                break
            if call['app']:
                end_why = 'call'
                break
            if cur.get('moved'):
                end_why = 'mic lost'
                break
            if now_ms() - last_lock >= 900:
                last_lock = now_ms()
                if screen_locked():
                    end_why = 'lock'
                    break
            chunk = mic_chunk(p, fd)
            if chunk is None:
                if p.poll() is not None:
                    end_why = 'mic lost'
                    break
                continue
            if not chunk:
                end_why = 'mic lost'
                break
            t = now_ms()
            if not opened:
                opened = True
                cur['t_mic_open'] = t
                self.emit(ev='mic-open', mode='wake', echo=echo)
                log(f"mic: open (+{t - cur['t_start']:.0f} ms, wake word, {echo}, threshold {thr:.2f})")
                threading.Thread(target=self._watchdog, args=(p, cur, True), daemon=True).start()
            if self.cancelled:
                continue
            chunk = chunk[:len(chunk) // 2 * 2]
            if follow and turn is None:
                c, cand = follow.pop(), None     # his request, from what came after the phrase (in the ring)
                turn = {'buf': bytearray(), 'vs': VadStream(self.vad), 'seen': 0, 'c': c,
                        'ep': Endpointer(float(np.clip(silence_s, 0.5, 5.0)), max_s=WAKE_TURN_S, wait_s=WAKE_WAIT_S,
                                         min_frames=MIN_FRAMES['wake'])}
                pre, ring = bytes(ring), bytearray()
                why = feed_turn(turn, pre)
                if why:
                    finish(turn, why)
                    turn = None
            if turn is not None and turn.get('quiet') and echo == 'speakers' and (self.player is not None or self.play_q or self.say_q):
                turn, cand = None, None          # she started speaking on speakers: the second look is dropped
                ring.clear()
                ws, prev, last_fire = WakeEar.Stream(ear, tpl), False, time.time()
                continue
            if turn is not None:
                if t - last_lvl >= 200 and not turn.get('quiet'):
                    last_lvl = t
                    x = np.frombuffer(chunk, np.int16).astype(np.float32) / 32768.0
                    self.emit(ev='level', v=round(min(1.0, float(np.sqrt(np.mean(x * x))) * 8), 3) if len(x) else 0.0)
                why = feed_turn(turn, chunk)
                if why:
                    finish(turn, why)
                    turn, cand = None, None
                    ring.clear()
                    ws, prev, last_fire = WakeEar.Stream(ear, tpl), False, time.time()
                continue
            replying = self.player is not None or bool(self.play_q) or bool(self.say_q)
            if replying:
                quiet_until = time.time() + DUPLEX_S
            if echo == 'speakers' and (replying or time.time() < quiet_until):
                continue                     # half-duplex: she can't wake herself
            ring += chunk
            del ring[:max(0, len(ring) - ring_max)]
            if cand is not None:
                cand['post'] += chunk
                if not cand['started'] and len(cand['post']) >= int(WAKE_CHECK_DELAY_S * MIC_RATE) * 2:
                    cand['started'] = True
                    pcm = wake_check_pcm(cand['pre'], cand['post'])
                    threading.Thread(target=check, args=(cand, pcm), daemon=True).start()
                if cand['done'].is_set():
                    if cand['ok']:
                        self.wake_n['woke'] += 1
                        tm = cand.get('tm')
                        log(f"wake: heard (score {cand['score']:.2f}, checked in {cand['ms']:.0f} ms" + (f", filter {tm[0]:.1f} / {tm[1]:+.1f})" if tm else ')'))
                        if self.player is not None or self.play_q or self.say_q:
                            self.hush(why='wake')
                        c = {'t_start': cand['t'], 't_mic_open': cand['t'], 'mode': 'wake'}
                        # The check heard more than the phrase: the turn is the phrase and what follows (the phrase is
                        # cut from its words). Only the phrase ("Hey Capri." then a pause): the turn starts after the
                        # checked audio, so his pause isn't taken as the end of the turn; 5 s for him to start.
                        bare = not wake_rest(cand.get('text', ''))[0]
                        cut = int(WAKE_CHECK_DELAY_S * MIC_RATE) * 2
                        if hf_on:
                            # Hands-free: the same stream goes on as one, from the phrase (its first utterance cut) or after it.
                            self.emit(ev='wake', handsfree=True, ms={'fire_to_wake': now_ms() - cand['t'], 'verify': round(cand['ms'])})
                            # (from the phrase: the ring's last WAKE_HF_LEAD_S, so words before it can't end a turn of their own)
                            lead = cand['pre'][-int(WAKE_HF_LEAD_S * MIC_RATE) * 2:]
                            go.update(seed=bytes(cand['post'][cut:]) if bare else lead + bytes(cand['post']), cut=True)
                            cand = None
                            break
                        self.emit(ev='wake', ms={'fire_to_wake': now_ms() - cand['t'], 'verify': round(cand['ms'])})
                        turn = {'buf': bytearray() if bare else bytearray(cand['pre']), 'vs': VadStream(self.vad), 'seen': 0, 'c': c,
                                'ep': Endpointer(float(np.clip(silence_s, 0.5, 5.0)), max_s=WAKE_TURN_S, wait_s=WAKE_WAIT_S,
                                                 min_frames=MIN_FRAMES['wake'])}
                        why = feed_turn(turn, cand['post'][cut:] if bare else cand['post'])
                        if why:
                            finish(turn, why)
                            turn = None
                    else:
                        self.wake_n['rejected'] += 1
                        tm = cand.get('tm')
                        look = WAKE_SECOND and (tm is None or tm[1] > WAKE_SECOND_MARGIN)
                        log(f"wake: a candidate rejected by the check (score {cand['score']:.2f}, {cand['ms']:.0f} ms"
                            + (f", filter {tm[0]:.1f} / {tm[1]:+.1f}" if tm else '') + ')' + ('; a second look at his turn' if look else ''))
                        if look:
                            c = {'t_start': cand['t'], 't_mic_open': cand['t'], 'mode': 'wake'}
                            turn = {'buf': bytearray(), 'vs': VadStream(self.vad), 'seen': 0, 'c': c, 'quiet': True,
                                    'ep': Endpointer(float(np.clip(silence_s, 0.5, 5.0)), max_s=WAKE_SECOND_S, wait_s=WAKE_WAIT_S,
                                                     min_frames=MIN_FRAMES['wake'])}
                            why = feed_turn(turn, cand['pre'] + bytes(cand['post']))   # the phrase counts as his speech
                            if why:
                                finish(turn, why)
                                turn = None
                    cand = None
                continue
            for sc, ps in ws.push(np.frombuffer(chunk, np.int16)):
                hot = sc >= thr or ps >= tau        # the head's, or his personal layer's (if he made one)
                if hot and prev and time.time() - last_fire >= WAKE_REFRACTORY_S:
                    last_fire = now = time.time()
                    if not self._wake_speech(ring):
                        self.wake_n['no_speech'] += 1    # no speech in the last second (music, a door): no check, no count
                        prev = hot
                        continue
                    while self.wake_checks and now - self.wake_checks[0] > WAKE_VERIFY_S:
                        self.wake_checks.popleft()
                    if len(self.wake_checks) >= WAKE_VERIFY_N:
                        self.wake_paused_until = now + WAKE_PAUSE_S
                        self.wake_n['paused'] += 1
                        end_why = 'false starts'
                        break
                    self.wake_checks.append(now)
                    self.wake_n['candidates'] += 1
                    cand = {'pre': bytes(ring), 'post': bytearray(), 'done': threading.Event(), 'ok': False, 'ms': 0,
                            't': now_ms(), 'score': sc, 'personal': ps, 'started': False}
                    break
                prev = hot
            if end_why:
                break
        if go and not end_why and not self.cancelled and self.rec_stop_at is None:
            seed = go['seed'] if go['seed'] is not None else bytes(ring)
            t = now_ms()
            cur.update(mode='handsfree', cap_s=cur['hf']['max_s'], t_start=t, t_mic_open=t)
            self.wake_n['handsfree'] += 1
            log(f"mic: the wake stream goes on as hands-free ({len(seed) / 2 / MIC_RATE:.1f} s of him already in it"
                + (', the phrase cut from its first words' if go['cut'] else '') + ')')
            return self._hf_loop(p, VadStream(self.vad), float(np.clip(silence_s, 0.5, 5.0)), cur,
                                 seed=seed[:len(seed) // 2 * 2], cut_first=go['cut'], calls=(sub, call))
        sub.terminate()
        p.terminate()
        try:
            p.wait(1)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
        cancelled = self.cancelled
        self.rec = None
        cur['t_mic_closed'] = now_ms()
        self.emit(ev='mic-closed', mode='wake')
        log(f"mic: closed (wake word{', ' + end_why if end_why else ''})")
        if not cancelled and end_why:
            self.emit(ev='wake-end', why=end_why, app=call['app'] or '')

    def _hf_loop(self, p, vs, silence_s, cur, seed=None, cut_first=False, calls=None):
        """Hands-free: one stream, many turns. Each utterance ends on his pause (draft-decoded, held on
        after dangling words) and is sent; the stream stays open. On speakers the mic is deaf while
        she speaks (+0.25 s); on headphones his voice over hers stops her (not in her first sentence,
        which checks that her voice isn't coming back through the mic). It ends on listen-cancel, the
        lock, a call, its cap, or the stream dying; the avatar times out the quiet.
        From the wake stream ("hey capri"): the same capture goes on here, already open (seed: what of him it holds
        after the phrase, or from it with cut_first: the phrase is cut from the first utterance's words), its call
        watch too (calls)."""
        fd = p.stdout.fileno()
        opened, last_lvl, last_lock, seen = seed is not None, 0.0, now_ms(), 0
        echo, observe = cur['echo'], cur['echo'] == 'headphones'
        tb = bytearray()                     # this turn's audio: frame k of vs.p = tb[k*1024:(k+1)*1024]
        new_ep = lambda: Endpointer(silence_s, max_s=HF_TURN_S, wait_s=1e9, min_frames=MIN_FRAMES['hands-free'])
        ep, dr, bi = new_ep(), None, []
        ring = collections.deque(maxlen=1500)      # (time, dB) of every 20 ms of mic: 30 s
        check = None                                # her sentence under observation: t0, env, due
        quiet_until, end_why, call = 0.0, None, {'app': None}
        sink_id, last_t0 = (sink_kind(True)[1] if echo == 'headphones' else None), None
        self.hf_drop = False
        sub, call = calls if calls else (self._watch_calls(call), call)
        first = {'cut': cut_first}

        def reset_turn():
            nonlocal ep, dr, seen
            n = len(vs.p) * 2 * VAD_FRAME
            del tb[:n]
            vs.p.clear()
            ep, dr, seen = new_ep(), None, 0

        sink_now = {}                        # the sink re-read at her sentence, off the reader thread
        def read_sink():
            sink_now['v'] = sink_kind(True)

        def finish(why_ep, d):
            """The turn's words: the draft's, or decoded now (in a worker)."""
            c = {'t_endpoint': now_ms(), 'mode': 'handsfree', 't_keyup': now_ms()}
            self.emit(ev='endpoint', why=why_ep, speech_ms=round(ep.speech * FRAME_S * 1000), silence_ms=round(ep.trail * FRAME_S * 1000))
            if d is None:
                d = self._draft(vs, ep.speech, tb, 'hands-free')
            said = [w for t, ws in list(self.said) if t > time.time() - ECHO_WINDOW_S for w in ws]
            cut = first.pop('cut', False)        # the first utterance after "hey capri": the phrase is cut, as a wake turn's

            def out():
                d['done'].wait(10.0)
                if cur.get('moved'):
                    return                   # the stream left its source: nothing it heard goes out
                text = d.get('text') or ''
                c['stt_ms'] = d.get('stt_ms', 0)
                if text and her_own(text, said):
                    log(f'heard: dropped (her own voice; {len(text)} chars)')
                    c['t_heard'] = now_ms()
                    self.emit(ev='heard', text='', why='ECHO', ms=self._ms(c))
                    return
                if cut and text:
                    rest = wake_first(text)
                    if not rest:
                        log(f'heard: the phrase alone ({len(text)} chars): hands-free goes on')
                        c['t_heard'] = now_ms()
                        self.emit(ev='heard', text='', why='PHRASE ONLY', ms=self._ms(c))
                        return
                    text = rest
                self._sent(text, d.get('speech_ms', 0), d.get('clip_s', 0), c)
            threading.Thread(target=out, daemon=True).start()

        while True:
            if self.rec_stop_at is not None and now_ms() >= self.rec_stop_at:
                break
            if opened and now_ms() - cur['t_mic_open'] >= cur['cap_s'] * 1000:
                end_why = 'max'
                break
            if call['app']:
                end_why = 'call'
                break
            if cur.get('moved'):
                end_why = 'mic lost'
                break
            if now_ms() - last_lock >= 900:
                last_lock = now_ms()
                if screen_locked():
                    end_why = 'lock'
                    break
            if seed:
                chunk, seed = seed[:3200], seed[3200:]   # what the wake stream already holds of him, first, as it came
            else:
                chunk = mic_chunk(p, fd)
                if chunk is None:
                    if p.poll() is not None:
                        end_why = 'mic lost'
                        break
                    continue
                if not chunk:
                    end_why = 'mic lost'
                    break
            t = now_ms()
            if not opened:
                opened = True
                cur['t_mic_open'] = t
                self.emit(ev='mic-open', mode='handsfree', echo=echo)
                log(f"mic: open (+{t - cur['t_start']:.0f} ms, hands-free, {echo})")
                threading.Thread(target=self._watchdog, args=(p, cur, True), daemon=True).start()
            if self.cancelled:
                continue
            if self.hf_drop:                  # Esc: what is being heard now is dropped; the stream stays
                self.hf_drop = False
                reset_turn()
            playing = self.player is not None
            # Her reply, not her sentence: the gaps between sentences are hers too (synthesis takes
            # longer than DUPLEX_S), so a word he starts there isn't cut by her next sentence.
            replying = playing or bool(self.play_q) or bool(self.say_q)
            if replying:
                quiet_until = time.time() + DUPLEX_S
            pl = self.played
            if echo == 'headphones' and playing and pl and pl['t0'] != last_t0:
                last_t0 = pl['t0']
                threading.Thread(target=read_sink, daemon=True).start()
            if echo == 'headphones' and 'v' in sink_now:
                # each sentence: if the sink or its port changed (headphones unplugged), one that
                # isn't headphones is speakers at once, another headphone one is observed again
                kind, sid_ = sink_now.pop('v')
                if sid_ != sink_id and kind != 'headphones':
                    echo = cur['echo'] = 'speakers'
                    log('echo: the sink changed and is not headphones: speakers')
                    self.emit(ev='echo', mode='speakers', why='sink')
                    reset_turn()
                    observe, check = False, None
                elif sid_ != sink_id:
                    sink_id, observe, check = sid_, True, None
                    log('echo: another headphone sink or port: observing this sentence again')
            x = np.frombuffer(chunk[:len(chunk) // 2 * 2], np.int16).astype(np.float32) / 32768.0
            if t - last_lvl >= 200:
                last_lvl = t
                self.emit(ev='level', v=round(min(1.0, float(np.sqrt(np.mean(x * x))) * 8), 3) if len(x) else 0.0)
            # Her first sentence: does her voice come back through the mic? The mic's level on a 20 ms
            # grid, each frame timed from the chunk's arrival, against her playback's level.
            if observe and echo == 'headphones':      # only while a sentence of hers is to be checked
                n20, t_end = MIC_RATE // 50, time.time()
                for j in range(len(x) // n20):
                    seg = x[j * n20:(j + 1) * n20]
                    ring.append((t_end - (len(x) - j * n20) / MIC_RATE, 10 * math.log10(float(seg @ seg) / n20 + 1e-12)))
            if observe and echo == 'headphones':
                pl = self.played
                if check is None and playing and pl:
                    check = {'t0': pl['t0'], 'env': pl['env'], 'due': None}
                elif check is not None and check['due'] is None and (not playing or (pl and pl['t0'] != check['t0'])):
                    check['due'] = time.time() + ECHO_LAGS * 0.02    # her tail, as late as it may come
                if check is not None and check['due'] is not None and time.time() >= check['due']:
                    env, t0 = check['env'], check['t0']
                    grid = np.full(len(env) + ECHO_LAGS, -120.0, np.float32)
                    ok = np.zeros(len(grid), bool)
                    before = [v for tm, v in ring if tm < t0]
                    for tm, v in ring:
                        i = int(round((tm - t0) / 0.02))
                        if 0 <= i < len(grid):
                            grid[i], ok[i] = v, True
                    fl = float(np.median(before[-150:])) if before else -90.0
                    if ok.any():
                        idx = np.arange(len(grid))
                        grid = np.interp(idx, idx[ok], grid[ok]).astype(np.float32)   # a late chunk's gap
                    corr, lag = echo_corr(grid, env, with_lag=True)
                    loud = float(np.percentile(grid[ok], 90)) - fl if ok.any() else 0.0
                    log(f'echo check: corr {corr:.2f} at {lag * 20} ms, mic {loud:.1f} dB over its floor')
                    if corr >= ECHO_CORR and loud >= ECHO_DB:
                        echo = cur['echo'] = 'speakers'
                        self.emit(ev='echo', mode='speakers', corr=round(corr, 2), db=round(loud, 1), lag_ms=lag * 20)
                        reset_turn()                 # what it holds is her first sentence
                    observe, check = False, None
                    ring.clear()
            if echo == 'speakers' and (replying or time.time() < quiet_until):
                continue                      # half-duplex: deaf while she speaks
            tb += chunk
            vs.feed(chunk)
            for q in vs.p[seen:]:
                if replying and echo == 'headphones' and not observe:
                    bi = (bi + [q])[-BARGE_OF:]
                    if sum(v >= BARGE_P for v in bi) >= BARGE_N:
                        bi = []
                        log(f'barge-in: his voice over hers ({now_ms() - t:.0f} ms behind the mic)')
                        if TEST:
                            log('barge-in: p', ' '.join(f'{v:.2f}' for v in vs.p[-30:]))
                        self.hush(why='barge-in')
                        self.emit(ev='barge-in')
                elif bi:
                    bi = []
                why = ep.feed(q)
                if ep.speech == ep.min_frames:
                    self.emit(ev='speech')
                if dr and ep.speech != dr['speech']:
                    dr = None
                if (dr is None and ep.speech >= ep.min_frames and ep.trail * FRAME_S >= ep.draft_at()
                        and not self.stt_lock.locked()):
                    dr = self._draft(vs, ep.speech, tb, 'hands-free')
                if why == 'silence' and dr is not None:
                    dr['done'].wait(5.0)
                    if dr['text'] and not ep.extra and dangles(dr['text']):
                        ep.extra = DANGLE_S
                        why = None
                if why in ('silence', 'cap'):
                    finish(why, dr if why == 'silence' else None)
                    reset_turn()
                    break
            seen = len(vs.p)
            # Nothing started: keep ~0.5 s (the lead), forget a blip after 1 s of quiet.
            if ep.speech < ep.min_frames and len(vs.p) > 48 and (ep.speech == 0 or ep.trail * FRAME_S >= 1.0):
                k = len(vs.p) - 16
                del tb[:k * 2 * VAD_FRAME]
                del vs.p[:k]
                seen = len(vs.p)
                ep, dr = new_ep(), None        # (its frame count too: the turn cap counts from speech)
        sub.terminate()
        p.terminate()
        try:
            p.wait(1)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
        cancelled = self.cancelled
        self.rec = None
        cur['t_mic_closed'] = now_ms()
        self.emit(ev='mic-closed', mode='handsfree')
        log(f"mic: closed (hands-free{', ' + end_why if end_why else ''})")
        if not cancelled and end_why:
            self.emit(ev='handsfree-end', why=end_why, app=call['app'] or '')

    def _rec_loop(self, p, vs, ep, cur):
        opened, last_lvl, last_lock, fd = False, 0.0, now_ms(), p.stdout.fileno()
        cap = CAP_S_MODE[cur.get('mode', 'hold')] * 1000
        seen, dr = 0, None
        while True:
            if self.rec_stop_at is not None and now_ms() >= self.rec_stop_at:
                break
            if opened and self.rec_stop_at is None and now_ms() - cur['t_mic_open'] >= cap:
                log(f'mic: hard cap ({cap / 1000:.0f} s): sending what was heard')
                self.rec_stop_at = now_ms()
            if now_ms() - last_lock >= 900:     # the lock closes any capture within 1 s
                last_lock = now_ms()
                if screen_locked():
                    log('mic: the screen locked: capture cancelled')
                    cur['refused'] = 'NO MIC · SCREEN LOCKED'
                    self.listen_cancel()
            chunk = mic_chunk(p, fd)
            if chunk is None:
                if p.poll() is not None:
                    break
                continue
            if not chunk:
                break
            if not opened:
                opened = True
                cur['t_mic_open'] = now_ms()
                threading.Thread(target=self._watchdog, args=(p, cur), daemon=True).start()
                self.emit(ev='mic-open', mode=cur.get('mode', 'hold'))
                log(f"mic: open (+{cur['t_mic_open'] - cur['t_start']:.0f} ms)")
            if not self.cancelled:
                self.rec_buf.append(chunk)
                if vs:
                    vs.feed(chunk)
                    if ep and self.rec_stop_at is None:
                        for q in vs.p[seen:]:
                            why = ep.feed(q)
                            if ep.speech == ep.min_frames and not cur.get('t_speech'):
                                cur['t_speech'] = now_ms()
                                self.emit(ev='speech')       # he is talking: a tap now sends
                            # A draft decode in his pause, so the words are ready when it ends (and
                            # say whether they dangle). New speech makes it stale.
                            if dr and ep.speech != dr['speech']:
                                dr = None
                            if (dr is None and ep.speech >= ep.min_frames and ep.trail * FRAME_S >= ep.draft_at()
                                    and not self.stt_lock.locked()):
                                dr = self._draft(vs, ep.speech)
                            if why == 'silence' and dr is not None:
                                dr['done'].wait(5.0)
                                if dr['text'] and not ep.extra and dangles(dr['text']):
                                    ep.extra = DANGLE_S
                                    cur['held_on'] = cur.get('held_on', 0) + 1
                                    log(f'mic: the words dangle: {DANGLE_S:.1f} s more')
                                    why = None
                                elif dr['text'] is not None:
                                    cur['draft'] = dr
                            if why:
                                self._endpoint(why, ep, cur)
                                break
                        seen = len(vs.p)
            t = now_ms()
            if t - last_lvl >= 200:
                last_lvl = t
                x = np.frombuffer(chunk[:len(chunk) // 2 * 2], np.int16).astype(np.float32) / 32768.0
                self.emit(ev='level', v=round(min(1.0, float(np.sqrt(np.mean(x * x))) * 8), 3) if len(x) else 0.0)
        p.terminate()
        try:
            p.wait(1)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
        if cur.get('watch'):
            cur['watch'].terminate()
        # This capture's clip and fate, taken before self.rec is cleared (a new capture may start
        # right after and reset them).
        buf, cancelled = self.rec_buf, self.cancelled or cur.get('moved')
        self.rec_buf = []
        self.rec = None
        cur['t_mic_closed'] = now_ms()
        self.emit(ev='mic-closed', mode=cur.get('mode', 'hold'))
        log('mic: closed (process gone)')
        if cancelled:
            if cur.get('refused'):
                cur['t_heard'] = now_ms()
                self.emit(ev='heard', text='', why=cur['refused'], ms=self._ms(cur))
            return
        pcm = np.frombuffer(b''.join(buf), np.int16).astype(np.float32) / 32768.0
        del buf
        self._heard(pcm, vs, cur)

    def _endpoint(self, why, e, cur):
        """The toggle's turn is over: send it (silence, cap), or close with nothing heard."""
        cur['t_keyup'] = cur['t_endpoint'] = now_ms()
        self.emit(ev='endpoint', why=why, speech_ms=round(e.speech * FRAME_S * 1000), silence_ms=round(e.trail * FRAME_S * 1000))
        log(f'mic: endpoint ({why}; {e.speech * FRAME_S:.2f} s of speech, {e.trail * FRAME_S:.2f} s of silence)')
        if why == 'nothing':
            cur['refused'] = 'NOTHING HEARD · MIC CLOSED'
            self.listen_cancel()
        else:
            self.rec_stop_at = now_ms()

    def listen_stop(self):
        self.cur['t_keyup'] = now_ms()
        if self.rec is None:
            return
        # A short tail so the last consonant survives.
        self.rec_stop_at = now_ms() + 120

    def listen_cancel(self):
        self.cancelled = True
        self.rec_buf = []
        self.rec_stop_at = now_ms()

    def _drop(self, why, chars, speech_ms, dur, c):
        """Not sent: a quiet DIDN'T CATCH THAT on her tag. Logged by length only, never words or audio."""
        c['t_heard'] = now_ms()
        self.emit(ev='heard', text='', why="DIDN'T CATCH THAT", ms=self._ms(c))
        log(f'heard: dropped ({why}; {chars} chars, {speech_ms:.0f} ms of speech in {dur:.1f} s)')

    def _heard(self, pcm, vs, c):
        dur = len(pcm) / MIC_RATE
        d = c.pop('draft', None)
        if d is not None:
            # His pause ended on words already decoded (no new speech since): those are sent.
            del pcm
            text, speech_ms = d['text'], d['speech_ms']
            c['stt_ms'], c['draft'] = d['stt_ms'], True
            return self._sent(text, speech_ms, dur, c)
        # Gate on speech before Whisper: it invents short phrases from silence and clicks.
        if vs:
            span = speech_span(vs.p, c.get('mode', 'hold'))
            speech_ms = sum(x >= SPEECH_P for x in vs.p) * VAD_FRAME / MIC_RATE * 1000
            if span is None:
                del pcm
                return self._drop('no speech', 0, speech_ms, dur, c)
            a = max(0, span[0] * VAD_FRAME - int(LEAD_S * MIC_RATE))
            b = min(len(pcm), (span[1] + 1) * VAD_FRAME + int(TAIL_S * MIC_RATE))
            pcm = pcm[a:b]
        else:
            fr = int(0.02 * MIC_RATE)
            n = len(pcm) // fr
            rms = np.sqrt(np.mean(pcm[:n * fr].reshape(n, fr) ** 2, axis=1)) if n else np.zeros(0)
            floor = float(np.percentile(rms, 20)) if n else 0.0
            speech_ms = float(np.sum(rms > max(0.008, floor * 3)) * 20)
            if speech_ms < 300:
                del pcm
                return self._drop('no speech (energy gate)', 0, speech_ms, dur, c)
        t = now_ms()
        with self.stt_lock:
            text = self.stt(pcm, speech_ms)
        del pcm  # dropped after decoding (never written anywhere)
        c['stt_ms'] = now_ms() - t
        return self._sent(text, speech_ms, dur, c)

    def _sent(self, text, speech_ms, dur, c):
        why = junk(text, speech_ms) if text else 'empty'
        if why:
            return self._drop(why, len(text), speech_ms, dur, c)
        c['t_heard'] = now_ms()
        self.emit(ev='heard', text=text, why='', ms=self._ms(c))
        log(f"heard: {len(text)} chars in {c['stt_ms']:.0f} ms from {dur:.1f} s ({speech_ms:.0f} ms of speech)"
            + (' (the draft)' if c.get('draft') else '') + (f" (held on {c['held_on']}x)" if c.get('held_on') else ''))

    def _ms(self, c=None):
        c = self.cur if c is None else c
        d = lambda a, b: round(c[b] - c[a]) if a in c and b in c else None
        return {'keyup_to_closed': d('t_keyup', 't_mic_closed'), 'stt': round(c['stt_ms']) if 'stt_ms' in c else None,
                'endpoint_to_heard': d('t_endpoint', 't_heard'), 'draft': bool(c.get('draft')), 'held_on': c.get('held_on', 0),
                'keyup_to_heard': d('t_keyup', 't_heard'), 'press_to_open': d('t_start', 't_mic_open')}

    # -- speech
    def say(self, sid, text, unprompted=False):
        with self.cv:
            if sid in self.gate.skipped or sid in self.gate.dropped:
                return
            if unprompted:
                self.gate.queued.setdefault(sid, time.monotonic())
            self.say_q.append((sid, text, now_ms(), self.hush_gen, unprompted))
            self.cv.notify_all()

    def drop(self, sid):
        with self.cv:
            self.gate.dropped.add(sid)
            self.say_q = [q for q in self.say_q if q[0] != sid]
            self.play_q = [q for q in self.play_q if q[0] != sid]
            p = self.player if self.playing == sid else None
        if p is not None:
            p.kill()
        log(f'drop {sid}')

    def skip(self, sid, why):
        """An unprompted reply stays silent from here (it is text on her side)."""
        with self.cv:
            if sid in self.gate.skipped:
                return
            self.gate.skipped.add(sid)
            self.say_q = [q for q in self.say_q if q[0] != sid]
            self.play_q = [q for q in self.play_q if q[0] != sid]
        self.emit(ev='say-skipped', id=sid, why=why)
        log(f'say {sid}: skipped ({why})')

    def hush(self, why='hush'):
        with self.cv:
            self.hush_gen += 1
            self.say_q.clear()
            self.play_q.clear()
            self.gate.queued.clear()
            p = self.player
            self.cv.notify_all()
        if p is not None:
            p.kill()
        self.emit(ev='hushed')
        log(why)

    def _synth_loop(self):
        while True:
            with self.cv:
                while not self.say_q:
                    self.cv.wait()
                sid, text, t_recv, gen, unprompted = self.say_q.pop(0)
            t = now_ms()
            try:
                prev_id, prev_text, prev_tail = self.last_said
                gap = max(0.0, sentence_gap(prev_text, self.cfg['flow'], float(self.cfg['speed'])) - prev_tail) if prev_id == sid else 0.0
                pcm = self.tts(text, self.cfg['voice'], float(self.cfg['speed']), self.cfg['flow'], gap, self.cfg['pace'])
                self.last_said = (sid, text, edge_silence(pcm)[1])
            except Exception as e:
                log('tts failed:', e)
                self.emit(ev='say-end', id=sid, error=str(e))
                continue
            synth = now_ms() - t
            with self.cv:
                if gen != self.hush_gen:
                    continue
                if sid in self.gate.skipped or sid in self.gate.dropped:
                    continue
                self.play_q.append((sid, text, pcm, shapes(pcm), t_recv, synth, gen, unprompted))
                self.cv.notify_all()

    def _play_loop(self):
        while True:
            with self.cv:
                while not self.play_q:
                    self.cv.wait()
                sid, text, pcm, shp, t_recv, synth, gen, unprompted = self.play_q.pop(0)
                if gen != self.hush_gen:
                    continue
            t = now_ms()
            why = self.gate.now_why(unprompted)
            if not why and unprompted:
                why, pcm = self.gate.check(sid, len(pcm) / TTS_RATE, pcm)
            self.gate.check_ms = now_ms() - t
            if why:
                self.skip(sid, why)
                continue
            if (TEST and (not SINK or SINK.startswith('alsa_'))) or node_missing('sinks', SINK):
                self.skip(sid, 'test sink missing' if TEST else 'its sink is gone')   # never the default instead
                continue
            with self.cv:
                if gen != self.hush_gen or sid in self.gate.dropped:
                    continue
                cmd = ['pw-play', '--rate', str(TTS_RATE), '--channels', '1', '--format', 's16', '--raw',
                       '-P', '{ application.name = "capri-voice" media.name = "capri-voice speech" node.dont-reconnect = true node.dont-fallback = true }']
                if SINK:
                    cmd += ['--target', SINK]
                if WIN:
                    try:
                        p = _win.Player(TTS_RATE, SINK)
                    except Exception as e:
                        log(f'say {sid}: no output ({e})')
                        p = None
                else:
                    p = subprocess.Popen(cmd + ['-'], stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)
                self.player, self.playing = p, sid
            if p is None:
                with self.cv:
                    self.player, self.playing = None, None
                self.skip(sid, 'no audio output')
                continue
            data = (np.clip(pcm, -1, 1) * 32767).astype(np.int16).tobytes()
            t0 = now_ms()
            # For hands-free: her level on a 20 ms grid (the echo check) and her words (the echo guard).
            self.played = {'t0': time.time(), 'env': env_db(pcm, int(TTS_RATE * 0.02))}
            self.said.append((time.time() + len(pcm) / TTS_RATE, words_of(strip_markup(text))))
            self.emit(ev='say-start', id=sid, text=text, dur_ms=round(len(pcm) / TTS_RATE * 1000), step_ms=STEP_MS, shapes=shp,
                      ms={'queued_to_audio': round(t0 - t_recv), 'synth': round(synth)})
            log(f'say {sid}: {len(text)} chars, synth {synth:.0f} ms, recv->audio {t0 - t_recv:.0f} ms, {len(pcm) / TTS_RATE:.2f} s, '
                f'gate {self.gate.check_ms:.0f} ms' + (' (unprompted)' if unprompted else ''))
            # Fed from a thread (pw-play takes its input in big gulps), so a sentence stops within
            # ~0.4 s if a call starts or the screen locks under it.
            threading.Thread(target=feed, args=(p, data), daemon=True).start()
            why = None
            while True:
                try:
                    p.wait(timeout=0.35)
                    break
                except subprocess.TimeoutExpired:
                    if why is None and (why := self.gate.now_why(unprompted)):
                        p.kill()
            if unprompted:
                self.gate.played(len(pcm) / TTS_RATE if why is None else (now_ms() - t0) / 1000)
            with self.cv:
                self.player, self.playing = None, None
                hushed = gen != self.hush_gen or sid in self.gate.dropped
            if why:
                self.skip(sid, why)
            elif not hushed:
                self.emit(ev='say-end', id=sid)

    # -- protocol
    def handle(self, msg):
        op = msg.get('op')
        if op == 'config':
            for k in ('voice', 'speed', 'flow', 'pace'):
                if k in msg:
                    self.cfg[k] = msg[k]
            if isinstance(msg.get('duck_ignore'), list):
                self.media.ignore = [str(i).lower() for i in msg['duck_ignore'] if str(i).strip()]
            try:
                parse_voice(self.cfg['voice'])
            except ValueError as e:
                log(f'{e}; using the default voice')
                self.cfg['voice'] = VOICE
            if self.cfg['flow'] not in FLOW_PRESETS:
                self.cfg['flow'] = FLOW
            if self.cfg['pace'] not in PACES:
                self.cfg['pace'] = PACE
            if msg.get('stt_model') and msg['stt_model'] != self.stt.name:
                self.cfg['stt_model'] = msg['stt_model']
                self.stt = Stt(msg['stt_model'])
            self.emit(ev='ready', cfg=self.cfg, features=FEATURES)
        elif op == 'listen-start':
            self.listen_start(msg.get('mode', 'hold'), float(msg.get('silence_s', 1.0)), float(msg.get('max_s', 0) or 0), msg.get('echo', 'auto'),
                              float(msg.get('sensitivity', 0.5)), bool(msg.get('handsfree')))
        elif op == 'listen-drop':
            self.hf_drop = True
        elif op == 'listen-stop':
            self.listen_stop()
        elif op == 'listen-cancel':
            self.listen_cancel()
        elif op == 'say':
            self.say(msg.get('id', 0), msg.get('text', ''), bool(msg.get('unprompted')))
        elif op == 'drop':
            self.drop(msg.get('id', 0))
        elif op == 'hush':
            self.hush()
        elif op == 'media-hold':
            if self.release_timer is not None:
                self.release_timer.cancel()
                self.release_timer = None
            self.media.hold(msg.get('mode', 'pause'))
        elif op == 'media-release':
            # Other audio comes back a beat after her last word (after_ms), or now.
            if self.release_timer is not None:
                self.release_timer.cancel()
            after = float(msg.get('after_ms', 0)) / 1000.0
            if after > 0:
                self.release_timer = threading.Timer(after, self.media.release)
                self.release_timer.daemon = True
                self.release_timer.start()
            else:
                self.release_timer = None
                self.media.release()
        elif op == 'stats':
            w = self.wake_n
            self.emit(ev='stats', mic_open=self.rec is not None, mic_mode=self.cur.get('mode') if self.rec is not None else None,
                      speaking=self.player is not None, cfg=self.cfg, vad='silero' if self.vad else 'energy',
                      wake={'loaded': self.wake is not None, 'candidates': w['candidates'], 'rejected': w['rejected'], 'woke': w['woke'],
                            'second': w['second'], 'paused': w['paused'], 'no_speech': w['no_speech'], 'handsfree': w['handsfree'], 'paused_s': max(0, round(self.wake_paused_until - time.time())),
                            'verify_ms_p50': round(float(np.median(w['verify_ms']))) if w['verify_ms'] else None,
                            'filter': None if self.wake_forced is None else bool(self.wake_forced), 'personal': bool(self.wake_personal)})
        else:
            self.emit(ev='error', why=f'unknown op {op!r}')

    def serve(self):
        if WIN:
            return _win.serve(self._accepted)
        if os.path.exists(SOCK):
            os.remove(SOCK)
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SOCK)
        os.chmod(SOCK, 0o600)
        srv.listen(2)
        log('listening on', SOCK)
        while True:
            c, _ = srv.accept()
            self._accepted(c)

    def _accepted(self, c):
        """Her link: the one before it is dropped."""
        old, self.conn = self.conn, c
        if old is not None:
            try:
                old.close()
            except OSError:
                pass
        threading.Thread(target=self._client, args=(c,), daemon=True).start()

    def _client(self, c):
        log('avatar connected')
        with self.cv:
            self.gate.reset_ids()
        buf = b''
        while True:
            try:
                d = c.recv(4096)
            except OSError:
                d = b''
            if not d:
                break
            buf += d
            while b'\n' in buf:
                line, buf = buf.split(b'\n', 1)
                try:
                    self.handle(json.loads(line))
                except Exception as e:
                    log('bad message:', e)
        log('avatar gone')
        if self.conn is c:
            self.conn = None
            # Her end went away: the mic closes, she stops, other audio comes back.
            if self.rec is not None:
                self.listen_cancel()
            self.hush()
            self.media.release()


def write_wav(path, a, rate=TTS_RATE):
    import wave
    with wave.open(path, 'wb') as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes((np.clip(a, -1, 1) * 32767).astype(np.int16).tobytes())


def read_wav(path):
    import wave
    with wave.open(path, 'rb') as w:
        x = np.frombuffer(w.readframes(w.getnframes()), np.int16)
        if w.getnchannels() > 1:
            x = x.reshape(-1, w.getnchannels()).mean(1)
    return (x / 32768.0).astype(np.float32)


