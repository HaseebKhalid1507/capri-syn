# ---- unprompted replies: when she stays silent -----------------------------------------------

FEATURES = ['unprompted']
# Screen lockers (their /proc comm, cut to 15 chars). bella locks with a bare `i3lock`, which sets no
# logind LockedHint, so the process is the signal; LockedHint is the second one.
LOCKERS = [n[:15] for n in (os.environ.get('CAPRI_VOICE_LOCKERS') or
                            'i3lock,i3lock-color,betterlockscreen,xsecurelock,slock,swaylock,gtklock,hyprlock').split(',') if n]
CAP_S = 10.0                    # one unprompted reply: at most this much audio
BUDGET_S, WINDOW_S = 20.0, 60.0 # unprompted speech in any rolling window
STALE_S = 15.0                  # a reply that waited longer than this for its turn stays text


def screen_locked():
    for d in os.listdir('/proc'):
        if d.isdigit():
            try:
                with open(f'/proc/{d}/comm') as f:
                    if f.read().strip() in LOCKERS:
                        return True
            except OSError:
                pass
    return False


def locked_hint():
    for sid in run(['loginctl', 'show-user', str(os.getuid()), '-p', 'Sessions', '--value'], 0.5).split():
        if run(['loginctl', 'show-session', sid, '-p', 'LockedHint', '--value'], 0.5).strip() == 'yes':
            return True
    return False


def other_capture(items, sources):
    """Another app capturing a real source (not a monitor): a call, a recorder. Ours, and level
    meters, don't count."""
    for o in items:
        pr = o.get('properties', {})
        if pr.get('application.name') == 'capri-voice' or pr.get('media.name') == 'Peak detect' or pr.get('stream.monitor') == 'true':
            continue
        src = sources.get(o.get('source'))
        if src is None or src.get('name', '').endswith('.monitor') or src.get('properties', {}).get('device.class') == 'monitor':
            continue
        return pr.get('application.name') or 'an app'
    return None


def in_call():
    try:
        items = json.loads(run(['pactl', '-f', 'json', 'list', 'source-outputs'], 0.5) or '[]')
        if not items:
            return None
        sources = {x['index']: x for x in json.loads(run(['pactl', '-f', 'json', 'list', 'sources'], 0.5) or '[]')}
    except (ValueError, KeyError):
        return None
    return other_capture(items, sources)


def dnd_on():
    """His do-not-disturb: dunst paused ($mod+Ctrl+n). Asked over D-Bus (dunstctl takes seconds)."""
    return run(['busctl', '--user', 'get-property', 'org.freedesktop.Notifications', '/org/freedesktop/Notifications',
                'org.dunstproject.cmd0', 'paused'], 0.5).strip() == 'b true'


class Gate:
    """An unprompted reply (she speaks without him asking) stays silent in a call (any other app
    capturing a mic), with the screen locked, with his do-not-disturb on (dunst paused), past the
    speech budget, past CAP_S for the reply, or after waiting STALE_S for its turn. Checked before
    each of its sentences, and every 0.5 s while one plays (call, lock)."""

    def __init__(self):
        self.queued = {}         # id -> when its first sentence arrived
        self.skipped, self.dropped = set(), set()
        self.spent = {}          # id -> seconds of it heard
        self.heard = []          # (t_end, seconds) of unprompted audio
        self.cache = {}
        self.check_ms = 0.0

    def _cached(self, key, ttl, fn):
        t, v = self.cache.get(key, (-1e9, None))
        if time.monotonic() - t > ttl:
            v = fn()
            self.cache[key] = (time.monotonic(), v)
        return v

    def now_why(self):
        if screen_locked() or self._cached('hint', 2.0, locked_hint):
            return 'screen locked'
        if (app := in_call()):
            return f'call ({app})'
        return None

    def budget_used(self, now):
        self.heard = [(t, d) for t, d in self.heard if t > now - WINDOW_S]
        return sum(min(d, t - (now - WINDOW_S)) for t, d in self.heard)

    def check(self, sid, dur, pcm):
        """(why, pcm): why this sentence of turn `sid` stays silent, or None (pcm, maybe cut to the
        reply's cap)."""
        now = time.monotonic()
        first = sid not in self.spent
        if first and now - self.queued.get(sid, now) > STALE_S:
            return 'too late', pcm
        if (why := self.now_why()):
            return why, pcm
        if first and self._cached('dnd', 5.0, dnd_on):
            return 'do not disturb', pcm
        spent = self.spent.get(sid, 0.0)
        if not first and spent + dur > CAP_S:
            return 'reply cap', pcm
        if first and dur > CAP_S:
            n, fade = int(CAP_S * TTS_RATE), int(0.15 * TTS_RATE)
            pcm = pcm[:n].copy()
            pcm[-fade:] *= np.linspace(1, 0, fade, dtype=np.float32)
            dur = CAP_S
        if self.budget_used(now) + dur > BUDGET_S:
            return 'speech budget', pcm
        self.spent[sid] = spent + dur
        return None, pcm

    def played(self, secs):
        self.heard.append((time.monotonic(), secs))


class Voice:
    def __init__(self):
        self.lock = threading.Lock()
        self.conn = None
        self.gate = Gate()
        self.cfg = {'stt_model': os.environ.get('CAPRI_VOICE_STT', 'small.en'), 'voice': VOICE, 'speed': SPEED, 'flow': FLOW, 'pace': PACE}
        self.last_said = (None, '', 0.0)  # (id, text, tail silence s) of the last sentence: the gap before the next
        self.stt = Stt(self.cfg['stt_model'])
        self.tts = Tts()
        self.media = Media()
        self.release_timer = None
        self.rec = None          # the pw-record process: the open capture stream
        self.rec_buf = []
        self.rec_stop_at = None
        self.cancelled = False
        self.say_q = []          # (id, text, t_recv)
        self.play_q = []         # (id, text, pcm, shapes, t_recv, synth_ms)
        self.player = None       # the pw-play process now playing
        self.playing = None      # ... and whose sentence it is
        self.hush_gen = 0
        self.cv = threading.Condition(self.lock)
        self.turns = []          # timings, last 20
        self.cur = {}
        threading.Thread(target=self._synth_loop, daemon=True).start()
        threading.Thread(target=self._play_loop, daemon=True).start()

    # -- out
    def emit(self, **ev):
        line = (json.dumps(ev) + '\n').encode()
        c = self.conn
        if c is None:
            return
        try:
            c.sendall(line)
        except OSError:
            pass

    # -- mic
    def listen_start(self):
        if self.rec is not None:
            return
        self.cur = {'t_start': now_ms()}
        cmd = ['pw-record', '--rate', str(MIC_RATE), '--channels', '1', '--format', 's16', '--raw',
               '-P', '{ application.name = "capri-voice" media.name = "capri-voice push-to-talk" }']
        if SOURCE:
            cmd += ['--target', SOURCE]
        self.rec_buf, self.rec_stop_at, self.cancelled = [], None, False
        self.rec = subprocess.Popen(cmd + ['-'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
        threading.Thread(target=self._rec_loop, args=(self.rec,), daemon=True).start()
        log('mic: capture starting', SOURCE or '(default source)')

    def _rec_loop(self, p):
        opened, last_lvl, fd = False, 0.0, p.stdout.fileno()
        while True:
            if self.rec_stop_at is not None and now_ms() >= self.rec_stop_at:
                break
            r, _, _ = select.select([fd], [], [], 0.02)
            if not r:
                if p.poll() is not None:
                    break
                continue
            chunk = os.read(fd, 3200)
            if not chunk:
                break
            if not opened:
                opened = True
                self.cur['t_mic_open'] = now_ms()
                self.emit(ev='mic-open')
                log(f"mic: open (+{self.cur['t_mic_open'] - self.cur['t_start']:.0f} ms)")
            if not self.cancelled:
                self.rec_buf.append(chunk)
            t = now_ms()
            if t - last_lvl >= 200:
                last_lvl = t
                x = np.frombuffer(chunk[:len(chunk) // 2 * 2], np.int16).astype(np.float32) / 32768.0
                self.emit(ev='level', v=round(min(1.0, float(np.sqrt(np.mean(x * x))) * 8), 3) if len(x) else 0.0)
        p.terminate()
        try:
            p.wait(1)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
        self.rec = None
        self.cur['t_mic_closed'] = now_ms()
        self.emit(ev='mic-closed')
        log('mic: closed (process gone)')
        if self.cancelled:
            self.rec_buf = []
            return
        pcm = np.frombuffer(b''.join(self.rec_buf), np.int16).astype(np.float32) / 32768.0
        self.rec_buf = []
        self._heard(pcm)

    def listen_stop(self):
        self.cur['t_keyup'] = now_ms()
        if self.rec is None:
            return
        # A short tail so the last consonant survives.
        self.rec_stop_at = now_ms() + 120

    def listen_cancel(self):
        self.cancelled = True
        self.rec_buf = []
        self.rec_stop_at = now_ms()

    def _heard(self, pcm):
        c = self.cur
        dur = len(pcm) / MIC_RATE
        # Gate on voice activity: Whisper invents short phrases from silence.
        fr = int(0.02 * MIC_RATE)
        n = len(pcm) // fr
        rms = np.sqrt(np.mean(pcm[:n * fr].reshape(n, fr) ** 2, axis=1)) if n else np.zeros(0)
        floor = float(np.percentile(rms, 20)) if n else 0.0
        voiced = float(np.sum(rms > max(0.008, floor * 3)) * 0.02)
        if voiced < 0.3:
            del pcm
            c['t_heard'] = now_ms()
            self.emit(ev='heard', text='', why="DIDN'T CATCH THAT", ms=self._ms())
            log(f'heard: nothing ({voiced:.2f} s voiced of {dur:.1f} s)')
            return
        t = now_ms()
        text = self.stt(pcm)
        del pcm  # dropped after decoding (never written anywhere)
        c['stt_ms'] = now_ms() - t
        c['t_heard'] = now_ms()
        self.emit(ev='heard', text=text, why='' if text else "DIDN'T CATCH THAT", ms=self._ms())
        log(f"heard: {len(text)} chars in {c['stt_ms']:.0f} ms from {dur:.1f} s ({voiced:.1f} s voiced)")

    def _ms(self):
        c = self.cur
        d = lambda a, b: round(c[b] - c[a]) if a in c and b in c else None
        return {'keyup_to_closed': d('t_keyup', 't_mic_closed'), 'stt': round(c['stt_ms']) if 'stt_ms' in c else None,
                'keyup_to_heard': d('t_keyup', 't_heard'), 'press_to_open': d('t_start', 't_mic_open')}

    # -- speech
    def say(self, sid, text, unprompted=False):
        with self.cv:
            if sid in self.gate.skipped or sid in self.gate.dropped:
                return
            if unprompted:
                self.gate.queued.setdefault(sid, time.monotonic())
            self.say_q.append((sid, text, now_ms(), self.hush_gen, unprompted))
            self.cv.notify_all()

    def drop(self, sid):
        with self.cv:
            self.gate.dropped.add(sid)
            self.say_q = [q for q in self.say_q if q[0] != sid]
            self.play_q = [q for q in self.play_q if q[0] != sid]
            p = self.player if self.playing == sid else None
        if p is not None:
            p.kill()
        log(f'drop {sid}')

    def skip(self, sid, why):
        """An unprompted reply stays silent from here (it is text on her side)."""
        with self.cv:
            if sid in self.gate.skipped:
                return
            self.gate.skipped.add(sid)
            self.say_q = [q for q in self.say_q if q[0] != sid]
            self.play_q = [q for q in self.play_q if q[0] != sid]
        self.emit(ev='say-skipped', id=sid, why=why)
        log(f'say {sid}: skipped ({why})')

    def hush(self):
        with self.cv:
            self.hush_gen += 1
            self.say_q.clear()
            self.play_q.clear()
            self.gate.queued.clear()
            p = self.player
            self.cv.notify_all()
        if p is not None:
            p.kill()
        self.emit(ev='hushed')
        log('hush')

    def _synth_loop(self):
        while True:
            with self.cv:
                while not self.say_q:
                    self.cv.wait()
                sid, text, t_recv, gen, unprompted = self.say_q.pop(0)
            t = now_ms()
            try:
                prev_id, prev_text, prev_tail = self.last_said
                gap = max(0.0, sentence_gap(prev_text, self.cfg['flow'], float(self.cfg['speed'])) - prev_tail) if prev_id == sid else 0.0
                pcm = self.tts(text, self.cfg['voice'], float(self.cfg['speed']), self.cfg['flow'], gap, self.cfg['pace'])
                self.last_said = (sid, text, edge_silence(pcm)[1])
            except Exception as e:
                log('tts failed:', e)
                self.emit(ev='say-end', id=sid, error=str(e))
                continue
            synth = now_ms() - t
            with self.cv:
                if gen != self.hush_gen:
                    continue
                if sid in self.gate.skipped or sid in self.gate.dropped:
                    continue
                self.play_q.append((sid, text, pcm, shapes(pcm), t_recv, synth, gen, unprompted))
                self.cv.notify_all()

    def _play_loop(self):
        while True:
            with self.cv:
                while not self.play_q:
                    self.cv.wait()
                sid, text, pcm, shp, t_recv, synth, gen, unprompted = self.play_q.pop(0)
                if gen != self.hush_gen:
                    continue
            if unprompted:
                t = now_ms()
                why, pcm = self.gate.check(sid, len(pcm) / TTS_RATE, pcm)
                self.gate.check_ms = now_ms() - t
                if why:
                    self.skip(sid, why)
                    continue
            with self.cv:
                if gen != self.hush_gen or sid in self.gate.dropped:
                    continue
                cmd = ['pw-play', '--rate', str(TTS_RATE), '--channels', '1', '--format', 's16', '--raw',
                       '-P', '{ application.name = "capri-voice" media.name = "capri-voice speech" }']
                if SINK:
                    cmd += ['--target', SINK]
                p = subprocess.Popen(cmd + ['-'], stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)
                self.player, self.playing = p, sid
            data = (np.clip(pcm, -1, 1) * 32767).astype(np.int16).tobytes()
            t0 = now_ms()
            self.emit(ev='say-start', id=sid, text=text, dur_ms=round(len(pcm) / TTS_RATE * 1000), step_ms=STEP_MS, shapes=shp,
                      ms={'queued_to_audio': round(t0 - t_recv), 'synth': round(synth)})
            log(f'say {sid}: {len(text)} chars, synth {synth:.0f} ms, recv->audio {t0 - t_recv:.0f} ms, {len(pcm) / TTS_RATE:.2f} s'
                + (f' (unprompted, gate {self.gate.check_ms:.0f} ms)' if unprompted else ''))
            # Fed from a thread (pw-play takes its input in big gulps), so an unprompted sentence
            # stops within ~0.4 s if a call starts or the screen locks under it.
            threading.Thread(target=feed, args=(p, data), daemon=True).start()
            why = None
            while True:
                try:
                    p.wait(timeout=0.35 if unprompted else None)
                    break
                except subprocess.TimeoutExpired:
                    if why is None and (why := self.gate.now_why()):
                        p.kill()
            if unprompted:
                self.gate.played(len(pcm) / TTS_RATE if why is None else (now_ms() - t0) / 1000)
            with self.cv:
                self.player, self.playing = None, None
                hushed = gen != self.hush_gen or sid in self.gate.dropped
            if why:
                self.skip(sid, why)
            elif not hushed:
                self.emit(ev='say-end', id=sid)

    # -- protocol
    def handle(self, msg):
        op = msg.get('op')
        if op == 'config':
            for k in ('voice', 'speed', 'flow', 'pace'):
                if k in msg:
                    self.cfg[k] = msg[k]
            try:
                parse_voice(self.cfg['voice'])
            except ValueError as e:
                log(f'{e}; using the default voice')
                self.cfg['voice'] = VOICE
            if self.cfg['flow'] not in FLOW_PRESETS:
                self.cfg['flow'] = FLOW
            if self.cfg['pace'] not in PACES:
                self.cfg['pace'] = PACE
            if msg.get('stt_model') and msg['stt_model'] != self.stt.name:
                self.cfg['stt_model'] = msg['stt_model']
                self.stt = Stt(msg['stt_model'])
            self.emit(ev='ready', cfg=self.cfg, features=FEATURES)
        elif op == 'listen-start':
            self.listen_start()
        elif op == 'listen-stop':
            self.listen_stop()
        elif op == 'listen-cancel':
            self.listen_cancel()
        elif op == 'say':
            self.say(msg.get('id', 0), msg.get('text', ''), bool(msg.get('unprompted')))
        elif op == 'drop':
            self.drop(msg.get('id', 0))
        elif op == 'hush':
            self.hush()
        elif op == 'media-hold':
            if self.release_timer is not None:
                self.release_timer.cancel()
                self.release_timer = None
            self.media.hold(msg.get('mode', 'pause'))
        elif op == 'media-release':
            # Other audio comes back a beat after her last word (after_ms), or now.
            if self.release_timer is not None:
                self.release_timer.cancel()
            after = float(msg.get('after_ms', 0)) / 1000.0
            if after > 0:
                self.release_timer = threading.Timer(after, self.media.release)
                self.release_timer.daemon = True
                self.release_timer.start()
            else:
                self.release_timer = None
                self.media.release()
        elif op == 'stats':
            self.emit(ev='stats', mic_open=self.rec is not None, speaking=self.player is not None, cfg=self.cfg)
        else:
            self.emit(ev='error', why=f'unknown op {op!r}')

    def serve(self):
        if os.path.exists(SOCK):
            os.remove(SOCK)
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SOCK)
        os.chmod(SOCK, 0o600)
        srv.listen(2)
        log('listening on', SOCK)
        while True:
            c, _ = srv.accept()
            old, self.conn = self.conn, c
            if old is not None:
                try:
                    old.close()
                except OSError:
                    pass
            threading.Thread(target=self._client, args=(c,), daemon=True).start()

    def _client(self, c):
        log('avatar connected')
        buf = b''
        while True:
            try:
                d = c.recv(4096)
            except OSError:
                d = b''
            if not d:
                break
            buf += d
            while b'\n' in buf:
                line, buf = buf.split(b'\n', 1)
                try:
                    self.handle(json.loads(line))
                except Exception as e:
                    log('bad message:', e)
        log('avatar gone')
        if self.conn is c:
            self.conn = None
            # Her end went away: the mic closes, she stops, other audio comes back.
            if self.rec is not None:
                self.listen_cancel()
            self.hush()
            self.media.release()


def write_wav(path, a, rate=TTS_RATE):
    import wave
    with wave.open(path, 'wb') as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes((np.clip(a, -1, 1) * 32767).astype(np.int16).tobytes())


def read_wav(path):
    import wave
    with wave.open(path, 'rb') as w:
        x = np.frombuffer(w.readframes(w.getnframes()), np.int16)
        if w.getnchannels() > 1:
            x = x.reshape(-1, w.getnchannels()).mean(1)
    return (x / 32768.0).astype(np.float32)


def selftest_gate():
    global LOCKERS
    mic = {68: {'name': 'alsa_input.x.Mic1__source', 'properties': {'device.class': 'sound'}},
           49: {'name': 'both_speakers.monitor', 'properties': {'device.class': 'monitor'}}}
    out = lambda app, src, **pr: {'source': src, 'properties': {'application.name': app, **pr}}
    assert other_capture([out('capri-voice', 68)], mic) is None, 'her own push-to-talk is not a call'
    assert other_capture([out('obs', 49), out('pavucontrol', 68, **{'media.name': 'Peak detect'})], mic) is None
    assert other_capture([out('capri-voice', 68), out('Discord', 68)], mic) == 'Discord'
    saved = LOCKERS
    LOCKERS = [open('/proc/self/comm').read().strip()]
    assert screen_locked(), 'a locker process is the lock'
    LOCKERS = ['capri-no-such-locker'[:15]]
    assert not screen_locked()
    LOCKERS = saved
    assert 'betterlockscree' in LOCKERS, 'comm is cut to 15 chars'

    class Quiet(Gate):
        why = None

        def now_why(self):
            return self.why
    g = Quiet()
    g.cache['dnd'] = (time.monotonic() + 1e6, False)
    one = np.ones(int(4 * TTS_RATE), np.float32)
    assert g.check(1, 4.0, one)[0] is None and g.check(1, 4.0, one)[0] is None
    assert g.check(1, 4.0, one)[0] == 'reply cap', 'one reply: 10 s at most'
    long = np.ones(int(12 * TTS_RATE), np.float32)
    why, cut = g.check(2, 12.0, long)
    assert why is None and len(cut) == int(CAP_S * TTS_RATE) and cut[-1] == 0.0, 'a first sentence over the cap is cut, faded'
    g.played(8.0)
    g.played(10.0)
    assert g.check(3, 4.0, one)[0] == 'speech budget', 'at most 20 s in any 60 s'
    g.heard = [(time.monotonic() - 61, 10.0)]
    assert g.check(3, 4.0, one)[0] is None, 'the window rolls'
    g.queued[4] = time.monotonic() - STALE_S - 1
    assert g.check(4, 1.0, one)[0] == 'too late'
    g.why = 'call (Discord)'
    assert g.check(5, 1.0, one)[0] == 'call (Discord)'
    g.why = None
    g.cache['dnd'] = (time.monotonic() + 1e6, True)
    assert g.check(6, 1.0, one)[0] == 'do not disturb'


def selftest():
    """Checks that need no audio device: the voice string, the markup, the gaps; with the models
    present, that the patched graph with neutral inputs speaks exactly like the stock one."""
    v = parse_voice(W3)
    assert v['p'] and abs(v['shift'] - 2.93) < 1e-9 and v['clean'] and not v['glitch'], v
    assert parse_voice(VOICE)['shift'] == 4.93 and parse_voice(VOICE)['t'] == v['t'] and parse_voice(VOICE)['p'] == v['p']
    assert PACE in PACES and abs(1 / SPEED - 0.77) < 1e-4, 'the default is his pick: rubberband -t 0.77'
    assert parse_voice('af_heart') == {'t': 'af_heart', 'p': None, 'shift': 0.0, 'clean': False, 'glitch': False}
    assert parse_voice('af_bella:0.6,af_nicole:0.4+glitch')['glitch']
    assert parse_voice('af_bella|bf_lily@-1.5')['shift'] == -1.5
    for bad in ('', 'af heart', 'af_heart@', 'af_heart+loud', 'af_heart||bf_lily'):
        try:
            parse_voice(bad)
            raise AssertionError(f'accepted {bad!r}')
        except ValueError:
            pass
    names, ws = blend_weights('af_heart:0.84,af_jessica:0.56,af_sarah:-0.4')
    assert names == ['af_heart', 'af_jessica', 'af_sarah'] and abs(ws.sum() - 1) < 1e-9 and ws[2] < 0
    assert strip_markup("I'm *not* signing that.") == "I'm not signing that."
    assert strip_markup('a * b and *two words* and **bold**') == 'a  b and two words and bold'
    assert sentence_gap('Fine.', 'off') == 0.0 and sentence_gap('Fine.', 'emphasis') == SENT_GAP
    assert all(WH_RE.match(q) for q in ('Why?', 'So why did you?', 'Okay, what now?', 'and how')) and not any(
        WH_RE.match(q) for q in ('Wait, you want me to?', 'Did you push?', 'Whoever did it?'))
    assert abs(sentence_gap('Fine.', 'emphasis', 1.3) - SENT_GAP / 1.3) < 1e-9
    g = sentence_gap('Fine.', 'full')
    assert 0.32 <= g <= 0.54 and g == sentence_gap('Fine.', 'full'), 'gaps: in range and the same text gives the same gap'
    assert 0.40 <= sentence_gap('Really?', 'full') <= 0.62
    print('selftest: parsing ok')
    selftest_gate()
    print('selftest: unprompted gate ok (call, lock, budget, cap, too late)')
    if not os.path.exists(f'{MODELS}/kokoro-v1.0.int8.onnx'):
        print('selftest: no models, skipping the graph checks')
        return
    tts = Tts()
    assert tts.flow, 'the flow patch did not load'
    k, f = tts.k, tts.flow
    st = tts.style('af_heart')
    ph = f.known(k.tokenizer.phonemize("Lynx wants a shell, and I'm not signing that.", 'en-us'))
    tok = np.array([[0, *[f.vocab[c] for c in ph], 0]], np.int64)
    s1 = np.asarray(st[len(ph) - 1], np.float32).reshape(1, 256)
    sp = np.array([1.0], np.float32)
    stock = k.sess.run(None, {'tokens': tok, 'style': s1, 'speed': sp})[0].ravel()
    d = np.maximum(np.round(f.pred.run(None, {'tokens': tok, 'style': s1, 'speed': sp})[0].ravel()), 1).astype(np.int64)
    n = int(2 * d.sum())
    same = f.synth.run(None, {'tokens': tok, 'style': s1, 'speed': sp, 'dur_in': d,
                              'f0_mul': np.ones((1, 1, n), np.float32), 'n_add': np.zeros((1, 1, n), np.float32)})[0].ravel()
    assert len(same) == len(stock) == d.sum() * FLOW_HOP, (len(same), len(stock), d.sum())
    assert np.abs(same - stock).max() < 1e-3, 'neutral taps must not change the audio'
    ph2, spans = f.phonemes("I'm *not* signing that, choom.", 'en-us')
    assert len(spans) == 1 and 'ɑ' in ph2[spans[0][0]:spans[0][1]], (ph2, spans)
    plain_ = f("I'm not signing that, choom.", st, 1.0, {}, 'en-us')[0]
    marked = f("I'm *not* signing that, choom.", st, 1.0, FLOW_PRESETS['full'], 'en-us')[0]
    assert len(marked) > len(plain_), 'stress and pauses make the sentence longer'
    # speed scales the time as asked (no 25 ms rounding steps): 1.38 vs 1.30 is 6 % shorter, not 18 %
    lens = {sp_: len(f("Spike pushed the reader fix eleven minutes ago, and nobody noticed.", st, sp_, {}, 'en-us')[0]) for sp_ in (1.0, 1.30, 1.38)}
    assert abs(lens[1.30] / lens[1.38] - 1.38 / 1.30) < 0.03 and 1.15 < lens[1.0] / lens[1.30] < 1.35, lens   # (every token keeps >= 1 frame)
    # same text, same audio
    E = {**FLOW_PRESETS[FLOW], 'heard_shift': parse_voice(VOICE)['shift']}
    SP = 1.0 if PACE == 'stretch' else SPEED                    # Kokoro's own speed under the default pace
    a1 = f('Spike pushed the reader fix *eleven* minutes ago.', st, SP, E, 'en-us')[0]
    assert np.array_equal(a1, f('Spike pushed the reader fix *eleven* minutes ago.', st, SP, E, 'en-us')[0])
    # the stressed word: a local, capped bump; never past 400 Hz as heard; none on a first word
    w = f.last['words'][0]
    assert 0.5 <= f.last['bumps'][0] <= E['emph_st'] and w['peak_hz'] * 2 ** ((f.last['bumps'][0] + E['heard_shift']) / 12) <= 400.5, f.last
    f('*Bold* move, choom.', st, SP, E, 'en-us')
    assert f.last['bumps'] == [0.0], f.last
    # a yes/no question keeps its rise over the stressed word; a wh-question is left alone
    f('Wait, you want me to delete the *whole* branch?', st, SP, E, 'en-us')
    assert f.last.get('lift', 0) > 0 and f.last['bumps'][0] <= 2.0, f.last
    f('So why did you delete the *whole* branch?', st, SP, E, 'en-us')
    assert 'lift' not in f.last, f.last
    # pace: "stretch" scales the time by 1/speed in the pitch pass, "model" runs Kokoro faster
    if tts.rubberband:
        n1 = len(tts('Need your okay on something.', VOICE, 1.0, FLOW))
        ns = len(tts('Need your okay on something.', VOICE, SPEED, FLOW, pace='stretch'))
        nm = len(tts('Need your okay on something.', VOICE, SPEED, FLOW, pace='model'))
        assert abs(n1 / ns - SPEED) < 0.02 and nm < n1 * 0.9, (n1, ns, nm)
    print('selftest: flow ok (neutral patch == stock, stress spans exact, speed linear, local stress, question rise, pace)')


def main():
    args = sys.argv[1:]
    if args[:1] == ['--render']:
        # --render TEXT --out F.wav [--voice V] [--speed S] [--flow emphasis|pauses|full|off] [--pace stretch|model]
        # A sample (her TTS, never the mic). Sentences are split by " || ", as the avatar sends them;
        # " ||| " starts a new reply (REPLY_GAP heard, at speed 1).
        text = args[1]
        opt = dict(zip(args[2::2], args[3::2]))
        tts = Tts(opt.get('--model', 'kokoro-v1.0.int8.onnx'))
        voice, flow, speed, pace = opt.get('--voice', VOICE), opt.get('--flow', FLOW), float(opt.get('--speed', SPEED)), opt.get('--pace', PACE)
        parts, prev = [], ''
        for r, reply in enumerate(text.split(' ||| ')):
            for i, sent in enumerate(reply.split(' || ')):
                t = now_ms()
                gap = max(0.0, sentence_gap(prev, flow, speed) - edge_silence(parts[-1])[1]) if i else 0.0
                a = tts(sent, voice, speed, flow, gap, pace)
                log(f'render: {now_ms() - t:.0f} ms for {len(a) / TTS_RATE:.2f} s: {strip_markup(sent)!r}')
                if r and not i:
                    g = max(0.0, REPLY_GAP / speed - edge_silence(parts[-1])[1] - edge_silence(a)[0])
                    parts.append(np.zeros(int(g * TTS_RATE), np.float32))
                elif parts and not FLOW_PRESETS.get(flow):
                    parts.append(np.zeros(int(0.45 * TTS_RATE), np.float32))
                parts.append(a)
                prev = sent
        out = np.concatenate(parts)
        write_wav(opt['--out'], out)
        print(opt['--out'], f'{len(out) / TTS_RATE:.1f} s')
        return
    if args[:1] == ['--selftest']:
        selftest()
        return
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    v = Voice()
    try:
        v.serve()
    finally:
        v.media.release()
        if v.rec is not None:
            v.rec.kill()


if __name__ == '__main__':
    main()
