def selftest_endpoint():
    def run(probs, **kw):
        e = Endpointer(**kw)
        for i, q in enumerate(probs):
            why = e.feed(q)
            if why:
                return why, round((i + 1) * FRAME_S, 2)
        return None, None
    speech, sil = [0.9] * 40, [0.05]                       # 1.28 s of speech
    assert run(speech + sil * 40) == ('silence', round((40 + 32) * FRAME_S, 2)), 'ends 1.0 s after the speech (32 frames)'
    assert run([0.9] * 10 + sil * 60)[0] == 'silence' and run([0.9] * 10 + sil * 60)[1] > (10 + 46) * FRAME_S - 0.01, 'under 1 s of speech: x1.5'
    pause = speech + sil * 28 + speech + sil * 40         # a 0.9 s pause mid-sentence: not the end
    assert run(pause)[1] > (40 + 28 + 40) * FRAME_S, 'a 0.9 s pause is not the end'
    assert run(speech + [0.4] * 50 + sil * 40)[1] > (40 + 50) * FRAME_S, 'hysteresis: 0.35..0.5 is still speech'
    assert run(speech + sil * 5 + [0.40] * 60) == ('silence', round((40 + 32) * FRAME_S, 2)), 'out of speech, the band counts as pause'
    assert run(sil * 300) == ('nothing', round(250 * FRAME_S, 2)), '8 s of nothing closes it'
    assert run([0.9] * 3 + sil * 300)[0] == 'nothing', 'a blip is not a turn'
    assert run([0.9] * 2000)[0] == 'cap', 'the cap sends'
    assert run(speech + sil * 80, silence_s=2.0) == ('silence', round((40 + 63) * FRAME_S, 2))
    e = Endpointer()
    for q in [0.9] * 50 + sil * 10:          # 1.6 s of speech: the decode takes up to ~0.9 s
        e.feed(q)
    assert abs(e.draft_at() - 0.2) < 1e-6 and abs(Endpointer(silence_s=2.0).draft_at() - 2.1) < 1e-6
    e.extra = DANGLE_S
    assert all(e.feed(0.05) is None for _ in range(60)) and e.feed(0.9) is None and e.extra == 0.0, 'held on; speech resets it'
    for t in ('I want to check the build and', 'Send the note to.', 'Okay, so first,', 'Well…', 'It broke because', 'um'):
        assert dangles(t), t
    for t in ('Ship it.', "What's spike doing right now?", 'Thanks.', 'Read it again', 'Stop.'):
        assert not dangles(t), t


