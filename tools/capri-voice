# ---- the wake word ("hey capri"): on by default ([voice] wake_word = false turns it off)
#
# Stage 1: openWakeWord's front end (its v0.5.1 melspectrogram + embedding onnx; its README: code
# Apache-2.0, released models CC BY-NC-SA 4.0, so personal use; SHA-pinned), streamed: every 80 ms the mel of the last 110 ms, one 96-number embedding
# from the last 76 mel frames; our head (1536 -> 64 -> 1, numpy) scores the last 16 embeddings (~2 s).
# Two hops in a row over the threshold = a candidate. Stage 2: the loaded Whisper decodes the last
# 2.8 s, 0.3 s after the candidate; it must say a hey-like word, then capri-like, loosely spelled ("Copry",
# "Haikapri"), never "Capricorn". Trained on stock
# TTS voices only (Kokoro packs and blends, espeak-ng): no recording of anyone. Detection on his
# voice is unmeasured; wake_sensitivity is the remedy.
WAKE_FILES = {'melspectrogram.onnx': 'ba2b0e0f8b7b875369a2c89cb13360ff53bac436f2895cced9f479fa65eb176f',
              'embedding_model.onnx': '70d164290c1d095d1d4ee149bc5e00543250a7316b59f31d056cff7bd3075c1f',
              'hey-capri-v1.npz': '68ccb1ca224258e7be4383df7b8f6a6e11d4051ce13085aca9ecc0e63f1c43ab'}   # tools/wake (its manifest inside)
WAKE_HOP, WAKE_CTX = 1280, 480                     # 80 ms hops; each mel call sees 30 ms before its hop
WAKE_RING_S = 2.5                                  # all the idle mic is kept: 2.5 s, in RAM
WAKE_REFRACTORY_S = 2.0
WAKE_VERIFY_N, WAKE_VERIFY_S, WAKE_PAUSE_S = 12, 600.0, 600.0   # 12 Whisper checks in 10 min, else 10 min off
if TEST and os.environ.get('CAPRI_VOICE_TEST_WAKE_CHECKS'):
    WAKE_VERIFY_N = int(os.environ['CAPRI_VOICE_TEST_WAKE_CHECKS'])   # tests only: a long e2e run makes more than 12
WAKE_WAIT_S, WAKE_TURN_S = 5.0, 30.0               # after the phrase: speech within 5 s; a turn is sent at 30 s
WAKE_SECOND_S = 10.0                               # a rejected candidate's second look: his turn, at most this long
WAKE_SECOND = os.environ.get('CAPRI_VOICE_WAKE_SECOND', '1') == '1'
WAKE_HEY = {'hey', 'hay', 'hi', 'hei', 'hej', 'heh', 'hai', 'he', 'eh', 'ay', 'a', 'hello', 'hallo', 'halle', 'haley', 'hailey', 'heli'}
# "Capri" as Whisper spells what it heard: Capri, Copry, Kapree, "cup pray", "kah preen"; never Capricorn, Capra, caprese
_CAPRI = r"(?:k|c|ck|g|q)[aeiouy]{1,2}[rl]?h?p{1,2}r(?:[eiy]{1,3}|ay)(?:n|ne)?"
WAKE_CAPRI = re.compile(_CAPRI)
WAKE_FUSED = re.compile(r"h[aeiy]{1,3}(?:l[aeiy]{0,2})?" + _CAPRI)     # "Haikapri", "Hekopri", "Heikah Preen", "Helicapri"
WAKE_HF = {"let's talk", 'lets talk', "let's chat", 'lets chat', 'hands free', 'handsfree'}


def wake_find(text):
    """Where "hey capri" ends in Whisper's words (an offset into text), or None: a hey-like word, then a capri-like
    one (one word or two), or the two fused ("Haikapri")."""
    text = unicodedata.normalize('NFKD', text).encode('ascii', 'ignore').decode()      # "Caprín" -> "Caprin"
    toks = [(m.group().lower(), m.end()) for m in re.finditer(r"[A-Za-z']+", text)]
    w = [t[:-2] if t.endswith("'s") else t.strip("'") for t, _ in toks]
    for i in range(len(w)):
        for k in (1, 2):
            if w[i] in WAKE_HEY and i + 1 + k <= len(w) and WAKE_CAPRI.fullmatch(''.join(w[i + 1:i + 1 + k])):
                return toks[i + k][1]
            if i + k <= len(w) and WAKE_FUSED.fullmatch(''.join(w[i:i + k])):
                return toks[i + k - 1][1]
    return None


def wake_says(text):
    """Whisper's words say "hey capri"."""
    return wake_find(text) is not None


def wake_rest(text):
    """What he said after "hey capri" (the phrase cut), and whether it asks for hands-free."""
    text = unicodedata.normalize('NFKD', text).encode('ascii', 'ignore').decode()
    e = wake_find(text)
    rest = text[e:].lstrip(" ,.!?:;-") if e is not None else text.strip()
    rest = rest[:1].upper() + rest[1:]
    words = re.sub(r"[^a-z' ]", ' ', rest.lower().replace('-', ' ')).split()
    while words and words[-1] in ('please', 'capri'):
        words.pop()
    return rest, ' '.join(words) in WAKE_HF


WAKE_HF_LEAD_S = 1.8      # hands-free from the phrase: this much of the ring before the fire (stage 1 fires near the end of "Capri")
def wake_first(text):
    """The first utterance of a hands-free that "hey capri" began: what is sent (the phrase cut), or '' when it is the
    phrase alone or "let's talk" (it is hands-free already)."""
    rest, hf = wake_rest(text)
    return '' if hf else rest


WAKE_STT_FLOOR = int(os.environ.get('CAPRI_VOICE_WAKE_CTX', '256'))   # Whisper's window for the check: 5.1 s for 2.8 s of audio (see the PR)
WAKE_CHECK_DELAY_S = float(os.environ.get('CAPRI_VOICE_WAKE_DELAY', '0.3'))   # the check waits this much more audio: stage 1
                                                                          # often fires inside "-pri", and a cut word fails


# The sound-alike filter (WakeForced): a candidate passes when Whisper's forced log P("Hey Capri" + a word end) > T_MIN
# and it beats the best sound-alike by > MARGIN_MIN. Fitted on stock TTS voices only (Kokoro packs, espeak-ng; the
# held-out voices and his own takes never fitted it). A personal file (wake_personal(), local, optional) may move both.
WAKE_T_MIN, WAKE_MARGIN_MIN = -10.0, 0.0
WAKE_SECOND_MARGIN = -8.0         # a reject gets the second look when its margin is over this: his far and casual takes are
                                  # all over -6 (his own sound-alikes "hey Cabby", "hey copy", "hey carry" are under -8)
WAKE_LOOK_T_MIN, WAKE_LOOK_MARGIN_MIN = -10.0, -3.0   # the second look's filter, on the decode of his whole turn: there
                                  # Whisper reads the phrase better (the request after it), and his far takes land at -0.5..-2.8
WAKE_CHECK_S = 2.8                # the check decodes this much: the ring (2.5 s) and the 0.3 s after the candidate
WAKE_PERSONAL = os.path.join(os.path.dirname(MODELS), 'wake-personal', 'personal.npz')
WAKE_SPEECH_MIN = 3                # a candidate needs >= 3 Silero speech frames (~0.1 s) in the last second: music, a door, a cough don't


def wake_personal(path=None):
    """His personal layer, if he made one (tools/capri-wake-tune, from his own takes; local, never committed): a dict
    with 'templates' (n x 1536, normalised stage-1 windows of his "hey capri") and 'tau' (a hop is his phrase when its
    best cosine to them is >= tau), and/or the filter's 't_min' / 'margin_min'. None when absent or not valid."""
    try:
        z = np.load(path or WAKE_PERSONAL, allow_pickle=False)
        out = {k: float(z[k]) for k in ('t_min', 'margin_min', 'tau') if k in z.files}
        if 'templates' in z.files:
            t = np.asarray(z['templates'], np.float32)
            if t.ndim != 2 or t.shape[1] != 1536 or not 1 <= len(t) <= 4000 or not np.isfinite(t).all() or not 0.3 <= out.get('tau', 0) <= 0.99:
                raise ValueError('templates / tau')
            out['templates'] = t
        if not out or not all(-40.0 <= out[k] <= 10.0 for k in ('t_min', 'margin_min') if k in out):
            raise ValueError('nothing usable')
        return out
    except FileNotFoundError:
        pass
    except Exception as e:
        log(f'wake: the personal file did not load ({e}); not used')
    return None


def wake_accept(says, tm, personal=None, look=False):
    """The check's verdict: the filter's (T, margin) when it is on, else Whisper's text ("says hey capri"). The second look
    (look=True) needs both: the words of his whole turn say "hey capri" and the filter passes at the look's own thresholds."""
    if tm is None:
        return says
    if look:
        return says and tm[0] > WAKE_LOOK_T_MIN and tm[1] > WAKE_LOOK_MARGIN_MIN
    p = personal or {}
    return tm[0] > p.get('t_min', WAKE_T_MIN) and tm[1] > p.get('margin_min', WAKE_MARGIN_MIN)


def wake_check_pcm(pre, post):
    """The audio the check decodes: the last WAKE_CHECK_S of the ring and what came after the candidate (s16 bytes)."""
    b = (pre + bytes(post))[-int(WAKE_CHECK_S * MIC_RATE) * 2:]
    return np.frombuffer(b[:len(b) // 2 * 2], np.int16).astype(np.float32) / 32768.0


def wake_text(stt, pcm, floor=None):
    """The Whisper check of a candidate: no recognition prompt (it would lean toward "Capri"), a few tokens."""
    return stt(pcm, None, prompt=None, floor=floor or WAKE_STT_FLOOR, tokens=12)


class WakeEar:
    """Stage 1, loaded only when the wake word is turned on."""

    def __init__(self, d):
        import onnxruntime as ort
        so = ort.SessionOptions()
        so.intra_op_num_threads = so.inter_op_num_threads = 1
        self.mel = ort.InferenceSession(f'{d}/melspectrogram.onnx', so, providers=['CPUExecutionProvider'])
        self.emb = ort.InferenceSession(f'{d}/embedding_model.onnx', so, providers=['CPUExecutionProvider'])
        self.mi, self.ei = self.mel.get_inputs()[0].name, self.emb.get_inputs()[0].name
        h = np.load(f'{d}/hey-capri-v1.npz', allow_pickle=False)
        self.mu, self.sd, self.W1, self.b1, self.W2, self.b2 = (h[k].astype(np.float32) for k in ('mu', 'sd', 'W1', 'b1', 'W2', 'b2'))
        self.thresholds = h['thresholds'].astype(np.float32)        # wake_sensitivity 0.1 .. 0.9

    @staticmethod
    def load(d=None):
        """(WakeEar, None) or (None, why): every file there and the expected one."""
        import hashlib
        d = d or MODELS
        for f, sha in WAKE_FILES.items():
            path = f'{d}/{f}'
            if not os.path.exists(path):
                return None, f'no {f} (capri-voice-setup)'
            if sha and hashlib.sha256(open(path, 'rb').read()).hexdigest() != sha:
                return None, f'{f} is not the expected file'
        try:
            return WakeEar(d), None
        except Exception as e:
            return None, f'the wake models did not load ({e})'

    def threshold(self, sensitivity):
        i = int(round((float(np.clip(sensitivity, 0.1, 0.9)) - 0.1) * 10))
        return float(self.thresholds[i])

    def mels(self, x):
        return self.mel.run(None, {self.mi: x.astype(np.float32)[None, :]})[0].reshape(-1, 32) / 10 + 2

    def score(self, e16):
        x = (e16.reshape(1, -1) - self.mu) / self.sd
        h = np.maximum(0, x @ self.W1 + self.b1)
        return float(1 / (1 + np.exp(-(h @ self.W2 + self.b2)[0, 0])))

    def personal_sim(self, e16, templates):
        """The best cosine of this window (normalised as the head does) to his templates."""
        z = (e16.reshape(-1) - self.mu.reshape(-1)) / self.sd.reshape(-1)
        return float((templates @ (z / (np.linalg.norm(z) + 1e-9))).max())

    class Stream:
        """Incremental: push int16 samples, get (head score, personal cosine) per 80 ms hop (0 until 16 embeddings;
        the cosine is 0 without a personal layer)."""

        def __init__(self, ear, templates=None):
            self.ear, self.raw, self.pend = ear, np.zeros(WAKE_CTX, np.int16), np.zeros(0, np.int16)
            self.melbuf, self.embs = np.ones((76, 32), np.float32), collections.deque(maxlen=16)
            self.templates = templates

        def push(self, x):
            self.pend = np.concatenate([self.pend, x])
            out = []
            while len(self.pend) >= WAKE_HOP:
                h, self.pend = self.pend[:WAKE_HOP], self.pend[WAKE_HOP:]
                self.raw = np.concatenate([self.raw, h])[-(WAKE_HOP + WAKE_CTX):]
                self.melbuf = np.concatenate([self.melbuf, self.ear.mels(self.raw)])[-76:]
                e = self.ear.emb.run(None, {self.ear.ei: self.melbuf[None, :, :, None]})[0].reshape(96)
                self.embs.append(e)
                if len(self.embs) < 16:
                    out.append((0.0, 0.0))
                    continue
                e16 = np.stack(self.embs)
                out.append((self.ear.score(e16), self.ear.personal_sim(e16, self.templates) if self.templates is not None else 0.0))
            return out


class WakeForced:
    """The sound-alike filter: Whisper's own log-probability that the check window starts "Hey Capri" (then a word end),
    and how far that beats the best sound-alike ("Hey Cappy", "Hey caprese", "Hey Capricorn", ...), scored on the
    encoder pass the check already made (about 20 one-token decoder calls, ~80 ms on small.en). pywhispercpp binds
    whisper_decode/whisper_get_logits for one int / one float only, so they are called through ctypes on the same loaded
    libwhisper, with the context pointer read out of pywhispercpp's holder. load() checks that pointer (vocabulary size,
    end token, the tokenizer) and returns None on any doubt: the check is then Whisper's text alone, as before."""

    HEYS = (' Hey', ' Hey,', ' Hi')
    RIVALS = (' Cappy', ' Capra', ' caprese', ' Caprese', ' cabbie', ' Cabby', ' Carrie', ' Kerry', ' copy', ' Capricorn', ' capricious',
              ' Capris', ' Caprice', ' Cupra', ' Cathy', ' Katie', ' Corey', ' coffee', ' Kafka', ' Gary', ' carry', ' Caitlin', ' Cali',
              ' Carly', ' crappy', ' happy')

    def __init__(self, model, threads):
        import ctypes, glob
        import _pywhispercpp as pw
        self.ct, self.threads = ctypes, threads
        d = os.path.dirname(pw.__file__)
        libs = sorted(glob.glob(f'{d}/pywhispercpp.libs/libwhisper*.so*')) or sorted(glob.glob(f'{d}/libwhisper.so*'))
        if WIN:   # its wheel's DLL, beside the module (whisper-<hash>.dll, read off the 1.5.1 wheel)
            libs = sorted(glob.glob(f'{d}/pywhispercpp.libs/whisper*.dll')) or sorted(glob.glob(f'{d}/whisper*.dll'))
        L = self.L = ctypes.CDLL(libs[0])
        # pybind11's instance: PyObject_HEAD (16 bytes on a GIL build), then the value pointer, then the holder (a
        # unique_ptr: the same pointer). The value is pywhispercpp's wrapper, whose first field is the whisper_context*.
        import sysconfig
        if sysconfig.get_config_var('Py_GIL_DISABLED') or ctypes.sizeof(ctypes.c_void_p) != 8:
            raise RuntimeError('not a 64-bit GIL build')
        value = ctypes.c_void_p.from_address(id(model._ctx) + 16).value
        if not value or value % 8 or value != ctypes.c_void_p.from_address(id(model._ctx) + 24).value:
            raise RuntimeError("pywhispercpp's object is not laid out as expected")
        self.ctx = ctypes.c_void_p.from_address(value).value
        if not self.ctx or self.ctx % 8:
            raise RuntimeError("pywhispercpp's object is not laid out as expected")
        V, I = ctypes.c_void_p, ctypes.c_int
        for f, a, r in (('whisper_n_vocab', [V], I), ('whisper_token_eot', [V], I), ('whisper_token_sot', [V], I), ('whisper_token_not', [V], I),
                        ('whisper_decode', [V, ctypes.POINTER(I), I, I, I], I), ('whisper_get_logits', [V], ctypes.POINTER(ctypes.c_float)),
                        ('whisper_tokenize', [V, ctypes.c_char_p, ctypes.POINTER(I), I], I), ('whisper_token_to_str', [V, I], ctypes.c_char_p)):
            getattr(L, f).argtypes, getattr(L, f).restype = a, r
        self.nv = L.whisper_n_vocab(self.ctx)
        if self.nv != pw.whisper_n_vocab(model._ctx) or L.whisper_token_eot(self.ctx) != pw.whisper_token_eot(model._ctx):
            raise RuntimeError('not the context pywhispercpp holds')
        self.sot, self.nt, self.eot = L.whisper_token_sot(self.ctx), L.whisper_token_not(self.ctx), L.whisper_token_eot(self.ctx)
        t = self.tok(' Hey Capri')
        if len(t) < 3 or ''.join(pw.whisper_token_to_str(model._ctx, x) for x in t) != ' Hey Capri':
            raise RuntimeError('tokenizer')
        self.bound = np.zeros(self.nv, bool)        # a word ends here: the next token starts a word, is punctuation, or the end
        for t in range(self.eot):
            b = L.whisper_token_to_str(self.ctx, t)
            self.bound[t] = bool(b) and b[:1] in (b' ', b',', b'.', b'!', b'?', b';', b':', b'-')
        self.bound[self.eot] = True
        self.seqs, self.ends, tg = {}, set(), []
        for h in self.HEYS:
            n = 'T' + h; self.seqs[n] = self.tok(h + ' Capri'); self.ends.add(n); tg.append(self.seqs[n])
        for r in self.RIVALS:                          # a rival that is a prefix of the phrase ("Hey Cap") is none
            t = self.tok(' Hey' + r)
            if not any(x[:len(t)] == t for x in tg):
                self.seqs['R' + r] = t

    @staticmethod
    def load(model, threads):
        try:
            return WakeForced(model, threads), None
        except Exception as e:
            return None, f'the sound-alike filter is off ({e}): the check reads Whisper\'s text alone'

    def tok(self, s):
        a = (self.ct.c_int * 64)()
        n = self.L.whisper_tokenize(self.ctx, s.encode(), a, 64)
        return list(a[:max(0, n)])

    def _logp(self, rows):
        x = np.ctypeslib.as_array(self.L.whisper_get_logits(self.ctx), shape=(rows, self.nv))[-1].astype(np.float64)
        m = x.max()
        return x - (m + np.log(np.exp(x - m).sum()))

    def __call__(self):
        """(T, margin) on the audio of the last whisper_full: T = log P("Hey Capri" + a word end), the best of " Hey",
        " Hey,", " Hi"; margin = log P(" Hey Capri" + end) - max log P(" Hey <rival>"). Call it under the stt lock,
        right after the check's decode."""
        a = (self.ct.c_int * 2)(self.sot, self.nt)
        if self.L.whisper_decode(self.ctx, a, 2, 0, self.threads) != 0:
            raise RuntimeError('whisper_decode')
        cache = {(): self._logp(2)}
        for node in sorted({tuple(t[:k]) for n, t in self.seqs.items() for k in range(1, len(t) + (n in self.ends))}):
            x = (self.ct.c_int * 1)(node[-1])        # sorted: each node right after its ancestors, so the KV cache holds its path
            if self.L.whisper_decode(self.ctx, x, 1, 1 + len(node), self.threads) != 0:
                raise RuntimeError('whisper_decode')
            cache[node] = self._logp(1)
        lp = {}
        for n, t in self.seqs.items():
            lp[n] = sum(cache[tuple(t[:k])][t[k]] for k in range(len(t)))
            if n in self.ends:
                lp[n] += float(np.log(np.exp(cache[tuple(t)][self.bound]).sum()))
        T = max(v for n, v in lp.items() if n[0] == 'T')
        return float(T), float(lp['T Hey'] - max(v for n, v in lp.items() if n[0] == 'R'))


class Vad:
    """Silero VAD v5 on onnxruntime (CPU, one thread): a speech probability per 32 ms frame."""

    def __init__(self, path):
        import onnxruntime as ort
        so = ort.SessionOptions()
        so.intra_op_num_threads = so.inter_op_num_threads = 1
        self.s = ort.InferenceSession(path, so, providers=['CPUExecutionProvider'])
        self.sr = np.array(MIC_RATE, np.int64)
        self.reset()

    @staticmethod
    def load():
        path = f'{MODELS}/{VAD_FILE}'
        if not os.path.exists(path):
            log(f'vad: no {VAD_FILE}: the energy gate (run tools/capri-voice-setup)')
            return None
        import hashlib
        if hashlib.sha256(open(path, 'rb').read()).hexdigest() != VAD_SHA:
            log(f'vad: {VAD_FILE} is not the expected file: the energy gate')
            return None
        try:
            v = Vad(path)
            v(np.zeros(VAD_FRAME, np.float32))   # a wrong input name fails here, not mid-capture
            v.reset()
            return v
        except Exception as e:
            log(f'vad: {VAD_FILE} did not load ({e}): the energy gate')
            return None

    def reset(self):
        self.state = np.zeros((2, 1, 128), np.float32)
        self.ctx = np.zeros(VAD_CTX, np.float32)

    def __call__(self, frame):
        x = np.concatenate([self.ctx, frame])[None, :].astype(np.float32)
        out, self.state = self.s.run(None, {'input': x, 'state': self.state, 'sr': self.sr})
        self.ctx = frame[-VAD_CTX:]
        return float(out[0, 0])

    def probs(self, pcm):
        self.reset()
        return [self(pcm[i:i + VAD_FRAME]) for i in range(0, len(pcm) - VAD_FRAME + 1, VAD_FRAME)]


class VadStream:
    """The capture's s16 bytes as they come, into frame probabilities (frame k = samples k*512..)."""

    def __init__(self, vad):
        self.vad, self.buf, self.p = vad, b'', []
        vad.reset()

    def feed(self, chunk):
        self.buf += chunk
        n = len(self.buf) // (2 * VAD_FRAME) * 2 * VAD_FRAME
        if n:
            x = np.frombuffer(self.buf[:n], np.int16).astype(np.float32) / 32768.0
            self.buf = self.buf[n:]
            for i in range(0, len(x), VAD_FRAME):
                self.p.append(self.vad(x[i:i + VAD_FRAME]))


class Endpointer:
    """Where a toggled turn ends, frame by frame (32 ms of audio each): after `silence_s` of silence
    once he has spoken (x1.5 while he has under 1 s of speech: a short start is often a breath), at
    `max_s` (sent), or 'nothing' when no speech came in `wait_s`."""

    def __init__(self, silence_s=1.0, max_s=TOGGLE_MAX_S, wait_s=TOGGLE_WAIT_S, min_frames=MIN_FRAMES['toggle']):
        self.silence_s, self.max_s, self.wait_s, self.min_frames = silence_s, max_s, wait_s, min_frames
        self.n = self.speech = self.trail = 0
        self.in_speech = False   # hysteresis: on at p >= .50, off under .35; a frame between keeps it
        self.extra = 0.0         # more silence asked for: the words so far end on "and", "the", ","...

    def base(self):
        return self.silence_s * (1.5 if self.speech * FRAME_S < 1.0 else 1.0)

    def draft_at(self):
        """Trailing silence (s) at which a draft decode starts, so it is done when the pause is."""
        return max(0.2, self.base() - 0.9)      # Whisper takes 0.65-0.9 s here (its window is never under 10 s)

    def feed(self, p):
        self.n += 1
        if p >= SPEECH_P:
            self.speech += 1
            self.in_speech = True
            self.extra = 0.0
        elif p < SILENCE_P:
            self.in_speech = False
        # Out of speech every frame counts toward the pause, the in-between band too: a far voice
        # or a TV hovering at p .35-.50 after he stopped doesn't hold the mic open.
        self.trail = 0 if self.in_speech else self.trail + 1
        t = self.n * FRAME_S
        need = self.base() + self.extra
        if self.speech >= self.min_frames:
            if self.trail * FRAME_S >= need:
                return 'silence'
        elif t >= self.wait_s and (self.speech == 0 or self.trail * FRAME_S >= need):
            return 'nothing'
        if t >= self.max_s:
            return 'cap'
        return None


DANGLE_S = 1.5                 # more silence after words that dangle
DANGLING = set('''and but or so because cause if then that which who when while with to of for the a an my your his
her its their this is are was like about on in at from into um uh er hmm well also plus maybe'''.split())


def dangles(text):
    """The words so far stop mid-thought: a dangling last word, or a comma, dash or ellipsis."""
    t = text.strip()
    if re.search(r'(,|…|\.\.\.|-|—)$', t):
        return True
    w = re.sub(r'[^a-z\' ]', ' ', t.lower()).split()
    return bool(w) and w[-1] in DANGLING


def speech_span(probs, mode='hold'):
    """(first, last, frames) of the speech in a clip, or None if it is not speech enough."""
    sp = [i for i, x in enumerate(probs) if x >= SPEECH_P]
    if len(sp) < MIN_FRAMES.get(mode, 6) or max(probs, default=0.0) < PEAK_P:
        return None
    return sp[0], sp[-1], len(sp)


def unloop(text):
    """A decode loop ("no, no, no, no, ...") kept once: a run of 4+ of the same word."""
    w = text.split()
    key = lambda x: re.sub(r'[^a-z0-9]', '', x.lower())
    out, i = [], 0
    while i < len(w):
        j = i
        while j < len(w) and key(w[j]) == key(w[i]):
            j += 1
        out.extend(w[i:j] if j - i < 4 else [w[i].rstrip(',;')])
        i = j
    return ' '.join(out)


SHORT_OK = {'no', 'ok', 'hi', 'go', 'yo', 'ya', 'ye', 'up', 'on', 'me', 'do', 'it'}
JUNK_ALWAYS = {'you', 'thanks for watching', 'thank you for watching', 'please subscribe'}
JUNK_SHORT = {'thank you', 'bye'}       # junk only from under 400 ms of speech
VOCAB_WORDS = set(re.findall(r"[a-z0-9']+", VOCAB.lower()))


def junk(text, speech_ms):
    """Why a transcript is junk Whisper made from near-silence or a clipped sound, or None."""
    t = text.lower()
    letters = re.sub(r'[^a-z]', '', t)
    words = re.findall(r"[a-z0-9']+", t)
    if not letters:
        return 'no letters'
    if len(letters) <= 2 and letters not in SHORT_OK:
        return 'too short'
    if len(words) == 1 and not re.search('[aeiouy]', words[0]):
        return 'not a word'
    whole = ' '.join(words)
    if whole in JUNK_ALWAYS or (whole in JUNK_SHORT and speech_ms < 400):
        return 'a stock hallucination'
    if len(words) >= 3 and all(w in VOCAB_WORDS for w in words):
        return 'the prompt echoed'
    return None


# ---- the voice: split-style blends, a pitch target, the clean chain ---------------------------
#
# Voice string: TIMBRE[|PROSODY][@SEMITONES][+clean][+glitch]
#   TIMBRE / PROSODY: a Kokoro voice or a blend "af_heart:0.5,af_bella:0.3,...". Kokoro's style
#   vector is two halves: [:128] drives the decoder (timbre), [128:] the duration/F0/energy
#   predictors (prosody). "T|P" takes each half from its own blend. A negative weight pushes away
#   from a voice (P + a(P - Q) is the blend (1+a)P - aQ).
#   @SEMITONES: a formant-keeping pitch shift (rubberband; without it, done inside the model).
#   +clean: EQ, de-esser and a gentle compressor. +glitch: the machine trace on the attack.
# W3 (Haseeb's pick, LOCKED 13): bright and energetic, pitched to a ~240 Hz median at speed 1.
# VOICE (LOCKED 14, the default): W3 + 2 st (~272 Hz median), flow "emphasis", at SPEED 1/0.77
# with PACE "stretch": Kokoro speaks at its own speed 1 and the time goes x0.77 in the same
# rubberband pass as the pitch shift, so the sentence keeps Kokoro's speed-1 pitch shape. His
# blind pick (r24 "ALT") over PACE "model" (Kokoro's speed 1.32): that one dropped the floor
# ~1.4 st and the sentence ends ~2 st deeper (and with it, use @+4.50: its pitch plan is higher).
W3 = 'af_heart:0.5,af_bella:0.3,af_jessica:0.2|af_heart:0.84,af_jessica:0.56,af_sarah:-0.4@+2.93+clean'
VOICE = 'af_heart:0.5,af_bella:0.3,af_jessica:0.2|af_heart:0.84,af_jessica:0.56,af_sarah:-0.4@+4.93+clean'
SPEED, FLOW, PACE = 1.2987, 'emphasis', 'stretch'
PACES = ('stretch', 'model')
VOICE_RE = re.compile(r'^(?P<t>[a-z]{2}_[a-z]+(?::-?[\d.]+)?(?:,[a-z]{2}_[a-z]+(?::-?[\d.]+)?)*)'
                      r'(?:\|(?P<p>[a-z]{2}_[a-z]+(?::-?[\d.]+)?(?:,[a-z]{2}_[a-z]+(?::-?[\d.]+)?)*))?'
                      r'(?:@(?P<st>[+-]?\d+(?:\.\d+)?))?(?P<fx>(?:\+(?:clean|glitch))*)$')


def parse_voice(v):
    """'T|P@st+clean+glitch' -> dict(t, p, shift, clean, glitch). ValueError on anything else."""
    m = VOICE_RE.match(v.strip())
    if not m:
        raise ValueError(f'bad voice {v!r}')
    fx = m.group('fx') or ''
    return {'t': m.group('t'), 'p': m.group('p'), 'shift': float(m.group('st') or 0.0), 'clean': '+clean' in fx, 'glitch': '+glitch' in fx}


def blend_weights(spec):
    parts = [p.split(':') for p in spec.split(',')]
    ws = np.array([float(p[1]) if len(p) > 1 else 1.0 for p in parts])
    if abs(ws.sum()) < 1e-6:
        raise ValueError(f'blend weights of {spec!r} sum to 0')
    return [p[0] for p in parts], ws / ws.sum()


class Tts:
    def __init__(self, model='kokoro-v1.0.int8.onnx'):
        import onnxruntime as ort
        from kokoro_onnx import Kokoro
        t = now_ms()
        so = ort.SessionOptions()
        so.intra_op_num_threads = min(THREADS, 6)
        so.inter_op_num_threads = 1
        sess = ort.InferenceSession(f'{MODELS}/{model}', so, providers=['CPUExecutionProvider'])
        self.k = Kokoro.from_session(sess, f'{MODELS}/voices-v1.0.bin')
        self.flow = Flow.load(f'{MODELS}/{model}', self.k, so)
        self.rubberband = shutil.which('rubberband')
        self._styles = {}
        log(f'tts kokoro loaded in {now_ms() - t:.0f} ms ({model}, CPU; flow {"on" if self.flow else "off"}, '
            f'pitch {"rubberband" if self.rubberband else "in-model"})')

    def blend(self, spec):
        names, ws = blend_weights(spec)
        return sum(w * self.k.get_voice_style(n) for w, n in zip(ws, names))

    def style(self, voice):
        """The (510, 1, 256) style pack of a voice string (cached)."""
        v = parse_voice(voice)
        key = (v['t'], v['p'])
        if key not in self._styles:
            t = self.blend(v['t'])
            st = t if not v['p'] else np.concatenate([t[..., :128], self.blend(v['p'])[..., 128:]], -1)
            self._styles = {key: np.asarray(st, np.float32)}
        return self._styles[key]

    def __call__(self, text, voice=VOICE, speed=SPEED, flow=FLOW, gap_before=0.0, pace=PACE):
        """One sentence -> PCM at TTS_RATE. `text` may carry the speech markup (*word*, —, …).
        `pace`: "stretch" (Kokoro at speed 1, the time scaled by 1/speed in the rubberband pass)
        or "model" (Kokoro's own speed); without rubberband it is always "model"."""
        v = parse_voice(voice)
        tempo = 1.0
        if pace == 'stretch' and self.rubberband and abs(speed - 1.0) > 1e-3:
            tempo, speed = 1.0 / speed, 1.0
        said = text
        for a, b in SAY_FIX:
            said = re.sub(a, b, said)
        lang = 'en-gb' if v['t'].startswith('b') else 'en-us'
        st = self.style(voice)
        preset = FLOW_PRESETS.get(flow) if self.flow else None
        shift = v['shift'] + (preset or {}).get('register', 0.0) * register(text, gap_before > 0)
        in_model = 0.0 if self.rubberband else shift
        if preset is None and not in_model:
            a, sr = self.k.create(strip_markup(said), voice=st, speed=speed, lang=lang)
            a = np.asarray(a, np.float32)
        else:
            a, sr = self.flow(said, st, speed, {**(preset or {}), 'heard_shift': shift}, lang, in_model)
        if sr != TTS_RATE:
            a = np.interp(np.linspace(0, len(a) - 1, int(len(a) * TTS_RATE / sr)), np.arange(len(a)), a).astype(np.float32)
        if (shift or tempo != 1.0) and self.rubberband:
            a = pitch_shift(a, shift, self.rubberband, tempo)
        if v['clean']:
            a = clean_fx(a)
        if v['glitch']:
            a = glitch(a)
        if gap_before > 0:   # the silence heard: what the sentence already starts with counts
            a = np.concatenate([np.zeros(int(max(0.0, gap_before - edge_silence(a)[0]) * TTS_RATE), np.float32), a])
        return a


def edge_silence(a):
    """(head, tail) seconds of 10 ms frames below p95 - 40 dB at either end."""
    n = len(a) // 240
    if n < 3:
        return 0.0, 0.0
    db = 20 * np.log10(np.sqrt((a[:n * 240].reshape(n, 240) ** 2).mean(1)) + 1e-9)
    on = np.nonzero(db > np.percentile(db, 95) - 40)[0]
    return (on[0] * 0.01, (n - 1 - on[-1]) * 0.01) if len(on) else (0.0, 0.0)


def register(text, continuing):
    """Pitch offset by position (semitones; scaled by the preset): a reply's first sentence a
    touch up, the ones that continue it down, a question up."""
    return (-0.6 if continuing else 0.4) + (0.5 if text.rstrip().endswith('?') else 0.0)


def pitch_shift(a, semis, exe, tempo=1.0):
    """Formant-keeping pitch shift through the rubberband CLI (R3 engine, offline; RAM files);
    `tempo` < 1 also makes it faster in the same pass (the output is then shorter)."""
    if (abs(semis) < 1e-3 and tempo == 1.0) or len(a) < 256:
        return a
    import tempfile
    with tempfile.TemporaryDirectory(dir='/dev/shm' if os.path.isdir('/dev/shm') else None) as td:
        write_wav(f'{td}/i.wav', a)
        cmd = [exe, '-q', '-p', f'{semis:.3f}'] + (['-t', f'{tempo:.4f}'] if tempo != 1.0 else []) + ['-F', '-3', f'{td}/i.wav', f'{td}/o.wav']
        r = subprocess.run(cmd, capture_output=True)
        if r.returncode:
            log('rubberband failed:', r.stderr.decode(errors='replace')[-200:])
            return a
        y = read_wav(f'{td}/o.wav')
    if tempo != 1.0:
        return y
    return np.concatenate([y, np.zeros(max(0, len(a) - len(y)), np.float32)])[:len(a)]


# ---- the clean chain (EQ, de-esser, compressor; numpy only) -----------------------------------

def _fft_eq(a, gain_fn):
    n = 1 << int(np.ceil(np.log2(len(a) + 2048)))
    f = np.fft.rfftfreq(n, 1 / TTS_RATE)
    return np.fft.irfft(np.fft.rfft(a, n) * gain_fn(f), n)[:len(a)].astype(np.float32)


def _bell(f, fc, db, q_oct):
    x = np.log2(np.maximum(f, 1) / fc) / q_oct
    return 10 ** (db * np.exp(-x * x * 2.77) / 20)


def _follow(lv, attack_ms, release_ms):
    """Attack/release follower over 1 ms levels (dB)."""
    aa, rr = np.exp(-1 / attack_ms), np.exp(-1 / release_ms)
    y = np.empty(len(lv))
    s = lv[0]
    for i, x in enumerate(lv):
        c = aa if x > s else rr
        s = c * s + (1 - c) * x
        y[i] = s
    return y


def _levels(a):
    blk = TTS_RATE // 1000
    n = len(a) // blk + 1
    x = np.concatenate([a, np.zeros(n * blk - len(a), np.float32)]).reshape(n, blk)
    return 10 * np.log10((x.astype(np.float64) ** 2).mean(1) + 1e-12), blk, n


def clean_fx(a, f0_med=240.0):
    """HPF 70 Hz, +1.5 dB body at 1.15 x F0, +2 dB presence at 3 kHz, -2 dB air above 8 kHz; de-esser
    5.5-9 kHz 3:1 (at most 6 dB); compressor 2.5:1 at -20 dBFS, 5/80 ms."""
    if len(a) < 2048:
        return a
    hp = lambda f: 1 / np.sqrt(1 + (70 / np.maximum(f, 1e-3)) ** 4)
    shelf = lambda f: 10 ** (-2.0 * 0.5 * (1 + np.tanh(np.log2(np.maximum(f, 1) / 8000) / 0.4)) / 20)
    a = _fft_eq(a, lambda f: hp(f) * _bell(f, 1.15 * f0_med, 1.5, 1.1) * _bell(f, 3000, 2.0, 1.0) * shelf(f))
    band = _fft_eq(a, lambda f: ((f >= 5500) & (f <= 9000)).astype(float))
    lv, blk, n = _levels(band)
    e = np.sqrt(np.convolve(a * a, np.ones(1200) / 1200, 'same') + 1e-12)
    act = e > 0.1 * e.max()
    th = 10 * np.log10((a[act].astype(np.float64) ** 2).mean() + 1e-12) - 9
    over = np.maximum(_follow(lv, 1.0, 50.0) - th, 0)
    g = 10 ** (np.interp(np.arange(len(a)) / blk, np.arange(n), -np.minimum(over - over / 3.0, 6.0)) / 20)
    a = (a - band + band * g).astype(np.float32)
    lv, blk, n = _levels(a)
    over = np.maximum(_follow(lv, 5.0, 80.0) + 20, 0)
    g = 10 ** (np.interp(np.arange(len(a)) / blk, np.arange(n), -(over - over / 2.5)) / 20)
    return (a * g).astype(np.float32)


# ---- flow: Kokoro's own predictors, steered --------------------------------------------------
#
# Her replies may mark speech:  *word* stresses one word;  — is a beat;  … trails off;
# , ; : are clause pauses. Kokoro has no SSML and barely reacts to stress marks, but its graph
# predicts per-phoneme durations, then an F0 curve and an energy curve, before the decoder.
# The model file is patched IN MEMORY (weights and voices untouched, nothing trained or cloned):
#   pred  = the graph pruned to text encoder + duration predictor (~20 ms), output: durations;
#   synth = the full graph with durations as an input, plus an F0 multiplier and an energy offset.
# Per sentence: pass 1 durations -> set pause lengths on punctuation tokens (the model plans its
# own boundary tones around them), stretch the stressed word -> pass 2 with a pitch accent and an
# energy bump on that word and a lower, quieter stretch after it. One decoder pass, no seams.

FLOW_SR, FLOW_HOP = 24000, 600        # one duration frame = 25 ms; F0/energy run at 12.5 ms
KOKORO_INT8_SHA256 = '6e742170d309016e5891a994e1ce1559c702a2ccd0075e67ef7157974f6406cb'
FLOW_TAPS = ('/encoder/Gather_output_0', '/encoder/F0_proj/Conv_output_0', '/encoder/N_proj/Conv_output_0')
FLOW_DUR_F = '/encoder/Div_output_0'   # the durations before Kokoro rounds them, per token (already / speed)
VOWELS = set('aeiouæɐɑɒɔəɚɛɜɪʊʌᵻᵊ')
PAUSE_MARKS = set(',;:—….!?')
EMPH_RE = re.compile(r'\*([^*\s](?:[^*]{0,40}?[^*\s])?)\*')
WH_RE = re.compile(r"^\W*(?:(?:\w+,|so|and|but|ok|okay|well|then|now|hey|oh|um|uh)\s+)*(?:what|why|how|where|when|who|whom|which|whose)\b", re.I)
PAUSES = {  # seconds of silence (as heard), drawn per mark from a generator seeded by the text
    'comma_s': (0.06, 0.13), 'comma': (0.13, 0.27), 'semi': (0.23, 0.35), 'dash': (0.20, 0.33),
    'ellip': (0.45, 0.70), 'stop': (0.32, 0.54), 'q': (0.40, 0.62)}
SENT_GAP = 0.44   # s heard between two sentences of a reply at speed 1 (W3's renders: 0.39-0.46)
REPLY_GAP = 0.66  # s heard between two replies in a --render sample, at speed 1
GAPS = {'.': (0.32, 0.54), '!': (0.30, 0.44), '?': (0.40, 0.62), '…': (0.45, 0.70), ';': (0.23, 0.35), '': (0.30, 0.45)}
EMPHASIS = {'stretch': 1.25, 'onset_c': 1, 'emph_st': 4.0, 'rin_ms': 80, 'rout_ms': 120, 'emph_n': 1.6, 'pfc_st': 1.0, 'pfc_n': 0.6}
FLOW_PRESETS = {
    'off': None,
    'pauses': {'pauses': True},
    'emphasis': {**EMPHASIS},
    'full': {'pauses': True, **EMPHASIS, 'speed_jit': 0.04, 'register': 1.0},
}


def strip_markup(text):
    """The words as written, without the speech marks (for the bubble, captions, plain TTS)."""
    return EMPH_RE.sub(r'\1', text).replace('*', '')


def sentence_gap(prev_text, flow, speed=1.0):
    """Silence (as heard) before a sentence that follows `prev_text` in the same reply: drawn by
    its closing mark with the pause presets, a steady beat otherwise; faster speech, shorter gaps."""
    P = FLOW_PRESETS.get(flow)
    if not P:
        return 0.0
    if not P.get('pauses'):
        return SENT_GAP / max(speed, 0.5)
    end = prev_text.rstrip().rstrip('"\')]”’')[-1:]
    lo, hi = GAPS.get(end, GAPS[''])
    g = np.random.default_rng(zlib.crc32(prev_text.encode())).uniform(lo, hi)
    return float(g) / max(speed, 0.5)


# Raw protobuf edits of the ONNX model (no onnx package needed).
def _pb_varint(b, i):
    r = s = 0
    while True:
        c = b[i]
        i += 1
        r |= (c & 0x7f) << s
        s += 7
        if c < 0x80:
            return r, i


def _pb_fields(b, i=0, end=None):
    end = len(b) if end is None else end
    while i < end:
        e0 = i
        key, i = _pb_varint(b, i)
        f, wt = key >> 3, key & 7
        if wt == 0:
            _, j = _pb_varint(b, i)
        elif wt == 2:
            n, i = _pb_varint(b, i)
            j = i + n
        elif wt == 1:
            j = i + 8
        elif wt == 5:
            j = i + 4
        else:
            raise ValueError(f'protobuf wire type {wt}')
        yield f, i, j, e0
        i = j


def _pb_v(n):
    out = bytearray()
    while True:
        c = n & 0x7f
        n >>= 7
        out.append(c | (0x80 if n else 0))
        if not n:
            return bytes(out)


def _pb_ld(f, payload):
    payload = payload.encode() if isinstance(payload, str) else payload
    return _pb_v(f << 3 | 2) + _pb_v(len(payload)) + payload


def _pb_node(op, ins, outs, name):
    return b''.join([_pb_ld(1, x) for x in ins] + [_pb_ld(2, x) for x in outs] + [_pb_ld(3, name), _pb_ld(4, op)])


def _pb_vinfo(name, elem, dims):
    shape = b''.join(_pb_ld(1, _pb_ld(2, d) if isinstance(d, str) else _pb_v(1 << 3) + _pb_v(d)) for d in dims)
    return _pb_ld(1, name) + _pb_ld(2, _pb_ld(1, _pb_v(1 << 3) + _pb_v(elem) + _pb_ld(2, shape)))


def _pb_graph(b):
    for f, s, e, e0 in _pb_fields(b):
        if f == 7:
            return b[:e0], s, e, b[e:]
    raise ValueError('no graph in the model')


def _pb_strings(b, s, e, field):
    return [b[s2:e2].decode() for f, s2, e2, _ in _pb_fields(b, s, e) if f == field]


def _pb_rewire(b, s, e, old, new):
    return b''.join(_pb_ld(1, new) if f == 1 and b[s2:e2].decode() == old else b[e0:e2] for f, s2, e2, e0 in _pb_fields(b, s, e))


def patch_synth(b):
    """The full graph with inputs dur_in (int64 [T]), f0_mul and n_add (float [1, 1, 2*sum(dur_in)])."""
    dur, f0, nn = FLOW_TAPS
    pre, gs, ge, post = _pb_graph(b)
    g = bytearray()
    for f, s, e, e0 in _pb_fields(b, gs, ge):
        if f == 1:
            ins = _pb_strings(b, s, e, 1)
            if dur in ins:
                g += _pb_ld(1, _pb_rewire(b, s, e, dur, 'dur_in'))
                continue
            if f0 in ins:
                g += _pb_ld(1, _pb_node('Mul', [f0, 'f0_mul'], ['f0_mod'], 'flow_f0_mul')) + _pb_ld(1, _pb_rewire(b, s, e, f0, 'f0_mod'))
                continue
            if nn in ins:
                g += _pb_ld(1, _pb_node('Add', [nn, 'n_add'], ['n_mod'], 'flow_n_add')) + _pb_ld(1, _pb_rewire(b, s, e, nn, 'n_mod'))
                continue
        g += b[e0:e]
    g += _pb_ld(11, _pb_vinfo('dur_in', 7, ['n_tok'])) + _pb_ld(11, _pb_vinfo('f0_mul', 1, [1, 1, 'f0_len'])) + _pb_ld(11, _pb_vinfo('n_add', 1, [1, 1, 'f0_len']))
    return pre + _pb_ld(7, bytes(g)) + post


def patch_pred(b, dur=FLOW_TAPS[0], out='duration', elem=7, dims=('n_tok',)):
    """The graph pruned to what one tensor needs, exposed as `out`: by default the durations
    (int64 [T], frames per token); on the synth patch, the F0 curve for given durations."""
    pre, gs, ge, post = _pb_graph(b)
    nodes, other = [], []
    for f, s, e, e0 in _pb_fields(b, gs, ge):
        if f == 1:
            nodes.append((_pb_strings(b, s, e, 1), _pb_strings(b, s, e, 2), b[e0:e]))
        else:
            other.append((f, s, e, e0))
    made = {o: i for i, (_, outs, _) in enumerate(nodes) for o in outs}
    need, names, todo = set(), set(), [dur]
    while todo:
        t = todo.pop()
        names.add(t)
        i = made.get(t)
        if i is not None and i not in need:
            need.add(i)
            todo += [x for x in nodes[i][0] if x]
    g = bytearray(b''.join(raw for i, (_, _, raw) in enumerate(nodes) if i in need))
    g += _pb_ld(1, _pb_node('Identity', [dur], [out], 'flow_' + out))
    for f, s, e, e0 in other:
        if f == 12:
            continue
        if f in (5, 11, 13) and next(iter(_pb_strings(b, s, e, 8 if f == 5 else 1)), '') not in names:
            continue
        g += b[e0:e]
    g += _pb_ld(12, _pb_vinfo(out, elem, list(dims)))
    return pre + _pb_ld(7, bytes(g)) + post


class Flow:
    @classmethod
    def load(cls, path, kokoro, so):
        """The patched sessions, or None (then speech is plain Kokoro) if this is not the model
        the taps were found in or the patch does not load."""
        import hashlib
        import onnxruntime as ort
        try:
            b = open(path, 'rb').read()
            if hashlib.sha256(b).hexdigest() != KOKORO_INT8_SHA256:
                log('flow: off (not the kokoro-v1.0.int8.onnx the taps were found in)')
                return None
            f = cls()
            f.pred = ort.InferenceSession(patch_pred(b, FLOW_DUR_F, 'dur_f', 1, (1, 'n_tok')), so, providers=['CPUExecutionProvider'])
            f.synth = ort.InferenceSession(patch_synth(b), so, providers=['CPUExecutionProvider'])
            f.f0 = ort.InferenceSession(patch_pred(patch_synth(b), FLOW_TAPS[1], 'f0_pred', 1, (1, 1, 'f0_len')), so, providers=['CPUExecutionProvider'])
            f.k, f.tok, f.vocab = kokoro, kokoro.tokenizer, kokoro.tokenizer.vocab
            return f
        except Exception as e:
            log('flow: off, the patch failed:', e)
            return None

    def known(self, ph):
        return ''.join(c for c in ph if c in self.vocab)

    def phonemes(self, text, lang):
        """Phonemes (vocabulary only) and the [start, end) spans of the stressed words in them.
        Runs between stressed words are phonemized apart, so the spans are exact (and a stressed
        word comes out in its citation form, with its own primary stress). One stressed word per
        sentence at most; extra marks are read plain."""
        ms = list(EMPH_RE.finditer(text))[:1]
        out, spans, pos = '', [], 0
        for m in ms + [None]:
            seg = strip_markup(text[pos:m.start()] if m else text[pos:])
            if seg.strip():
                p = self.known(self.tok.phonemize(seg, lang))
                out = f'{out} {p}'.strip()
            if m:
                tail = re.match(r'[^\s*]*', text[m.end():]).group(0)
                p = self.known(self.tok.phonemize(m.group(1) + tail, lang))
                core = p.rstrip(''.join(PAUSE_MARKS) + '“” ')
                out = f'{out} ' if out else ''
                spans.append((len(out), len(out) + len(core)))
                out += p
                pos = m.end() + len(tail)
        return out, spans

    def __call__(self, text, style, speed, P, lang, shift_st=0.0):
        rng = np.random.default_rng(zlib.crc32(text.encode()))
        self.last = {}                                          # what the last sentence got (for tests and logs)
        if P.get('speed_jit'):
            speed = float(np.clip(speed * (1 + rng.uniform(-P['speed_jit'], P['speed_jit'])), 0.5, 2.0))
        ph, spans = self.phonemes(text, lang)
        ph = ph[:510]
        ids = [self.vocab[c] for c in ph]
        if not ids:
            raise ValueError(f'nothing to say in {text!r}')
        tok = np.array([[0, *ids, 0]], np.int64)
        st = np.asarray(style[min(len(ids), len(style)) - 1], np.float32).reshape(1, 256)
        sp = np.array([speed], np.float32)
        # Kokoro rounds each token to whole 25 ms frames after dividing by the speed, so speed moves
        # in steps (1.30 -> 1.38 cut a test set by 18 %). Here the unrounded durations are summed
        # and rounded once: speed scales the time as asked, and every token keeps >= 1 frame.
        d = self.pred.run(None, {'tokens': tok, 'style': st, 'speed': sp})[0].ravel().astype(np.float64)
        d0 = np.maximum(np.round(d), 1).astype(np.int64)    # what stock Kokoro would use
        ch = f' {ph} '                                          # ch[i]: the phoneme of token i
        frames = lambda s: s * FLOW_SR / FLOW_HOP
        mutes = []
        if P.get('pauses'):
            syl = 0
            for i in range(1, len(ch) - 2):
                c = ch[i]
                syl += c in VOWELS and ch[i - 1] not in VOWELS
                if c not in PAUSE_MARKS:
                    continue
                kind = ('comma_s' if c == ',' and syl <= 2 else 'comma' if c == ',' else 'semi' if c in ';:' else 'dash' if c == '—'
                        else 'ellip' if c == '…' else 'q' if c == '?' else 'stop')
                syl = 0
                d[i] += frames(rng.uniform(*PAUSES[kind]))      # on top of the model's own frames (the release)
                mutes.append(i)
        for a, b in spans:
            i0, i1 = a + 1, b + 1
            if P.get('stretch'):
                k = ch[i0:i1].find('ˈ')
                for i in range(i0 + max(k, 0), i1):            # the stressed vowel (diphthong, length mark)
                    if ch[i] in VOWELS or ch[i] == 'ː':
                        d[i] = max(d[i] * P['stretch'], d[i] + 1)
                        if i + 1 < i1 and (ch[i + 1] in VOWELS or ch[i + 1] == 'ː'):
                            continue
                        break
                if P.get('onset_c') and ch[i0] not in VOWELS and ch[i0] not in 'ˈˌ':
                    d[i0] += P['onset_c']
        di = np.diff(np.concatenate([[0], np.round(np.cumsum(d))])).astype(np.int64)
        di = np.maximum(di, np.minimum(d0, 1))
        edges = np.concatenate([[0], np.cumsum(di)])
        n = int(2 * edges[-1])
        f0, en = np.full(n, shift_st), np.zeros(n)
        t = np.arange(n)

        def bump(a, b, h, rin, rout):
            env = np.zeros(n)
            a, b = max(0, a), min(n, b)
            env[a:b] = 1.0
            m = (t < a) & (t >= a - rin)
            env[m] = 0.5 - 0.5 * np.cos(np.pi * (t[m] - (a - rin)) / max(rin, 1))
            m = (t >= b) & (t < b + rout)
            env[m] = 0.5 + 0.5 * np.cos(np.pi * (t[m] - b) / max(rout, 1))
            return env * h
        ms = lambda x: int(round(x / 12.5))
        question = text.rstrip().rstrip('"\')]”’').endswith('?')
        rises = question and not WH_RE.match(strip_markup(text))
        pred_f0 = self.f0.run(None, {'tokens': tok, 'style': st, 'dur_in': di})[0].ravel() if spans and P.get('emph_st') else None
        if pred_f0 is not None:
            # F0 frames of phoneme tokens (the predictor also emits F0 inside pause tokens: not speech)
            speech = np.zeros(n, bool)
            for i in range(1, len(ch) - 1):
                if ch[i] not in PAUSE_MARKS and ch[i] != ' ':
                    speech[2 * edges[i]:2 * edges[i + 1]] = True
            stops = [i for i in range(1, len(ch) - 1) if ch[i] in PAUSE_MARKS and di[i] >= 6]   # >= 150 ms

            def med(lo, hi):
                x = pred_f0[lo:hi][speech[lo:hi] & (pred_f0[lo:hi] > 50)]
                return float(np.median(x)) if len(x) >= 8 else None
        for a, b in spans:
            i0, i1 = a + 1, b + 1
            k = ch[i0:i1].find('ˈ')
            fa, fb, wa = 2 * edges[i0 + max(k, 0)], 2 * edges[i1], 2 * edges[i0]
            pe = 2 * edges[next((i for i in range(i1, len(ch) - 1) if ch[i] in PAUSE_MARKS), len(ch) - 1)]
            h = 0.0
            if a > 0 and pred_f0 is not None:                   # a sentence-initial word already rides the onset
                # closed loop, local: the word's peak over the speech 450 ms before it (not across a
                # pause, not inside the sentence's first 400 ms) and 450 ms after it (at speed 1; the
                # windows shrink with speed). The smaller is its prominence; the bump (0.5..emph_st)
                # brings it to prominence + 1.5 st, inside 4..6 st
                own = pred_f0[fa:fb][pred_f0[fa:fb] > 50]
                before_p = max([2 * edges[i + 1] for i in stops if i < i0] + [0])
                after_p = min([2 * edges[i] for i in stops if i >= i1] + [n])
                w, skip = ms(450 / speed), ms(400 / speed)      # windows in syllables, so they shrink with speed
                sides = [med(max(wa - w, 2 * edges[1] + skip, before_p), wa), med(fb, min(fb + w, after_p))]
                proms = [12 * np.log2(own.max() / m) for m in sides if m] if len(own) else []
                h = 0.5 if not proms else float(np.clip(np.clip(min(proms) + 1.5, 4.0, 6.0) - min(proms), 0.5, P['emph_st']))
                self.last.setdefault('words', []).append({'sides_hz': sides, 'peak_hz': float(own.max()) if len(own) else 0.0, 'proms': proms})
                if rises:                                       # a yes/no question's main accent is its rise
                    h = min(h, 2.0)
                if len(own):                                    # never over 400 Hz as heard
                    h = max(0.0, min(h, 12 * np.log2(400 / own.max()) - P.get('heard_shift', 0.0)))
            self.last.setdefault('bumps', []).append(round(h, 2))
            if h:
                f0 += bump(fa, fb, h, ms(P['rin_ms']), ms(P['rout_ms']))
            if P.get('emph_n'):
                en += bump(wa, fb, P['emph_n'], ms(40), ms(60))
            if pe > fb + ms(150) and not question:              # post-focal: lower and quieter, from the word's end
                if P.get('pfc_st'):
                    f0 -= bump(fb + ms(60), pe, P['pfc_st'], ms(60), ms(80))
                if P.get('pfc_n'):
                    en -= bump(fb + ms(60), pe, P['pfc_n'], ms(60), ms(80))
            if rises and pred_f0 is not None and len(own := pred_f0[fa:fb][pred_f0[fa:fb] > 50]):
                # a yes/no question keeps its rise over the stressed word: its last 200 ms of voice
                # ramp up until they end at least 1 st under the word's (raised) peak, by 3 st at most
                qe = 2 * edges[max(i for i in range(1, len(ch) - 1) if ch[i] == '?')]
                voiced = np.nonzero((pred_f0[:qe] > 50) & speech[:qe])[0]
                if len(voiced) and voiced[-1] + 1 > fb:
                    lv = int(voiced[-1]) + 1
                    tail = pred_f0[max(fb, lv - ms(200)):lv]
                    lift = float(np.clip(12 * np.log2(own.max() / tail.max()) + h - 1.0, 0.0, 3.0))
                    self.last['lift'] = round(lift, 2)
                    f0 += np.clip((t - (lv - ms(200))) / ms(200), 0, 1) * lift
        a = self.synth.run(None, {'tokens': tok, 'style': st, 'speed': sp, 'dur_in': di,
                                  'f0_mul': (2 ** (f0 / 12)).astype(np.float32).reshape(1, 1, n),
                                  'n_add': en.astype(np.float32).reshape(1, 1, n)})[0].ravel()
        # Forced pause frames are not all silent (the decoder fills some with hiss or a hum): mute
        # what was added, keep the model's own frames; the closing mark goes too, then trim.
        last = max([i for i in range(1, len(ch) - 1) if ch[i] != ' '] + [0])
        if ch[last] in PAUSE_MARKS and P.get('pauses'):
            mutes.append(last)
        fd = int(0.02 * FLOW_SR)
        for i in mutes:
            s0 = int((edges[i] + (min(1, d0[i]) if i == last else d0[i])) * FLOW_HOP)
            e0 = int(edges[i + 1] * FLOW_HOP)
            if e0 - s0 >= 2 * fd + 240:
                g = np.zeros(e0 - s0, np.float32)
                g[:fd] = 0.5 + 0.5 * np.cos(np.pi * np.arange(fd) / fd)
                if i != last:
                    g[-fd:] = 0.5 - 0.5 * np.cos(np.pi * np.arange(fd) / fd)
                a[s0:e0] *= g
        from kokoro_onnx.trim import trim
        return np.asarray(trim(a)[0], np.float32), FLOW_SR


def glitch(a, seed=7):
    """A trace of the machine on the attack: ~140 ms bit-crushed and sample-held, fading into
    the clean voice, plus two 12 ms ring-modulated stutters. Clean after that."""
    a = a.copy()
    n = min(len(a), int(0.14 * TTS_RATE))
    if n < 10:
        return a
    hold = np.repeat(a[:n:3], 3)[:n]
    crushed = np.round(hold * 12) / 12
    mix = np.linspace(0.85, 0.0, n) ** 1.5
    a[:n] = mix * crushed + (1 - mix) * a[:n]
    rng = np.random.default_rng(seed)
    for at in rng.integers(int(0.03 * TTS_RATE), max(int(0.03 * TTS_RATE) + 1, min(len(a) - 400, int(0.5 * TTS_RATE))), 2):
        m = int(0.012 * TTS_RATE)
        if at + m < len(a):
            t = np.arange(m) / TTS_RATE
            a[at:at + m] *= 0.6 + 0.4 * np.sign(np.sin(2 * np.pi * 900 * t))
    return a


def shapes(a):
    """The mouth track at STEP_MS: 0 closed, 1 small, 2 round, 3 wide, from RMS (smoothed
    0.25 old + 0.75 new; lower thresholds to stay in a shape than to enter it)."""
    step = int(TTS_RATE * STEP_MS / 1000)
    out, sm, cur = [], 0.0, 0
    peak = float(np.max(np.abs(a))) if len(a) else 1.0
    g = 0.5 / peak if peak > 0 else 1.0  # loudness relative to the line, not absolute gain
    for i in range(0, len(a), step):
        r = float(np.sqrt(np.mean((a[i:i + step] * g) ** 2))) if i < len(a) else 0.0
        sm = 0.25 * sm + 0.75 * r
        enter = [0.012, 0.06, 0.15]
        stay = [0.008, 0.045, 0.12]
        lvl = 0
        for k in range(3):
            if sm > (stay[k] if cur > k else enter[k]):
                lvl = k + 1
        cur = lvl
        out.append(lvl)
    return out


