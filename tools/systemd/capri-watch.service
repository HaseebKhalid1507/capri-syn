# capri-watch: event hooks that wake Capri (see docs/WATCH.md). `install.sh --watch` installs it on her machine.
# Install by hand, on Capri's machine and on any other machine whose events she should hear (each
# machine watches itself; the others need role = "remote" and [deliver] ssh_host in their watch.toml):
#   install -m 755 tools/capri-watch/capri-watch ~/.local/bin/capri-watch
#   cp tools/capri-watch/watch.toml ~/.config/synaps-avatar/watch.toml     # optional on her machine: no file = the defaults
#   capri-watch --dry-run --once -v                                          # what it would send right now
#   mkdir -p ~/.config/systemd/user && cp tools/systemd/capri-watch.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now capri-watch
# It only reads (gh, systemctl, statvfs, `synaps daemon sessions --json`, session journals, her
# avatar's state) and writes one line per event into her session with `synaps send`.
# Stop it for good: systemctl --user disable --now capri-watch
[Unit]
Description=capri-watch: event hooks that wake Capri
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/capri-watch
# The user manager's PATH lacks ~/.local/bin (synaps, capri-ctl) on some machines.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Nice=10
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes

[Install]
WantedBy=default.target
